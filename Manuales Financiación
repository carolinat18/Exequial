                try
                {
                    //si no existe la carpeta la creamos 
                    if (!(Directory.Exists(rutaCarpetaSoporteSoporte)))
                        Directory.CreateDirectory(rutaCarpetaSoporteSoporte);
                }
                catch { }

                if (File.Exists(rutaArchivoSoporte))
                {
                    newCarpetaLog = carpeta;

