        /// <summary>Proceso automatizado para las reconciliaciones manuales</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="path">Ruta</param>
        /// <param name="oFormFinanPagos">Formulario de generacion de pagos</param>
