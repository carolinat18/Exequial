                    for (int i = 0; i <= lineas - 1; i++)
                    {

                        query = query.Replace("%DocNum%", oChildren.Item(i).GetProperty("U_EntrFact").ToString());

                        ors.DoQuery(query);

                        if (ors.RecordCount > 0)
                        {
                            if (!lista.Contains(oChildren.Item(i).GetProperty("U_EntrFact").ToString()))
                            {
                                lista.Add(oChildren.Item(i).GetProperty("U_EntrFact").ToString());

