                                            oDAC.db_VlrDes = OK1.SBO.Helpers.DoubleFromDBDataSource(oCmp, oRs.Fields.Item("U_ValorDescuento").Value);
                                            oDAC.str_Cuota = oRs.Fields.Item("U_Cuota").Value.ToString().Trim();
                                            al_DescuentosAdicionales.Add(oDAC);

                                            oRs.MoveNext();
                                        }
                                        #endregion

                                        for (int i = 1; i <= numCuotas; i++)
                                        {
                                            #region pagos adicionales
                                            b_PagoAdicional = false;

                                            fechaCuota = this.ObtenerFechaCuota(fechadesembolso, i);

                                            i_mes = fechaCuota.Month;

                                            if (i_mes < 10)
                                            {
                                                str_mes = "0" + i_mes.ToString();
                                            }
                                            else
                                            {
                                                str_mes = i_mes.ToString();
                                            }

                                            foreach (CreditosFinanciacion.PagosAdicionalesCuotas item in al_PagosAdicionales)
                                            {
                                                if (item.str_CuotaMes.Equals(str_mes))
                                                {
                                                    b_PagoAdicional = true;
                                                    db_VlrPagAdic = item.db_VlrAdi;
                                                    break;
                                                }
                                            }
                                            #endregion

                                            #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021

                                            b_DescuentoAdicional = false;
                                            strCuota = Convert.ToString(i);
                                            foreach (CreditosFinanciacion.DescuentosAdicionalesCuotas item in al_DescuentosAdicionales)
                                            {
                                                if (item.str_Cuota.Equals(strCuota))
                                                {
                                                    b_DescuentoAdicional = true;
                                                    db_VlrDescAdic = item.db_VlrDes;
                                                    break;
                                                }
                                            }
                                            #endregion

                                            #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021
                                            if (!b_PagoAdicional && !b_DescuentoAdicional)
                                                db_ValorCuotaMes = valorCuota;
                                            else
                                                if (b_PagoAdicional && b_DescuentoAdicional)
                                                db_ValorCuotaMes = valorCuota + db_VlrPagAdic - db_VlrDescAdic;
                                            else
                                                    if (b_PagoAdicional)
                                                db_ValorCuotaMes = valorCuota + db_VlrPagAdic;
                                            else
                                                        if (b_DescuentoAdicional)
                                                db_ValorCuotaMes = valorCuota + db_VlrPagAdic;
                                            #region old pagos adicionales
                                            //if (b_PagoAdicional)
                                            //    {
                                            //    db_ValorCuotaMes = valorCuota + db_VlrPagAdic;
                                            //    }
                                            //else
                                            //    {
                                            //    db_ValorCuotaMes = valorCuota;
                                            //    }
                                            #endregion
                                            #endregion

                                            db_IntMen = dbSaldo * (tasaInteres / 100);

                                            vlrCaptital = db_ValorCuotaMes - db_IntMen;

                                            if (db_VlrCuotaIni != 0)
                                            {
                                                idLinea = i_tempo + 1;
                                            }
                                            else
                                            {
                                                idLinea = i_tempo;
                                            }

                                            if (i == numCuotas)
                                            {
                                                db_tempo = dbSaldo - vlrCaptital;

                                                if (db_tempo > 0)
                                                {
                                                    vlrCaptital = vlrCaptital + (db_tempo);
                                                    db_ValorCuotaMes += db_tempo;
                                                }
                                            }

                                            strQr = "INSERT INTO \"@OK1_FINAN_CRED_LIN1\" (\"Object\", \"DocEntry\", \"LineId\", \"VisOrder\", \"U_NroTabla\", \"U_NroCuot\", \"U_VlrCuota\", \"U_Capital\", \"U_Intereses\", \"U_SaldoCr\", \"U_VlrSeg\", \"U_VlrPago\", \"U_FechPPag\")";
                                            strQr = strQr + " VALUES ('OK1_FINAN_CRED'," + idcredito + ", " + idLinea + ", " + idLinea + ", 1, " + i_tempo + ", " + OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCmp, db_ValorCuotaMes) + ", " + OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCmp, vlrCaptital) + ", " + OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCmp, db_IntMen) + ", " + OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCmp, (dbSaldo - vlrCaptital)) + ", 0, " + OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCmp, db_ValorCuotaMes) + ", \'" + OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(fechaCuota, oApp) + "\')";

                                            oConsulta.EjecutarConsulta(ref oRs, strQr);

                                            dbSaldo = dbSaldo - vlrCaptital;

                                            i_tempo++;
                                        }

                                        break;

                                        #endregion
                                }

                                break;

                                #endregion
                        }

                        strQuery = oConsulta.QryCamposAdicionalesDTWCreditos(idcredito.ToString());
                        oConsulta.EjecutarConsulta(ref oRs2, strQuery);

                        if (oRs2.RecordCount > 0)
                        {
                            vlrCapPe = OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, oRs2.Fields.Item("capiPen").Value);
                            vlrIntPe = OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, oRs2.Fields.Item("IntPen").Value);
