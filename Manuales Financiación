                    if (oCuota.dbVlrPendSegV >= dbVlrDisponibleSeguros)
                    {
                        this.dbVlrPagoSegV = oCuota.dbVlrPendSegV;
                        dbVlrDisponibleSeguros = dbVlrDisponibleSeguros - oCuota.dbVlrPendSegV;
                    }
                    else
                    {
                        this.dbVlrPagoSegV = dbVlrDisponibleSeguros;
                        this.dbVlrPendSegVida = oCuota.dbVlrPendSegV - dbVlrDisponibleSeguros;
                        dbVlrDisponibleSeguros = 0;
                    }
                }
            }
            else
            {
                if (this.dbVlrSegVida != 0)
                {
                    if (this.dbVlrSegVida <= dbVlrDisponibleSeguros)
                    {
                        this.dbVlrPagoSegV = this.dbVlrSegVida;
                        dbVlrDisponibleSeguros = dbVlrDisponibleSeguros - this.dbVlrSegVida;
                    }
                    else
                    {
                        if (!this.stmodocalculoPago.Equals("1") && !this.stmodocalculoPago.Equals("2"))
                        {
                            this.dbVlrPagoSegV = dbVlrDisponibleSeguros;
                            this.dbVlrPendSegVida = this.dbVlrSegVida - dbVlrDisponibleSeguros;
                            dbVlrDisponibleSeguros = 0;
                        }
                        else
                        {
                            this.dbVlrPendSegVida = 0;
                            this.dbVlrPagoSegV = 0;
                        }
                    }
                }
                else
                {
                    this.dbVlrPagoSegV = 0d;
                    this.dbVlrPendSegVida = 0d;
                }
            }
            if (oCuota.dbVlrPendOtSeg > 0)
            {
                if (dbVlrDisponibleSeguros > 0)
                {
                    if (dbVlrDisponibleSeguros >= oCuota.dbVlrPendOtSeg)
                    {
                        this.dbVlrPagoOtrSeg = oCuota.dbVlrPendOtSeg;
                    }
                    else
                    {
                        this.dbVlrPagoOtrSeg = dbVlrDisponibleSeguros;
                        this.dbVlrPendOtrSeg = oCuota.dbVlrPendOtSeg - dbVlrDisponibleSeguros;
                        dbVlrDisponibleSeguros = 0;
                    }
                }
                else
                {
                    this.dbVlrPagoOtrSeg = 0d;
                    this.dbVlrPendOtrSeg = oCuota.dbVlrPendOtSeg;
                    dbVlrDisponibleSeguros = 0;
                }
            }
