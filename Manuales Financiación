        public int DiferenciaDias2(DateTime dtFechaIni, DateTime dtFechaFin)
        {
            int idiasDif = 0;

            int iYear;
            int imeses;
            int iDia1 = 0, iDia2 = 0, iDias;

            iYear = dtFechaFin.Year - dtFechaIni.Year;
            imeses = dtFechaFin.Month - dtFechaIni.Month;

            if (dtFechaIni.Day == 31)
            {
                iDia1 = 30;
            }
            else if (dtFechaIni.Month == 2 && dtFechaIni.Day >= 28)
            {
                //FRC 20160301 Se cambia porque en realidad debe calcular sobre los dìas q son
                //iDia1 = 30;
                iDia1 = dtFechaIni.Day;
            }
            else
            {
                iDia1 = dtFechaIni.Day;
            }

            if (dtFechaFin.Day == 31)
            {
                iDia2 = 30;
            }
            else if (dtFechaFin.Month == 2 && dtFechaFin.Day >= 28)
            {
                //FRC 20160301 Se cambia porque en realidad debe calcular sobre los dìas q son
                //iDia2 = 30;
                iDia2 = dtFechaFin.Day;
            }
            else
            {
                iDia2 = dtFechaFin.Day;
            }

            iDias = iDia2 - iDia1;

            idiasDif = iYear * 360 + imeses * 30 + iDias;

            if (idiasDif < 0)
            {
                idiasDif = 0;
            }

            return idiasDif;
        }

        public static int DiferenciaDias(DateTime dtFechaIni, DateTime dtFechaFin)
        {
            TimeSpan ts;
            int iDias = 0;
            int iMeses = 0;
            ts = dtFechaFin - dtFechaIni;
            if (ts.Days > 0)
            {
                if (dtFechaIni.Month == dtFechaFin.Month && dtFechaIni.Year == dtFechaFin.Year)
                    iMeses = 0;
                else
                {
                    //iMeses = Math.Abs((dtFechaFin.Month - dtFechaIni.Month) + (12 * (dtFechaFin.Year - dtFechaIni.Year))) - 1;
                    iMeses = Math.Abs((dtFechaFin.Month - dtFechaIni.Month) + (12 * (dtFechaFin.Year - dtFechaIni.Year)));
                }
                iDias = (iMeses * 30) - dtFechaIni.Day;
                //iDias += 30 - dtFechaIni.Day;
                iDias += dtFechaFin.Day;

                if (((dtFechaFin.Month - dtFechaIni.Month) == 1) && ((dtFechaFin.Year - dtFechaIni.Year) == 0))
                {
                    iDias = ts.Days;
                }
            }

            return iDias;
        }

