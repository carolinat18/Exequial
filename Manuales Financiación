                    //Cambia valor total condonacion

                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "actualizarTotalCondonado", "/TQueries/Queries/Query");

                    query = query.Replace("%docentry%", credito);

                    query = query.Replace("%condonado%", 0.ToString());

                    ors.DoQuery(query);
                }


                return "OK";
            }
            catch (Exception e)
            {

                OK1.SBO.Helpers.reportar_error("addInFinanciacion", "ERROR2022", e.ToString().Substring(e.ToString().Length - 254), sapCompany, true);
