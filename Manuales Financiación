                            if (!bPagoAdicional || !bDescuentoAdicional)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos, 0);


                            if (bPagoAdicional && bDescuentoAdicional && iLinea != iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos + db_VlrAdicional - db_VlrDescAdicional, 0);
                            else
                                if (bPagoAdicional && bDescuentoAdicional && iLinea == iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos, 0);
                            else
                                    if (bPagoAdicional && iLinea != iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos + db_VlrAdicional, 0);
                            else
                                        if (bPagoAdicional && iLinea == iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos, 0);
                            else
                                            if (bDescuentoAdicional && iLinea != iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos - db_VlrDescAdicional, 0);
                            else
                                                if (bDescuentoAdicional && iLinea == iConteoCuota)
                                dbVlrTotalCuota = Math.Round(dbVlrCuota + dbTotGtos, 0);
                            #endregion


                            #region ajuste de la ultima cuota por redondeo
                            if (iLinea != (iConteoCuota - 1)) //ULTIMA CUOTA
                                oGralDataNueva.SetProperty("U_VlrPago", dbVlrTotalCuota);
                            #endregion

                            oGralDataNueva.SetProperty("U_FechPPag", oFG.ObtenerFechaCuota(this.dtFechaPago, iLinea));
                            #endregion

                            #endregion

                        }

                        bPagoAdicional = false;
                        bDescuentoAdicional = false;

                        #endregion
                    }
                    #endregion

                    if (dbSaldo > 0)
                        oGralDataNueva.SetProperty("U_SaldoCr", 0);
                    #endregion
                }
                #endregion

                #region setear valores globales

                oGralData.SetProperty("U_VlrCaPen", dbVlrCapital);
                oGralData.SetProperty("U_VlrInPen", dbTotIntR);
                oGralData.SetProperty("U_NroCuPen", (this.iNroCuotas - this.ICuotaInicialTabla)); //FRC 20160302 Se resta la cuota inicial de la tabla
                oGralData.SetProperty("U_NroTabla", this.iTabla);
                oGralData.SetProperty("U_VlrCuota", this.dbVlrCuotaMensual); //FRC 20160610 Se recupera el valor de la cuota mensual para actualizar
                oGralData.SetProperty("U_VlrTCuot", this.dbVlrCuotaMensual); //FRC 20160610 Se recupera el valor de la cuota mensual para actualizar

                oGralServ.Update(oGralData);
                this.blOk = true;

                if (insertarParcialTC)
                {
                    //oConsulta.EjecutarConsulta(ref oRecordSet, oConsulta.QryInsertarPagoParcial(strDocEntry, "1", "0"));

                    #region Insertar pago parcial de la cuotas pagas del credito anterior tipo cambio
                    insertarParcialTC = FuncionesGenerales.InsertaValorParcialesLineas8(oCmpServ, this.strDocEntry, ppc);
                    #endregion
                }
                #endregion

            }
            catch (Exception ex)
            {
                this.blOk = false;
                this.strError = "Se presento Error al Calcular el Crédito: " + ex.Message;
                OK1.SBO.Helpers.reportar_error(ex, "addInFinanciacion", "CalcularCrédito CreditosFinanciacion", this.oCmp);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oCmpServ);
                OK1.SBO.Helpers.LiberarCOM(oGralServ);
                OK1.SBO.Helpers.LiberarCOM(oGralDP);
                OK1.SBO.Helpers.LiberarCOM(oGralData);
                OK1.SBO.Helpers.LiberarCOM(oGralDC);
            }
        }

