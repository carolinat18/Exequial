                    #endregion
                }
                else
                {
                    strResultado = "El credito seleccionado no cuenta con fecha de pago valida en su ultima cuota, debe validar el credito.";
                }


            }
            catch (Exception ex)
            {
                strResultado = " Error al ejecutar el proceso: " + ex.Message;
                if (this.oCmp.InTransaction)
                    this.oCmp.EndTransaction(SAPbobsCOM.BoWfTransOpt.wf_RollBack);
            }
            finally
            {
                if (this.oCmp.InTransaction)
                    this.oCmp.EndTransaction(SAPbobsCOM.BoWfTransOpt.wf_Commit);
            }
            return blResultado;
        }

