            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error("addInFinanciacion", "ERROR2022", e.ToString().Substring(e.ToString().Length - 254), sapCompany, true);
                return "ERROR" + e.ToString();
            }
        }
