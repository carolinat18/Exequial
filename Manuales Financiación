        public string retornarConsultaBusqueda(SAPbouiCOM.Application sapApplication, SAPbouiCOM.Form oForm)
        {
            string strQuery = "";
            string dsConsecutivo = "";
            string dsPrenec = "";
            string dsCardCode = "";
            string dsCardName = "";
            string dsDocNum = "";
            string dsDesembolso = "";
            string dsOperador = "";
            string dsValorCredito = "";
            string strFiltro = "";
            string fechaIni = "";
            string fechaFin = "";
            string dsEstado = "";

            SAPbouiCOM.ComboBox oComboOperador;
            try
            {
                dsCardCode = oForm.DataSources.UserDataSources.Item("DSCardCo").Value.ToString();
                dsCardName = oForm.DataSources.UserDataSources.Item("DSCardNa").Value.ToString();
                dsDocNum = oForm.DataSources.UserDataSources.Item("DSDocNum").Value.ToString();
