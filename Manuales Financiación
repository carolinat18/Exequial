                        break;
                    case TipoAlerta.alerta6:
                        getUsuariosDeAlerta("6", ref oRSUsuarios);
                        break;
                    case TipoAlerta.alerta7:
                        getUsuariosDeAlerta("7", ref oRSUsuarios);
                        break;
                    case TipoAlerta.alerta8:
                        getUsuariosDeAlerta("8", ref oRSUsuarios);
                        break;
                    case TipoAlerta.alerta9:
                        getUsuariosDeAlerta("9", ref oRSUsuarios);
                        break;
                    case TipoAlerta.alerta10:
                        getUsuariosDeAlerta("10", ref oRSUsuarios);
                        break;
                }

                if (oRSUsuarios.RecordCount > 0)
                {
                    int i = 0;
                    switch (idFormulario)
                    {
                        case "OK1_FINAN_CRED":
                            oCS = oCmp.GetCompanyService();
                            oMS = (SAPbobsCOM.MessagesService)oCS.GetBusinessService(ServiceTypes.MessagesService);
                            oMsg = (SAPbobsCOM.Message)oMS.GetDataInterface(MessagesServiceDataInterfaces.msdiMessage);
                            oMsg.Subject = "Alerta AddIn Financiacion";
                            oMsg.Text = oRSUsuarios.Fields.Item("U_Mensaje").Value.ToString() + " CredSI: " + serieSolicitud + " - No. Doc: " + numeroSolicitud;
                            oMsg.Priority = BoMsgPriorities.pr_High;
                            break;
                        case "":
                            oCS = oCmp.GetCompanyService();
                            oMS = (SAPbobsCOM.MessagesService)oCS.GetBusinessService(ServiceTypes.MessagesService);
                            oMsg = (SAPbobsCOM.Message)oMS.GetDataInterface(MessagesServiceDataInterfaces.msdiMessage);
                            oMsg.Subject = "Alerta AddIn Financiacion";
                            oMsg.Text = oRSUsuarios.Fields.Item("U_Mensaje").Value.ToString() + " Serie doc: " + serieSolicitud + " - No. Doc: " + numeroSolicitud;
                            oMsg.Priority = BoMsgPriorities.pr_High;
                            break;
                        case "OK1_FINAN_GTIAS":
                            oCS = oCmp.GetCompanyService();
                            oMS = (SAPbobsCOM.MessagesService)oCS.GetBusinessService(ServiceTypes.MessagesService);
                            oMsg = (SAPbobsCOM.Message)oMS.GetDataInterface(MessagesServiceDataInterfaces.msdiMessage);
                            oMsg.Subject = "Alerta AddIn Financiacion";
                            stmensaje = oRSUsuarios.Fields.Item("U_Mensaje").Value.ToString();
                            oMsg.Text = stmensaje + " Garantia - " + serieSolicitud + ": " + numeroSolicitud;
                            oMsg.Priority = BoMsgPriorities.pr_High;
                            break;
                    }


                    while (!oRSUsuarios.EoF)
                    {
                        oMsg.RecipientCollection.Add();
                        oMsg.RecipientCollection.Item(i).SendInternal = BoYesNoEnum.tYES;
                        oMsg.RecipientCollection.Item(i).UserCode = oRSUsuarios.Fields.Item("U_Usuario").Value.ToString();
                        i++;
                        oRSUsuarios.MoveNext();
                    }
                    oMS.SendMessage(oMsg);
                }
            }
            catch (Exception e)
            {
                // oApp.StatusBar.SetText(e.Message, BoMessageTime.bmt_Medium, BoStatusBarMessageType.smt_Error);
                OK1.SBO.Helpers.reportar_error(e, "addInSrvFun", "EXC018", oCmp);
            }
            finally
            {
                if (oRSUsuarios != null)
                    OK1.SBO.Helpers.LiberarCOM(oRSUsuarios);
            }
        }

