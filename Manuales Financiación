        /// <summary>
        /// Devuelve un string con el resultado de la validación de los campos del SN (Fecha y Lugar de Nacimiento, Fecha y Lugar de Expedicion)
        /// </summary>
        /// <param name="strCardCode">Código del SN al que se le va a validar</param>
        /// <param name="oCmp">Objeto Compañia de SAP</param>
        /// <returns>Si los campos estan completos retorna una cadena vacia, de lo contrario retorna un mensaje según el caso encontrado</returns>
        public string ValidarCamposSN(string strCardCode)
        {
            string strResultado = "";

            SAPbobsCOM.Recordset oRec = null;

            try
            {
                this.oConsulta.EjecutarConsulta(ref oRec, this.oConsulta.QryValidarSN(strCardCode));

                if (oRec.RecordCount > 0)
                {
                    for (int i = 0; i < 4; i++)
                    {
                        if (oRec.Fields.Item(i).Value.Equals("") || oRec.Fields.Item(i).Value.ToString().Equals("01/01/1900 12:00:00 a. m."))
                        {
                            if (!strResultado.Equals(""))
                                strResultado += ", ";
                            switch (i)
                            {
                                case 0:
                                    strResultado += "Fecha de Nacimiento";
                                    break;
                                case 1:
                                    strResultado += "Lugar de Nacimiento";
                                    break;
                                case 2:
                                    strResultado += "Fecha de Expedición";
                                    break;
                                case 3:
                                    strResultado += "Lugar de Expedición";
                                    break;
                            }
                        }
                    }
                }
                else
                    strResultado = "Código de SN Incorrecto";
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "Financiacion", "EXC-FG0028", this.sapCompany);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRec);
            }

            return strResultado;
        }

        /// <summary>
        /// Se valida que exista el código de Transacciones (RFIN), de lo contrario se muestra un mensaje para indicar que debe ser creado.
        /// </summary>
        /// <param name="oApp">Objeto Aplicación de SAP</param>
        /// <param name="oCmp">Objeto Compañia de SAP</param>
        /// <returns></returns>
        public bool Revisar_Codigos_Transaccion(SAPbouiCOM.Application oApp)
        {
            bool blReturn = false;
            string consulta = null;
            SAPbobsCOM.Recordset oRecTrnsCode = (SAPbobsCOM.Recordset)this.sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
            consulta = this.oConsulta.QryCodigoTransaccion();
            oRecTrnsCode.DoQuery(consulta);
            if (oRecTrnsCode.RecordCount > 0)
            {
                StringBuilder strTransacciones = new StringBuilder();
                strTransacciones.AppendLine("Debe crear los siguientes codigos de transacciones en el registro de diario para que la funcionalidad de Financiación funcione correctamente:");
                while (!oRecTrnsCode.EoF)
                {
                    strTransacciones.AppendLine("Codigo: " + oRecTrnsCode.Fields.Item(0).Value.ToString() + ". Descripcion: " + oRecTrnsCode.Fields.Item(1).Value.ToString());
                    oRecTrnsCode.MoveNext();
                }
                oApp.MessageBox(strTransacciones.ToString(), 1, "Aceptar", "", "");
            }
            else
                blReturn = true;
            return blReturn;
        }

