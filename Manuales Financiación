        /// <summary>
        /// Calcula el valor mensual de la prenecesidad
        /// </summary>
        /// <param name="oFormPreNecFina">Formulario de prenecesidad</param>
        public double ValorCuotaPrenecesidad(SAPbouiCOM.Form oFormPreNecFina)
        {
            double db_VlrCuota = 0;
            double db_VlrCapital = 0;
            double db_VlrCuotaInicial = 0;
            double db_TIM = 0;
            double db_VlrIni = 0;

            string str_MesCuota = string.Empty;
            DateTime dt_fecIni;
            DateTime dt_FechaCuota;

            ArrayList PgAdicionales = new ArrayList();
            double db_VlrAdicional = 0;
            SAPbouiCOM.Matrix oMtxPA;
            double db_VlrPgAd = 0;
            bool bPagoAdicional = false;
            int i_NroCuotas = 0;
            int i_Linea = 0;


            SAPbouiCOM.Matrix oMtxS;
            SAPbouiCOM.DBDataSource oDBDataS;

            string str_NroCuota = string.Empty;

            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            #region CAB ENERO 2022 PAGOS ADICIONALES
            PagosAdicionalesCuotas oPAC = new PagosAdicionalesCuotas();

            oMtxPA = (SAPbouiCOM.Matrix)oFormPreNecFina.Items.Item("mtxPgAd").Specific;

            PgAdicionales.Clear();

            for (int i1 = 1; i1 <= oMtxPA.RowCount; i1++)
            {
                oPAC.str_CuotaMes = ((SAPbouiCOM.ComboBox)oMtxPA.GetCellSpecific("col_0", i1)).Value.Trim();
                oPAC.db_VlrAdi = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxPA.GetCellSpecific("col_9", i1)).Value);

                PgAdicionales.Add(oPAC);
            }
            #endregion

            db_VlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_valorPrenec", 0));
            db_VlrCuotaInicial = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oFormPreNecFina.DataSources.UserDataSources.Item("valorCI").Value);
            db_TIM = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_porcTasa", 0).Trim()); ;
            db_TIM = db_TIM / 100;
            i_NroCuotas = Convert.ToInt32(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_nCuotas", 0));
            dt_fecIni = OK1.SBO.Helpers.FechaFormateadaAsDateTime(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_fecIn", 0).Trim(), this.oApp);
            db_VlrIni = db_VlrCapital - db_VlrCuotaInicial;

            oMtxS = (SAPbouiCOM.Matrix)oFormPreNecFina.Items.Item("mtx_7").Specific;
            oDBDataS = (SAPbouiCOM.DBDataSource)oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_AMORT");

            oFormPreNecFina.Freeze(true);

            try
            {
                #region Calculo valor Cuota

                #region Tasa de interes diferente de cero (0)

                if (db_TIM != 0)
                {
                    #region CAB ENERO 2022 PAGOS ADICIONALES
                    for (int i = 0; i < i_NroCuotas; i++)
                    {

                        #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021
                        i_Linea = i;
                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (PagosAdicionalesCuotas item in PgAdicionales)
                        {
                            oPAC = (PagosAdicionalesCuotas)item;

                            if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                            {
                                db_VlrAdicional = oPAC.db_VlrAdi;
                                bPagoAdicional = true;
                                break;
                            }
                        }

                        if (bPagoAdicional)
                        {
                            db_VlrPgAd += db_VlrAdicional / Math.Pow((1 + db_TIM), i_Linea);
                        }

                        bPagoAdicional = false;
                        #endregion

                    }
                    #endregion

                    db_VlrCuota = (db_VlrIni - db_VlrPgAd) / ((1 - Math.Pow((1 + db_TIM), -i_NroCuotas)) / db_TIM);

                    db_VlrCuota = Math.Round(db_VlrCuota);
                }

                #endregion

                #region Tasa de interes Cero (0)

                if (db_TIM == 0)
                {
                    #region CAB ENERO 2022 PAGOS ADICIONALES
                    for (int i = 0; i < i_NroCuotas; i++)
                    {
                        #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021
                        i_Linea = i;
                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (PagosAdicionalesCuotas item in PgAdicionales)
                        {
                            oPAC = (PagosAdicionalesCuotas)item;

                            if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                            {
                                db_VlrAdicional = oPAC.db_VlrAdi;
                                bPagoAdicional = true;
                                break;
                            }
                        }

                        if (bPagoAdicional)
                        {
                            db_VlrPgAd += db_VlrAdicional;
                        }

                        bPagoAdicional = false;
                        #endregion

                    }
                    #endregion


                    db_VlrCuota = (db_VlrIni - db_VlrPgAd) / i_NroCuotas;

                    db_VlrCuota = Math.Round(db_VlrCuota);
                }

                #endregion

                #endregion

                return db_VlrCuota;
            }
            finally
            {
                oFormPreNecFina.Freeze(false);
            }

        }


