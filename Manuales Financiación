        /// <summary>Actualiza valores pendientes de un credito </summary>
        private static void ActualizarValoresPendientes(SAPbobsCOM.GeneralData oGeneralData, SAPbouiCOM.Form oFormCredito, ref double ValorPendienteCapital, double ValorCapitalCuota, ref double ValorPendienteInteres, double ValorInteresCuota, ref double ValorTotalPagado, double ValorCuota, ref double ValorTotalPendiente)
        {
            ValorPendienteCapital += ValorCapitalCuota;
            ValorPendienteInteres += ValorInteresCuota;
            ValorTotalPendiente += (ValorCapitalCuota + ValorInteresCuota);
            ValorTotalPagado -= ValorCuota;

            if (ValorTotalPagado < 0)
            {
                ValorTotalPagado = 0;
            }

            oGeneralData.SetProperty("U_VlrCaPen", ValorPendienteCapital.ToString());
            oGeneralData.SetProperty("U_VlrInPen", ValorPendienteInteres.ToString());
            oGeneralData.SetProperty("U_VlrpendienteTot", ValorTotalPendiente.ToString());
            oGeneralData.SetProperty("U_VlrTotPag", ValorTotalPagado.ToString());

            oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrCaPen", 0, ValorPendienteCapital.ToString());
            oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrInPen", 0, ValorPendienteInteres.ToString());
            oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrpendienteTot", 0, ValorTotalPendiente.ToString());
            oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrTotPag", 0, ValorTotalPagado.ToString());
        }


        /// <summary>Encuentra los valores de los pagos parciales invalidos para retirarlos de los saldos del credito</summary>
        private static void ProcesarPagosParciales(SAPbobsCOM.Company sapCompany, Consultas oConsulta, string DocEntryCredito, string lineIndex, ref double ValorPendienteCapital, ref double ValorPendienteInteres, ref double ValorTotalPendiente, ref double ValorTotalPagado, SAPbobsCOM.GeneralData oGeneralData, SAPbouiCOM.Form oFormCredito, string Ruta, SAPbouiCOM.Application sapApplication, int Prenecesidad)
        {
            SAPbobsCOM.Recordset oRecordSetParciales = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
            oRecordSetParciales.DoQuery(oConsulta.QryMostrarPagosParciales(DocEntryCredito, "1", lineIndex));

            int contador = 0;
            while (!oRecordSetParciales.EoF)
            {
                double valorCuota = double.Parse(oRecordSetParciales.Fields.Item("Imp Aplicado Cap").Value.ToString()) +
                                    double.Parse(oRecordSetParciales.Fields.Item("Imp Aplicado Int Cte").Value.ToString());
                string tipoPago = DeterminarTipoPago(oRecordSetParciales, sapCompany, sapApplication, Prenecesidad, contador, oConsulta, Ruta, DocEntryCredito, lineIndex);

                if (tipoPago == "Pago Invalido")
                {
                    double valorCapitalCuota = double.Parse(oRecordSetParciales.Fields.Item("Imp Aplicado Cap").Value.ToString());
                    double valorInteresCuota = double.Parse(oRecordSetParciales.Fields.Item("Imp Aplicado Int Cte").Value.ToString());
                    ActualizarValoresPendientes(oGeneralData, oFormCredito, ref ValorPendienteCapital, valorCapitalCuota, ref ValorPendienteInteres, valorInteresCuota, ref ValorTotalPagado, valorCuota, ref ValorTotalPendiente);
                }

                oRecordSetParciales.MoveNext();
                contador++;
            }
        }


        /// <summary>Determina el tipo de pago en la lista de pagos parciales de la cuota de un credito </summary>
        private static string DeterminarTipoPago(SAPbobsCOM.Recordset oRecordSetParciales, SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, int Prenecesidad, int contador, Consultas oConsulta, string Ruta, string DocEntryCredito, string lineIndex)
        {
            int nroAddIn = int.Parse(oRecordSetParciales.Fields.Item("NroAddIn").Value.ToString());
            int clavePago = int.Parse(oRecordSetParciales.Fields.Item("Clave Pago").Value.ToString());

            string tipoPago = oRecordSetParciales.Fields.Item("Tipo Pago").Value.ToString();

            tipoPago = nroAddIn == 0 && clavePago != 0 ? "Pago Masivo" : tipoPago;

            if (oRecordSetParciales.Fields.Item("Tipo Pago").Value.ToString() == "Pago Migrado")
            {
                var queryMigrado = OK1.Generic.Helpers.configParteConsulta(Ruta + @"AddInQueries\Queries_HANA.xml", "VerificarPagoMigradoParcial", "/TQueries/Queries/Query")
                                  .Replace("%DocEntry%", DocEntryCredito)
                                  .Replace("%Cuota%", lineIndex)
                                  .Replace("%LineId%", oRecordSetParciales.Fields.Item("LineId").Value.ToString());

                var oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                oRecordSet.DoQuery(queryMigrado);
                if (oRecordSet.RecordCount > 0 && !FuncionesGenerales.Desencriptar(sapCompany, oRecordSet.Fields.Item("U_DTW").Value.ToString()).Equals("MigracionesCSS"))
                {
                    tipoPago = "Pago Invalido";
                }
            }

            if (contador == 0 && FuncionesGenerales.CuotaTipoCambio(sapCompany, sapApplication, Prenecesidad.ToString(), Ruta))
            {
                tipoPago = "Anticipo Cambio";
            }

            if (contador == oRecordSetParciales.RecordCount - 1)
            {
                string query = OK1.Generic.Helpers.configParteConsulta(Ruta + @"AddInQueries\Queries_HANA.xml", "ObtenerMotivoCondonacion", "/TQueries/Queries/Query")
                                .Replace("%DocEntry%", DocEntryCredito)
                                .Replace("%U_NroCuot%", lineIndex);

                SAPbobsCOM.Recordset oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                oRecordSet.DoQuery(query);

                if (oRecordSet.RecordCount > 0 && !string.IsNullOrEmpty(oRecordSet.Fields.Item("U_Motivo").Value.ToString()) && oRecordSet.Fields.Item("U_Motivo").Value.ToString() != "0")
                {
                    tipoPago = "Pago Condonado";
                }
            }

            return tipoPago;
        }

