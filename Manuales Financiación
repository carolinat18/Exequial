        public void actualizarValorPagoCreditos(SAPbobsCOM.Company oCompany, SAPbouiCOM.Application oApplication, string strPath)
        {
            SAPbobsCOM.Recordset orset = null;
            SAPbobsCOM.Recordset oRs = null;

            string query = "";
            string strIdCred = "";
            int i = 0;

            try
            {
                orset = (SAPbobsCOM.Recordset)oCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                query = OK1.Generic.Helpers.configParteConsulta(strPath + @"AddInQueries\Queries_HANA.xml", "ConsultarListadoCreditos", "/TQueries/Queries/Query");
                orset.DoQuery(query);

                int totalRegistros = orset.RecordCount;
                if (totalRegistros == 0)
                {
                    oApplication.StatusBar.SetText("No hay créditos para procesar.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);
                    return;
                }

                while (!orset.EoF)
                {
                    i++;
                    strIdCred = orset.Fields.Item(0).Value.ToString();

                    #region Actualizar valor pago en el formulario del crédito 
                    query = oConsulta.QryVlrTotalPagoPrenecesidad(strIdCred);
                    oConsulta.EjecutarConsulta(ref oRs, query);
                    double dbVlrTotalPago = OK1.SBO.Helpers.DoubleFromDBDataSource(oCompany, oRs.Fields.Item(0).Value);

                    query = oConsulta.QryActualizarTotalPagoPrenec(OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCompany, dbVlrTotalPago), strIdCred);
                    oConsulta.EjecutarConsulta(ref oRs, query);


                    query = oConsulta.QryVlrPendienteCapInteCredito(strIdCred);
                    oConsulta.EjecutarConsulta(ref oRs, query);
                    double dbVlrPendiCap = OK1.SBO.Helpers.DoubleFromDBDataSource(oCompany, oRs.Fields.Item(0).Value);
                    double dbVlrPendiInt = OK1.SBO.Helpers.DoubleFromDBDataSource(oCompany, oRs.Fields.Item(1).Value);

                    query = oConsulta.QryActualizarVlrPendienteCapIntCredito(OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCompany, dbVlrPendiCap), OK1.SBO.Helpers.DoubleToDBDataSourceImporte(oCompany, dbVlrPendiInt), strIdCred);
                    oConsulta.EjecutarConsulta(ref oRs, query);

                    double PendienteTotal = dbVlrPendiCap + dbVlrPendiInt;

                    query = @"UPDATE ""@OK1_FINAN_CRED_HEAD"" 
                                                             SET  ""U_VlrpendienteTot"" = '" + PendienteTotal.ToString() + @"' 
                                                             WHERE ""DocEntry"" = '" + strIdCred + @"'";

                    oConsulta.EjecutarConsulta(ref oRs, query);
                    #endregion

                    // Calcular porcentaje de progreso
                    double porcentaje = ((double)i / totalRegistros) * 100;

                    // Mostrar en la barra de estado el progreso con porcentaje
                    oApplication.StatusBar.SetText(
                        $"Actualizando crédito {i} de {totalRegistros}  |  #{strIdCred}  |  Progreso: {porcentaje:0.0}%",
                        BoMessageTime.bmt_Short,
                        BoStatusBarMessageType.smt_Success
                    );

                    orset.MoveNext();
                }

                oApplication.StatusBar.SetText("Operación finalizada correctamente.", BoMessageTime.bmt_Medium, BoStatusBarMessageType.smt_Success);
            }
            catch (System.Exception ex)
            {
                OK1.SBO.Helpers.reportar_error(ex, "addInFinanciacion", "actualizarValorPagoCreditos", oCompany);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(orset);
                OK1.SBO.Helpers.LiberarCOM(oRs);
            }
        }

    }
