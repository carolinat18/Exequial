        /// <summary> Recibe el numero del credito con fallas en sus cuotas</summary>
        /// <param name="credito"> Numero del credito</param>
        /// <param name="sapCompany">SAP Company</param>
        /// <param name="path"> Ruta </param>
        /// <returns>True proceso exitoso</returns>
        public static bool repararCredito(int credito, SAPbobsCOM.Company sapCompany, string path)
        {

            double capital = 0;
            double intereses = 0;
            double seguro = 0;
            double sumatoria = 0;
            double diferencia = 0;
            double pago = 0;
            SAPbobsCOM.Recordset ors = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
            SAPbobsCOM.Recordset ors1 = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

            try
            {

                String query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "RepararCredito", "/TQueries/Queries/Query");
                query = query.Replace("%docentry%", credito.ToString());
                ors.DoQuery(query);
                int cuotas = 0;
                if (ors.RecordCount > 0)
                {
                    int val = int.Parse(ors.Fields.Item("U_NroCuot").Value.ToString());

                    if (val == 0)
                    {
                        cuotas = ors.RecordCount - 1;
                    }
                    else
                    if (val == 1)
                    {
                        cuotas = ors.RecordCount;
                    }

                    double deuda = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("U_VlrCred").Value);
                    string docentryexe = ors.Fields.Item("DocEntry").Value.ToString();

                    while (!ors.EoF)
                    {

                        capital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("U_Capital").Value);
                        intereses = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("U_Intereses").Value);
                        seguro = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("U_VlrSeg").Value);
                        sumatoria = capital + intereses + seguro;

                        string pagado = ors.Fields.Item("U_Pagado").Value.ToString().Trim();
                        if (pagado.Equals("N"))
                        {

                            query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarCuotas", "/TQueries/Queries/Query");
                            query = query.Replace("%pago%", sumatoria.ToString());
                            query = query.Replace("%docentry%", credito.ToString());
                            query = query.Replace("%cuota%", ors.Fields.Item("U_NroCuot").Value.ToString());
                            ors1.DoQuery(query);

                            int U_NroCuot = 0;
                            try
                            {
                                U_NroCuot = Convert.ToInt32(ors.Fields.Item("U_NroCuot").Value);
                            }
                            catch { }

                            if (U_NroCuot == cuotas)
                            {

                                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarUltimaCuota", "/TQueries/Queries/Query");
                                capital = capital - (-(diferencia));
                                query = query.Replace("%capital%", capital.ToString());
                                sumatoria = capital + intereses + seguro;
                                query = query.Replace("%pago%", sumatoria.ToString());
                                query = query.Replace("%docentry%", credito.ToString());
                                query = query.Replace("%cuota%", cuotas.ToString());
                                ors1.DoQuery(query);

                            }

                        }
                        else
                        {
                            string cuotapagada = ors.Fields.Item("U_VlrPago").Value.ToString();
                            double U_VlrPago = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("U_VlrPago").Value);
                            query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarCuotas", "/TQueries/Queries/Query");
                            query = query.Replace("%pago%", cuotapagada.ToString());
                            query = query.Replace("%docentry%", credito.ToString());
                            query = query.Replace("%cuota%", ors.Fields.Item("U_NroCuot").Value.ToString());
                            ors1.DoQuery(query);
                            diferencia = diferencia + (sumatoria - U_VlrPago);

                        }

                        deuda = deuda - capital;
                        ors.MoveNext();

                    }

                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarUltimaCuota", "/TQueries/Queries/Query");
                    deuda = capital + deuda;
                    query = query.Replace("%capital%", deuda.ToString());
                    sumatoria = deuda + intereses + seguro;
                    query = query.Replace("%pago%", sumatoria.ToString());
                    query = query.Replace("%docentry%", credito.ToString());
                    query = query.Replace("%cuota%", cuotas.ToString());
                    ors.DoQuery(query);

                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "SumatoriaPagos", "/TQueries/Queries/Query");
                    query = query.Replace("%docentry%", credito.ToString());
                    ors.DoQuery(query);
                    pago = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item("SUMA").Value);

                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarCreditoExe", "/TQueries/Queries/Query");
                    query = query.Replace("%pago%", pago.ToString());
                    query = query.Replace("%docentry%", credito.ToString());
                    query = query.Replace("%docentryexe%", docentryexe);
                    ors.DoQuery(query);


                }
                return true;
            }
            catch (Exception e)

            {

                return false;
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(ors);
                OK1.SBO.Helpers.LiberarCOM(ors1);

            }
        }

