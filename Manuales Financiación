        /// <summary>Servicio para enviar mensajes internos en SAP acerca de las boletas con estado abierto</summary>
        /// <param name="path">Ruta</param>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="subject">Tema mensaje</param>
        /// <param name="text">Descripcion Mensaje</param>
        /// <param name="lista">Lista de boletas abiertas</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <returns>OK proceso exitoso</returns>
        public static string EnvioMensajeInterno(string path, SAPbobsCOM.Company sapCompany, string subject, string text, List<string> lista, SAPbouiCOM.Application sapApplication)
        {
            SAPbobsCOM.Recordset ors = null;

            try
            {
                SAPbobsCOM.CompanyService oCmpSrv;

                MessagesService oMessageService;

                oCmpSrv = sapCompany.GetCompanyService();

                oMessageService = (SAPbobsCOM.MessagesService)oCmpSrv.GetBusinessService(ServiceTypes.MessagesService);

                SAPbobsCOM.Message oMessage = null;

                MessageDataColumns pMessageDataColumns = null;

                MessageDataColumn pMessageDataColumn = null;

                MessageDataLines oLines = null;

                MessageDataLine oLine = null;

                RecipientCollection oRecipientCollection = null;

                oMessage = ((SAPbobsCOM.Message)(oMessageService.GetDataInterface(MessagesServiceDataInterfaces.msdiMessage)));

                oMessage.Subject = subject;

                oMessage.Text = text;

                oMessage.Priority = SAPbobsCOM.BoMsgPriorities.pr_High;

                oRecipientCollection = oMessage.RecipientCollection;

                ors = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "usuariosAlertasBoletas", "/TQueries/Queries/Query");

                ors.DoQuery(query);

                if (ors.RecordCount > 0)
                {
                    int j = 0;

                    while (!ors.EoF)
                    {
                        oRecipientCollection.Add();

                        oRecipientCollection.Item(j).SendInternal = SAPbobsCOM.BoYesNoEnum.tYES;

                        oRecipientCollection.Item(j).UserCode = ors.Fields.Item("U_Usuario").Value.ToString();

                        j++;

                        ors.MoveNext();
                    }

                    pMessageDataColumns = oMessage.MessageDataColumns;

                    pMessageDataColumn = pMessageDataColumns.Add();

                    pMessageDataColumn.ColumnName = "Enlace Boleta";

                    pMessageDataColumn.Link = SAPbobsCOM.BoYesNoEnum.tYES;

                    oLines = pMessageDataColumn.MessageDataLines;

                    for (int i = 0; i < lista.Count; i++)
                    {

                        oLine = oLines.Add();

                        oLine.Value = "Boleta -- Estado abierto";

                        oLine.Object = "13";

                        oLine.ObjectKey = lista[i];

                    }

                    oMessageService.SendMessage(oMessage);

                }
                sapApplication.StatusBar.SetText("Se ha enviado alerta 'Boletas estado abierto.'", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);

                sapApplication.MessageBox("Se ha enviado alerta 'Boletas estado abierto.'", 1, "Aceptar", "", "");

                return "OK";
            }
            catch (Exception e)
            {

                return "ERROR : " + e.ToString();
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(ors);
            }
        }

