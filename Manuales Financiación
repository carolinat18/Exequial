        private bool RegistroAjusteInteres(string docFact, CreditosFinanciacion oCredit, string sCuentaCapital, string sCuentaIntereses, double valor)
        {
            bool blResultado = true;
            string cc1 = "", cc2 = "", cc3 = "", cc4 = "";
            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            oFG.ObtenerCCPrenecesidad(oCredit.iNroPrenecesidad, ref cc1, ref cc2, ref cc3, ref cc4);
            SAPbobsCOM.JournalEntries oJE = (JournalEntries)this.oCmp.GetBusinessObject(BoObjectTypes.oJournalEntries);
            oJE.Memo = "RECLASIFICACIÓN DE INTERESES - " + docFact + "";
            oJE.Reference = oCredit.iNroPrenecesidad.ToString();
            oJE.DueDate = DateTime.Now;
            oJE.TaxDate = DateTime.Now;
            oJE.ReferenceDate = DateTime.Now;
            oJE.UserFields.Fields.Item("U_contra").Value = oCredit.iNroPrenecesidad.ToString();
            oJE.UserFields.Fields.Item("U_OK1_IFRS").Value = "L";
            oJE.Reference2 = oCredit.strDocEntry;
            oJE.Reference3 = "RECLINT";
            oJE.ProjectCode = oCredit.stProyecto;
            oJE.TransactionCode = "PRRI";

            oJE.Lines.AccountCode = sCuentaCapital;
            oJE.Lines.Credit = valor;
            oJE.Lines.CostingCode = cc1;
            oJE.Lines.CostingCode2 = cc2;
            oJE.Lines.CostingCode3 = cc3;
            oJE.Lines.CostingCode4 = cc4;
            oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = oCredit.strCardCode;
            oJE.Lines.Reference1 = oCredit.iNroPrenecesidad.ToString();
            oJE.Lines.Reference2 = oCredit.strDocEntry;
            oJE.Lines.AdditionalReference = "L";
            oJE.Lines.Add();

            oJE.Lines.AccountCode = sCuentaIntereses;
            oJE.Lines.Debit = valor;
            oJE.Lines.CostingCode = cc1;
            oJE.Lines.CostingCode2 = cc2;
            oJE.Lines.CostingCode3 = cc3;
            oJE.Lines.CostingCode4 = cc4;
            oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = oCredit.strCardCode;
            oJE.Lines.UserFields.Fields.Item("U_contra").Value = oCredit.iNroPrenecesidad.ToString();
            oJE.Lines.Reference1 = oCredit.iNroPrenecesidad.ToString();
            oJE.Lines.Reference2 = oCredit.strDocEntry;
            oJE.Lines.AdditionalReference = "L";
            oJE.Lines.Add();

            int iError = oJE.Add();

            if (iError != 0)
            {
                blResultado = false;
            }

            return blResultado;
        }

