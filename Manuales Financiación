        /// <summary>Registrar Pagos reutilizados del tipo 7 (Vinculado)</summary>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="Path">Ruta</param>
        /// <param name="oFormFinanPagos">Formulario FINAN-PAGOS</param>
        /// <returns>True registro correcto</returns>
        public static bool ActualizarPago(SAPbouiCOM.Application sapApplication, SAPbobsCOM.Company sapCompany, string Path, SAPbouiCOM.Form oFormFinanPagos)
        {
            SAPbobsCOM.Recordset oRecordSet = null;
            try
            {
                SAPbouiCOM.Matrix oMatrixPagos = (SAPbouiCOM.Matrix)oFormFinanPagos.Items.Item("mtx_0").Specific;
                double ValorRecibo = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value.ToString());
                double ValorTotal = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTotP").Specific).Value.ToString());
                string query = "";
                string docEntryPago = "";

                #region Consultar DocEntry Pago
                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerDocEntryRecibo", "/TQueries/Queries/Query");

                query = query.Replace("%DocNum%", ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_NroPag").Specific).Value.ToString());

                oRecordSet.DoQuery(query);

                docEntryPago = oRecordSet.Fields.Item("DocEntry").Value.ToString();
                #endregion


                if (ValorRecibo >= ValorTotal)
                {
                    oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    string TipoPago = "7";

                    if (((SAPbouiCOM.CheckBox)oFormFinanPagos.Items.Item("Chk_TotalP").Specific).Checked)
                    {
                        TipoPago = "8";
                    }

                    string ComboDocumentoVinculado = ((SAPbouiCOM.ComboBox)oFormFinanPagos.Items.Item("OKEddocVi").Specific).Selected.Value.ToString().Trim();

                    if (ComboDocumentoVinculado.Equals("PR"))
                    {
                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "EstadoRC", "/TQueries/Queries/Query");

                        query = query.Replace("%DocNum%", oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0));

                        oRecordSet.DoQuery(query);

                        if (oRecordSet.RecordCount > 0)
                        {

                            double ValorTotalRC = OK1.SBO.Helpers.DoubleFromEditText(oRecordSet.Fields.Item("DocTotal").Value.ToString());


                            if (ValorTotalRC != ValorTotal)
                            {

                                sapApplication.SetStatusBarMessage("El recibo de caja seleccionado no permite ser vinculado parcialmente. Registre su Importe Total", BoMessageTime.bmt_Short, true);
                                sapApplication.MessageBox("El recibo de caja seleccionado no permite ser vinculado parcialmente. Registre su Importe Total", 1, "Aceptar", "", "");
                                return false;
                            }

                        }


                        if (FuncionesGenerales.ActualizarPendientesCuota(sapCompany, sapApplication, Path, oMatrixPagos, ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edConsec").Specific).Value.ToString(), TipoPago, ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_DocNum").Specific).Value.ToString()))
                        {
                            ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value = ValorTotal.ToString();

                            FuncionesGenerales.RegistrarPagosCreditoRC(sapApplication, sapCompany, Path, oFormFinanPagos);

                            #region Asignar DocEntry a U_EntrPago 
                            ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_EntrPag").Specific).Value = docEntryPago;
                            #endregion

                        }
                        else
                        {
                            return false;
                        }

                    }
                    else
                    {
                        if (FuncionesGenerales.ActualizarPendientesCuota(sapCompany, sapApplication, Path, oMatrixPagos, ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edConsec").Specific).Value.ToString(), TipoPago, ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_DocNum").Specific).Value.ToString()))
                        {

                            ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value = ValorTotal.ToString();

                            FuncionesGenerales.RegistrarPagosCreditoRD(sapApplication, sapCompany, Path, oFormFinanPagos);

                            #region Asignar DocEntry a U_TransId

                            oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                            query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ValidacionRegistroDiario", "/TQueries/Queries/Query");

                            query = query.Replace("%Number%", ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_NroPag").Specific).Value.ToString());

                            oRecordSet.DoQuery(query);

                            oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").SetValue("U_TransId", 0, oRecordSet.Fields.Item("TransId").Value.ToString());

                            #endregion
                        }
                        else
                        {
                            return false;
                        }


                    }
                }
                else
                {
                    sapApplication.StatusBar.SetText("El documento seleccionado no puede ser vinculado, el saldo disponible debe ser superior o igual al total de todos los documentos liquidados", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                    sapApplication.MessageBox("El documento seleccionado no puede ser vinculado, el saldo disponible debe ser superior o igual al total de todos los documentos liquidados", 1, "Aceptar", "", "");

                    return false;
                }
                return true;

            }
            catch (Exception e)
            {

                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "FuncionesGenarales-ActualizarPago", sapCompany);
                return false;

            }
            finally
            {

                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
            }



        }

        /// <summary>Registra Pagos tipo 7 (Vinculado) sobre un credito</summary>
        /// <param name="sapApplication">Aplicacion SAP</param>
