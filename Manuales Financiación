        public bool evtMenuHandler(ref SAPbouiCOM.MenuEvent pVal, out bool BubbleEvent)
        {
            #region variables
            BubbleEvent = true;
            SAPbouiCOM.Form oForm = null;
            SAPbouiCOM.ComboBox oCombo = null;
            SAPbouiCOM.Matrix oMatrix = null;
            Consultas oConsulta = new Consultas(sapCompany, this.StrPath, this.strTipoServer);
            FuncionesGenerales oFG = new FuncionesGenerales(sapCompany, this.StrPath, this.strTipoServer);
            int iMenu = 0;
            int iCont = 0; //FRC 20160929 Variable para controlar la cantidad de registros de pagos parciales
            double dbTim = 0;
            string strCampo = "";
            string strForm = "";
            SAPbobsCOM.Recordset oRsT = null;
            SAPbobsCOM.Recordset oRsPagPar = null; //FRC 20160929 Objeto para recorrer pagos parciales a anular
            iBranch = OK1.SBO.Helpers.ObtenerSucursal(sapCompany, sapApplication);
            string idParamInfo = "0";
            string idParamInfo1 = "0";
            #endregion

            #region idParamInfo
            try
            {
                idParamInfo = AppDomain.CurrentDomain.GetData("parametroId").ToString();

            }
            catch
            {
                idParamInfo = "0";
            }

            try
            {
                idParamInfo1 = AppDomain.CurrentDomain.GetData("IdIntCredito").ToString();
            }
            catch
            {

                idParamInfo1 = "0";
            }
            #endregion

            switch (pVal.MenuUID)
            {
                #region BLOQUEAR CAMPOS DE USUARIO
                case "6913"://boton  del menu
                    if (pVal.BeforeAction)
                    {
                        oForm = sapApplication.Forms.ActiveForm;
                        switch (oForm.TypeEx)
                        {
                            case "OK1_FINAN_CRED":
                            case "OK1_FINAN_PAGO":
                                BubbleEvent = false;
                                break;
                        }
                    }
                    break;
                #endregion
                #region OK1_FINAN_MCFPCC
                case "OK1_FINAN_MCFPCC":
                    if (!pVal.BeforeAction)
                    {
                        oForm = OK1.SBO.HelpersXMLSBO.LoadFormFromXML(this.StrPath + @"Forms\OK1_FINAN_CFPCC.xml", sapApplication, "OK1_FINAN_CFPCC");
                    }
                    break;
                #endregion
                #region Pasar a pago

                case "OK1_FINAN_PASARPAGO":

                    oForm = sapApplication.Forms.ActiveForm;

                    if (!pVal.BeforeAction)
                    {
                        this.RegistrarAsiento(oForm);
                    }
                    break;

                #endregion
                #region 1284 Cancelar

                case "1284":
                    oForm = this.sapApplication.Forms.ActiveForm;
                    switch (oForm.TypeEx)
                    {
                        #region Pagos efectuados

                        case "426":
                            if (pVal.BeforeAction)
                            {
                                string docnum = ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString().Trim();
                                string seriedoc = ((SAPbouiCOM.ComboBox)oForm.Items.Item("87").Specific).Selected.Value.ToString().Trim();

                                AppDomain.CurrentDomain.SetData("parametroId", docnum);
                                AppDomain.CurrentDomain.SetData("SerieIdPagoFinan", seriedoc);

                                string strQuery = oConsulta.QryValidarDesemboloCredito(docnum, seriedoc);
                                oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                                if (Convert.ToInt64(oRsT.Fields.Item(2).Value.ToString()) == 0)
                                {
                                    if (Convert.ToInt64(oRsT.Fields.Item(0).Value.ToString()) > 0)
                                    {
                                        if (this.sapApplication.MessageBox("Tenga en cuenta que va ha  cancelar un pago efectuado asociado a un crédito, esto afectara la información del crédito,  desea continuar.", 2, "Aceptar", "Cancelar", "") == 2)
                                        {
                                            BubbleEvent = false;
                                        }
                                    }
                                }
                                else
                                {
                                    sapApplication.SetStatusBarMessage("No se puede cancelar el pago efectuado asociado al crédito (" + oRsT.Fields.Item(1).Value.ToString().Trim() + ") ya que se han realizado pago en una o varias cuotas.", BoMessageTime.bmt_Short, true);
                                    BubbleEvent = false;
                                }
                            }

                            if (!pVal.BeforeAction)
                            {
                                string strQuery = oConsulta.QryCambiarEstadoCancelacionDesembolsoCredito(AppDomain.CurrentDomain.GetData("parametroId").ToString(), AppDomain.CurrentDomain.GetData("SerieIdPagoFinan").ToString());
                                oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                                if (oRsT.RecordCount > 0)
                                {
                                    double dbValorPagoEfectuado = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRsT.Fields.Item(1).Value);
                                    strQuery = oConsulta.QryActualizarSaldoAcreedorPagoReEstandarResta(oRsT.Fields.Item(0).Value.ToString().Trim(), OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, ((-1) * dbValorPagoEfectuado)));
                                    oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                                }
                            }
                            break;
                        #endregion
                        #region Pagos recibidos Estandar
                        case "170":
                            if (pVal.BeforeAction)
                            {
                                string docnum = ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString().Trim();
                                string seriedoc = ((SAPbouiCOM.ComboBox)oForm.Items.Item("87").Specific).Selected.Value.ToString().Trim();
                                string query = "";

                                AppDomain.CurrentDomain.SetData("parametroId", docnum);
                                AppDomain.CurrentDomain.SetData("SerieIdPagoFinan", seriedoc);


                                SAPbobsCOM.Recordset oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                                query = OK1.Generic.Helpers.configParteConsulta(StrPath + @"AddInQueries\Queries_HANA.xml", "validarReciboCaja", "/TQueries/Queries/Query");
                                query = query.Replace("%pago%", docnum);
                                oRecordSet.DoQuery(query);

                                if (oRecordSet.RecordCount > 0)
                                {

                                    StringBuilder strTransacciones = new StringBuilder();
                                    if (oRecordSet.RecordCount > 0)
                                    {
                                        strTransacciones.AppendLine("No se permite realizar la cancelación del documento. El recibo de caja  " + docnum + " se encuentra vinculado a los siguientes documentos: ");
                                        while (!oRecordSet.EoF)
                                        {
                                            strTransacciones.AppendLine("Pago de addin financiación: " + oRecordSet.Fields.Item("DocNum").Value.ToString() + ", del crédito " + oRecordSet.Fields.Item("U_EntrCred").Value.ToString() + ". ");
                                            oRecordSet.MoveNext();
                                        }
                                    }

                                    sapApplication.MessageBox(strTransacciones.ToString());
                                    BubbleEvent = false;
                                }

                            }
                            break;

                            #endregion
                    }
