        /// <summary>Encuentra los valores de los pagos invalidos para retirarlos de los saldos del credito</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="DocEntryCredito">DocEntry del Credito</param>
        /// <param name="oFormCredito">Formulario del credito</param>
        /// <param name="oConsulta">Objeto de consultas</param>
        /// <param name="Ruta">Rutas recursos</param>
        public static void ValidacionPagosInvalidos(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string DocEntryCredito, SAPbouiCOM.Form oFormCredito, Consultas oConsulta, string Ruta)
        {
            SAPbobsCOM.GeneralService oGeneralService;
            SAPbobsCOM.GeneralData oGeneralData;
            SAPbobsCOM.GeneralDataCollection oChildren;
            double ValorTotalPagado;
            double ValorPendienteCapital;
            double ValorPendienteInteres;
            double ValorTotalPendiente;
            int Prenecesidad;

            try
            {

                ObtenerDatosCredito(sapCompany, DocEntryCredito, out oGeneralService, out oGeneralData, out oChildren,
                    out ValorTotalPagado, out ValorPendienteCapital, out ValorPendienteInteres,
                    out ValorTotalPendiente, out Prenecesidad, Ruta);

                for (int i = 0; i < oChildren.Count; i++)
                {
                    string TipoPago = oChildren.Item(i).GetProperty("U_tipoPago").ToString();
                    string CuotaPagada = oChildren.Item(i).GetProperty("U_Pagado").ToString();
                    int Parciales = int.Parse(oChildren.Item(i).GetProperty("U_PagosPar").ToString());

                    if (TipoPago.Equals("Pago Invalido") && CuotaPagada.Equals("Y") && Parciales == 0)
                    {
                        double ValorCuota = double.Parse(oChildren.Item(i).GetProperty("U_VlrPago").ToString());
                        double ValorCapitalCuota = double.Parse(oChildren.Item(i).GetProperty("U_Capital").ToString());
                        double ValorInteresCuota = double.Parse(oChildren.Item(i).GetProperty("U_Intereses").ToString());

                        ActualizarValoresPendientes(oGeneralData, oFormCredito, ref ValorPendienteCapital, ValorCapitalCuota, ref ValorPendienteInteres, ValorInteresCuota, ref ValorTotalPagado, ValorCuota, ref ValorTotalPendiente);
                    }
                    else if (Parciales > 0)
                    {
                        string NumeroCuota = oChildren.Item(i).GetProperty("U_NroCuot").ToString();
                        ProcesarPagosParciales(sapCompany, oConsulta, DocEntryCredito, NumeroCuota, ref ValorPendienteCapital, ref ValorPendienteInteres, ref ValorTotalPendiente, ref ValorTotalPagado, oGeneralData, oFormCredito, Ruta, sapApplication, Prenecesidad);
                    }
                }

                oGeneralService.Update(oGeneralData);
            }
            catch (Exception e)
            {
                string errorDetails = $"DocEntry: {DocEntryCredito}, Error: {e.Message}, Stack: {e.StackTrace}";
                OK1.SBO.Helpers.reportar_error("addInFinanciacion", "ValidacionPagosInvalidos", errorDetails.Substring(Math.Max(0, errorDetails.Length - 254)), sapCompany, true);
            }
        }

