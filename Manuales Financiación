        public void CrearTablaAmortizacion(SAPbouiCOM.Application sapApplication, string strEntrCred, string strNroPago)
        {
            SAPbobsCOM.Recordset oRec = null;
            DateTime dtFechaUltimaCuotaMora;
            string strQry = "";
            string strDato = "";
            int iTabla = 0;
            double dbVlrCuotaMensual = 0; //FRC 20160622 Variable para almacenar el nuevo valor de la cuota mensual
            int iNroC = 0; //FRC 20160622 Contador para obtener el valor de la cuota mensual
            try
            {
                strQry = this.oConsulta.QryTablaAmortizPagos(strNroPago.Trim());
                this.oConsulta.EjecutarConsulta(ref oRec, strQry);

                if (oRec.RecordCount > 0)
                {
                    CreditosFinanciacion oCredito = new CreditosFinanciacion(this.sapCompany, sapApplication, this.StrPath, this.strTipoServer); //FRC 20160915 Se agrega parametro Path
                    oCredito.GetByKey(strEntrCred);

                    oRec.MoveFirst();
                    iTabla = oCredito.iTabla + 1;
                    oCredito.LineasAmortizacion = new CreditosFinanciacionLineasAmortizacion[oRec.RecordCount];
                    for (int i = 0; i < oRec.RecordCount; i++)
                    {
                        oCredito.LineasAmortizacion[i] = new CreditosFinanciacionLineasAmortizacion();
                        oCredito.LineasAmortizacion[i].iTabla = iTabla;
                        oCredito.LineasAmortizacion[i].strTipoAmortizacion = oCredito.strTipoAmortizacion;
                        int tempocuota = int.Parse(oRec.Fields.Item("U_NroCuot").Value.ToString());
                        oCredito.LineasAmortizacion[i].iNroCuota = tempocuota;
                        oCredito.LineasAmortizacion[i].dbVlrCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlrCuota").Value.ToString());
                        oCredito.LineasAmortizacion[i].dbVlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_Capital").Value.ToString());
                        oCredito.LineasAmortizacion[i].dbVlrIntereses = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_Intereses").Value.ToString());
                        oCredito.LineasAmortizacion[i].dbVlrSaldo = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_SaldoCr").Value.ToString());
                        oCredito.LineasAmortizacion[i].dbVlrSeguros = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlrSeg").Value.ToString());
                        oCredito.LineasAmortizacion[i].dbVlrPago = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlrPago").Value.ToString());
                        strDato = OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(Convert.ToDateTime(oRec.Fields.Item("U_FechPPag").Value.ToString()), sapApplication);
                        dtFechaUltimaCuotaMora = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
                        oCredito.LineasAmortizacion[i].FechaProxPago = dtFechaUltimaCuotaMora;
                        oCredito.LineasAmortizacion[i].blFacturado = oRec.Fields.Item("U_Factura").Value.ToString().Equals("Y") ? true : false;

                        strDato = OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(Convert.ToDateTime(oRec.Fields.Item("U_FechaFra").Value.ToString()), sapApplication);
                        if (!strDato.Equals(""))
                            dtFechaUltimaCuotaMora = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
                        else
                            dtFechaUltimaCuotaMora = Convert.ToDateTime("1988/12/30");
                        oCredito.LineasAmortizacion[i].FechaFactura = dtFechaUltimaCuotaMora;
                        oCredito.LineasAmortizacion[i].strEntFactura = oRec.Fields.Item("U_EntrFact").Value.ToString();
                        oCredito.LineasAmortizacion[i].strNroFactura = oRec.Fields.Item("U_NroFact").Value.ToString();
                        oCredito.LineasAmortizacion[i].dbVlrFrado = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlrFrado").Value.ToString());

                        bool sipagado = false;

                        string stPagado = oRec.Fields.Item("U_Pagado").Value.ToString().Trim();


                        if (stPagado.Equals("Y"))
                        {
                            sipagado = true;
                        }
                        //FRC 20160622 Se valida el nuevo valor de la cuota xa almacenarlo en la variable
                        if (!sipagado && iNroC <= 1)
                        {
                            dbVlrCuotaMensual = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlrCuota").Value.ToString());
                            iNroC++;
                        }

                        oCredito.LineasAmortizacion[i].blPagado = sipagado;
                        oCredito.LineasAmortizacion[i].strEntPago = oRec.Fields.Item("U_EntrPago").Value.ToString();
                        oCredito.LineasAmortizacion[i].strNroPago = oRec.Fields.Item("U_NroPago").Value.ToString();
                        oCredito.LineasAmortizacion[i].dbVlrPagado = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRec.Fields.Item("U_VlPagado").Value.ToString());
                        oCredito.LineasAmortizacion[i].strNroPagoAddIn = ""; //FRC 20160621 Se agrega campo en blanco para insertar.

                        oRec.MoveNext();
                    }

                    oCredito.InsertarLineasAmortizacion();
                    oCredito.dbVlrTotalCuota = dbVlrCuotaMensual; //FRC 20160622 Se guarda en la clase el nuevo valor de la cuota
                    oCredito.UpdateTablaAmortizacion();
                    this.oConsulta.EjecutarConsulta(ref oRec, this.oConsulta.QryActualTablaAmortizPagos(strEntrCred, iTabla.ToString()));
                    //FRC 20160317 Se actualiza el estado del credito a Refinanciado
                    this.oConsulta.EjecutarConsulta(ref oRec, this.oConsulta.QryActualizarEstadoPagoAbonoCapitalCredito(strEntrCred));
                    //FRC 20160930 Copiar Tabla de Pagos Parciales
                    this.oConsulta.EjecutarConsulta(ref oRec, this.oConsulta.QryCopiarPagoParcial(strEntrCred, oCredito.iTabla.ToString()));
                    this.oConsulta.EjecutarConsulta(ref oRec, this.oConsulta.QryActualizarCantPagoParcial(strEntrCred, oCredito.iTabla.ToString()));
                }
            }
            catch (Exception e)
            {
                sapApplication.StatusBar.SetText("Excepción en FuncionesGenerales - CrearTablaAmortizacion " + e.Message, BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                OK1.SBO.Helpers.reportar_error(e, "FuncionesGenerales", "CrearTablaAmortizacion", this.sapCompany);
            }
        }

        /// <summary>
