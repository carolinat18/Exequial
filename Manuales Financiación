        public bool ExistenCuotasPagadasCreditoForFinanPagos(SAPbouiCOM.Form oForm, SAPbobsCOM.Company SapCompany, SAPbouiCOM.Application sapApplication, string DocEntryCredito, string strPath, ref string StrDocnumCuotas, bool Chk_TotalP, string tipopago)
        {
            SAPbouiCOM.Matrix omtx = null;
            SAPbobsCOM.Recordset orset = null;
            string query = string.Empty;
            int fila = 1;
            string numeroCuota = string.Empty;
            bool error = false;
            double ValorAplicado = 0;
            string strPagado = string.Empty;
            double saldoCuota = 0;
            bool salir = false;

            try
            {

                omtx = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_0").Specific;
                omtx.FlushToDataSource();
                while (fila <= omtx.RowCount && !salir)
                {
                    numeroCuota = ((SAPbouiCOM.EditText)omtx.Columns.Item("col_0").Cells.Item(fila).Specific).Value.ToString().Trim();
                    ValorAplicado = OK1.SBO.Helpers.DoubleFromDBDataSource(SapCompany, ((SAPbouiCOM.EditText)omtx.Columns.Item("col_9").Cells.Item(fila).Specific).Value);

                    #region valida contra cuota credito
                    if (!string.IsNullOrEmpty(DocEntryCredito) && !string.IsNullOrEmpty(numeroCuota))
                    {
                        orset = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                        query = OK1.Generic.Helpers.configParteConsulta(strPath + @"AddInQueries\Queries_HANA.xml", "retornarCuotasValidarCredito", "/TQueries/Queries/Query");
                        query = query.Replace("%DocEntryCredito%", DocEntryCredito);
                        query = query.Replace("%numeroCuota%", numeroCuota);
                        orset.DoQuery(query);

                        if (orset.RecordCount > 0)
                        {
                            try
                            {
                                strPagado = orset.Fields.Item("Pagado").Value.ToString();
                                if (strPagado.Equals("Y"))
                                {
                                    error = true;
                                    salir = true;
                                    StrDocnumCuotas = " la cuota Nro. " + numeroCuota + " ya se encuentra paga en el credito.";
                                }
                                else
                                {
                                    if (!Chk_TotalP)
                                    {
                                        if (tipopago.Equals("4"))
                                        {
                                            saldoCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(SapCompany, orset.Fields.Item("Saldo").Value);
                                            if (ValorAplicado > saldoCuota)
                                            {
                                                error = true;
                                                salir = true;
                                                StrDocnumCuotas = " la cuota Nro. " + numeroCuota + " tiene un saldo pendiente de $ " + saldoCuota + " el valor aplicado es $ " + ValorAplicado;
                                            }
                                        }
                                    }

                                }
                            }
                            catch (Exception e) { }
                        }
                    }
                    #endregion

                    fila++;
                }
