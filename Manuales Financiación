                    CuotaTemp = Capital + Interes;
                    Diferencia = Math.Round(CuotaMensual - CuotaTemp);

                    if (Diferencia != 0)
                        SumatoriaDiferencia += Diferencia;

                    TotalCapitalInteres = sumatoriaCapital + sumatoriaInteres;
                    DiferenciaSaldos = sumatoriaCuotas - TotalCapitalInteres;

                    if (DiferenciaSaldos != 0)
                    {
                        if (Capital == SaldoCredito)
                        {
                            Interes += DiferenciaSaldos;
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_2", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Capital));

                            valorCuota1 = Capital + Interes;
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, valorCuota1));
                        }
                        else
                        {
                            Capital = SaldoCredito;
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_1", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Capital));

                            Interes += DiferenciaSaldos;
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_2", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Interes));

                            valorCuota1 += Interes;
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, valorCuota1));
                        }
                    }

                    double descuento = 0;
                    descuento = retornarTotalDescuentoMatrixDescuentoInterfaz(oFormPreNecFina, this.oCmp);


                    double db_Dif1 = (db_VlrCapital - db_VlrCuotaInicial) - (sumatoriaCapital + descuento);

                    double diferenciaCapitalInteresVsCouta = Math.Round(Capital + Interes) - CuotaMensual;
                    if (db_Dif1 != 0)
                    {
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_1", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Capital + db_Dif1));
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Capital + db_Dif1 + Interes));
                    }

                }
                #endregion
                #endregion

                #endregion

                #endregion

            }
            finally
            {
                oFormPreNecFina.Freeze(false);
            }

            if (oFormPreNecFina.Mode == SAPbouiCOM.BoFormMode.fm_OK_MODE)
            {
                oFormPreNecFina.Mode = SAPbouiCOM.BoFormMode.fm_UPDATE_MODE;
            }

            oFormPreNecFina.Items.Item("tab_10").Click(SAPbouiCOM.BoCellClickType.ct_Regular);

            #endregion

        }

        ///<Autor>Luisa Franco</Autor>
