        public bool GenerarPago(int iBranch, int iSerieSucursal, Double Descuento, bool blPagoTotal = false)
        {
            SAPbobsCOM.Payments oPago = (SAPbobsCOM.Payments)this.oCmp.GetBusinessObject(BoObjectTypes.oIncomingPayments);
            bool blResultado = false;
            int iError;

            try
            {
                // Configuración básica del objeto de pago
                oPago.DocType = BoRcptTypes.rCustomer;
                oPago.CardCode = this.strCardCode;
                oPago.DocDate = oPago.VatDate = oPago.DueDate = this.dtFechaPago;
                oPago.TaxDate = DateTime.Now;
                oPago.JournalRemarks = "Pago Crédito";
                oPago.ProjectCode = this.stProyecto;

                // Configuración de la sucursal y serie
                oPago.BPLID = iBranch > 0 ? iBranch : 0;
                oPago.Series = iBranch > 0 ? iSerieSucursal : int.Parse(obtenerSerieUsuarioPago(oCmp.UserSignature) ?? "0");

                oPago.ControlAccount = CuentaPuenteParaPagos(oCmp);


                // Métodos de pago específicos
                if (this.dbVlrPagoEfectivo > 0)
                {
                    oPago.CashAccount = this.strCtaPagoEfectivo;
                    oPago.CashSum = dbVlrPagoEfectivo;
                }

                if (this.dbVlrPagoConsignacion > 0)
                {
                    oPago.TransferAccount = this.strCtaPagoConsignacion;
                    oPago.TransferSum = dbVlrPagoConsignacion;
                    oPago.TransferDate = this.dtFecConsignacion;
                    oPago.TransferReference = this.stRefConsi;
                }

                if (this.dbVlrPagoCheque > 0)
                {
                    oPago.Checks.CountryCode = "CO";
                    oPago.Checks.CheckSum = dbVlrPagoCheque;
                    oPago.Checks.BankCode = this.stIdBanco.Trim();
                    oPago.Checks.DueDate = DateTime.Now;
                    oPago.CheckAccount = this.stCuentaCheque.Trim();
                    oPago.Checks.CheckNumber = this.iNroCheque;
                }

                if (this.dbVlrPagoTarjeta > 0)
                {
                    oPago.CreditCards.CreditAcct = FuncionesGenerales.ObtenerCuentaTarjetaCredito(oCmp, oApp, this.strPath, this.strTarjeta);
                    oPago.CreditCards.CreditCard = this.strTarjeta;
                    oPago.CreditCards.CardValidUntil = this.dtFechaVencTarjeta;
                    oPago.CreditCards.CreditCardNumber = this.strNroTarjeta;
                    oPago.CreditCards.NumOfCreditPayments = this.strNroCuotasTarjeta;
                    oPago.CreditCards.CreditSum = this.dbVlrPagoTarjeta;
                    oPago.CreditCards.VoucherNum = string.IsNullOrEmpty(this.strNumAutorizacionTarjeta) ? "1" : this.strNumAutorizacionTarjeta;
                    oPago.CreditCards.PaymentMethodCode = this.strFormaPagoTarjeta;
                    oPago.CreditCards.OwnerIdNum = this.strNumIDTarjeta;
                }

                // Registrar descuento como gasto bancario si aplica
                if (Descuento > 0)
                {
                    oPago.BankChargeAmount = Descuento;

                }

                // Campos personalizados
                oPago.UserFields.Fields.Item("U_NroCred").Value = this.iNroCredito.ToString();
                oPago.UserFields.Fields.Item("U_EntryCredito").Value = this.strDocEntry ?? "";
                oPago.UserFields.Fields.Item("U_canal").Value = this.iNroCredito.ToString();
                oPago.UserFields.Fields.Item("U_PagoCuenta").Value = "Y";

                // Agregar el pago
                iError = oPago.Add();
                if (iError == 0)
                {
                    this.strDocEntryPago = Convert.ToInt32(this.oCmp.GetNewObjectKey());

                    SAPbobsCOM.Recordset oRecorset = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                    string strQry = new Consultas(this.oCmp, this.strPath, this.strTipoServer).QryDatosPago(this.strDocEntryPago.ToString());
                    oRecorset.DoQuery(strQry);

                    if (oRecorset.RecordCount > 0)
                    {
                        this.strNroPago = oRecorset.Fields.Item("DocNum").Value.ToString();
                    }

                    blResultado = true;
                }
                else
                {
                    string strError = this.oCmp.GetLastErrorDescription();
                    this.strError = iError == -4006
                        ? "El documento no pudo ser creado. Debe actualizar tanto la moneda de sistema como la moneda local del día de hoy en los tipos de cambio."
                        : $"El documento no pudo ser creado. {strError}";
                }
            }
            catch (Exception ex)
            {
                this.strError = $"Error al generar el pago: {ex.Message}";
            }

            return blResultado;
        }


