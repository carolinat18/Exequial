        /// <summary>
        /// Obtiene el Registro indicado en el parametro
        /// </summary>
        /// <param name="strDocEntry">DocEntry del registrto a cargar</param>
        public void GetByKey(string strDocEntry)
        {
            SAPbobsCOM.Recordset oRecordSet = ((SAPbobsCOM.Recordset)(this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset)));
            SAPbobsCOM.Recordset oRecordSetLin1 = ((SAPbobsCOM.Recordset)(this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset)));
            Consultas oConsulta = new Consultas(this.oCmp, this.strPath, this.strTipoServer);

            int iTabMax = 0;
            int numcuotaval = 0;
            string strQuery = string.Empty;
            try
            {
                strQuery = oConsulta.QryGetByKey(strDocEntry);
                oConsulta.EjecutarConsulta(ref oRecordSet, strQuery);

                this.blOk = false;

                if (oRecordSet.RecordCount > 0)
                {
                    oRecordSet.MoveFirst();
                    this.strDocEntry = oRecordSet.Fields.Item("DocEntry").Value.ToString();
                    this.iNroCredito = Convert.ToInt32(oRecordSet.Fields.Item("DocNum").Value.ToString());
                    this.strCardCode = oRecordSet.Fields.Item("U_CardCode").Value.ToString();
                    this.strCardName = oRecordSet.Fields.Item("U_CardName").Value.ToString();
                    this.dbVlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrCred").Value);
                    this.dbVlrCuotaInicial = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_CuotaIni").Value);
                    this.dbVlrSegVida = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrSegV").Value);
                    this.dbVlrSeguros = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrOtrSg").Value);
                    this.dbVlrCuotaMensual = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrCuota").Value) + this.dbVlrSegVida + this.dbVlrSeguros;
                    this.dbTIM = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_TIM").Value);
                    this.dbVlrInteres = (this.dbVlrCapital * this.dbVlrInteres) / 100;
                    try
                    {
                        numcuotaval = Convert.ToInt32(oRecordSet.Fields.Item("U_NoCuotasOr").Value.ToString());
                    }
                    catch
                    {
                        numcuotaval = 0;
                    }

                    if (numcuotaval == 0)
                    {
                        this.iNroCuotas = Convert.ToInt32(oRecordSet.Fields.Item("U_NroCuot").Value.ToString());
                    }
                    else
                    {
                        if (!oRecordSet.Fields.Item("U_NroCuot").Value.ToString().Equals(oRecordSet.Fields.Item("U_NoCuotasOr").Value.ToString()))
                        {
                            this.iNroCuotas = Convert.ToInt32(oRecordSet.Fields.Item("U_NroCuot").Value.ToString());
                        }
                        else
                        {
                            this.iNroCuotas = numcuotaval;
                        }
                    }

                    this.dbCapitalPendiente = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrCaPen").Value);
                    this.dbInteresPendiente = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRecordSet.Fields.Item("U_VlrInPen").Value);
                    this.iCuotasPendiente = Convert.ToInt32(oRecordSet.Fields.Item("U_NroCuPen").Value.ToString());
                    this.dtFechaPago = (DateTime)oRecordSet.Fields.Item("U_FecDesem").Value;
                    this.strTipoAmortizacion = oRecordSet.Fields.Item("U_TipAmort").Value.ToString();
                    this.stProyecto = oRecordSet.Fields.Item("U_Proyecto").Value.ToString();
                    this.iNroPrenecesidad = Convert.ToInt32(oRecordSet.Fields.Item("U_NoPrenec").Value.ToString());

                    if (oRecordSet.Fields.Item("Status").Value.Equals("O"))
                        this.blAbierto = true;
                    else
                        this.blAbierto = false;
                    this.stTipCre = oRecordSet.Fields.Item("U_TipCre").Value.ToString().Trim();

                    strQuery = oConsulta.QryUltimaTablaAmortizacion(strDocEntry);
                    oConsulta.EjecutarConsulta(ref oRecordSetLin1, strQuery);

                    if (oRecordSetLin1.RecordCount > 0)
