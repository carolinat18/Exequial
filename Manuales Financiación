        public static string cancelarCuotaCondonada(SAPbobsCOM.Company sapCompany, string credito, string cuota, SAPbouiCOM.Form Form, string path)
        {
            SAPbobsCOM.Recordset ors = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

            try
            {
                //Elimina comentarios y check de pago
                string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "CancelarCuotaCondonada", "/TQueries/Queries/Query");

                query = query.Replace("%DocEntry%", credito);

                query = query.Replace("%Cuota%", cuota);

                ors.DoQuery(query);

                //Obtiene valor total a pagar 
                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "TotalPagoPrenecesidad", "/TQueries/Queries/Query");

                query = query.Replace("%IdCred%", credito);

                ors.DoQuery(query);

                double VlrTotalPago = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item(0).Value);

                //Cambia Valor total a pagar 
                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarVlrTotalPagoPrenec", "/TQueries/Queries/Query");

                query = query.Replace("%IdCredito%", credito);

                query = query.Replace("%VlrTotalPago%", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, VlrTotalPago));

                ors.DoQuery(query);

                ((SAPbouiCOM.EditText)Form.Items.Item("Ed_VlrPag").Specific).Value = VlrTotalPago.ToString();

                //Obtiene valor capital-interes
                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "VlrPendienteCapInteCredito", "/TQueries/Queries/Query");

                query = query.Replace("%IdCredito%", credito);

                ors.DoQuery(query);

                double VlrPendiCap = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item(0).Value);

                double VlrPendiInt = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, ors.Fields.Item(1).Value);

