        /// <summary>Actualiza valor a pagar segun documento seleccionado</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="oFormCredito">Formulario del credito</param>
        /// <param name="StrPath">Ruta</param>
        /// <param name="LineMemo">Comentario linea de asiento</param>
        /// <param name="SocioNegocio">Socio de negocio asiento</param>
        public static void ValorDocumentoVinculado(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, SAPbouiCOM.Form oFormCredito, string StrPath, string SocioNegocio, string LineMemo)
        {
            SAPbobsCOM.Recordset oRecordset = null;

            oFormCredito.Freeze(true);

            try
            {
                sapApplication.StatusBar.SetText("Cargando valores.", BoMessageTime.bmt_Long, BoStatusBarMessageType.smt_Warning);

                string ComboTipoPago = ((SAPbouiCOM.ComboBox)oFormCredito.Items.Item("cb_TPago").Specific).Selected.Value.ToString().Trim();

                if (ComboTipoPago.Equals("7") || ComboTipoPago.Equals("8"))
                {

                    oRecordset = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    string Documento = oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString();

                    if (Documento.Length > 0)
                    {

                        SAPbouiCOM.ComboBox oComboDocumento = (SAPbouiCOM.ComboBox)oFormCredito.Items.Item("OKEddocVi").Specific;

                        double ValorDocumento = 0;

                        if (oComboDocumento.Selected.Value.Equals("RD"))
                        {
                            string query = OK1.Generic.Helpers.configParteConsulta(StrPath + @"AddInQueries\Queries_HANA.xml", "InformacionRegistroDiario", "/TQueries/Queries/Query");

                            query = query.Replace("%TransId%", Documento);

                            query = query.Replace("%SocioNegocio%", SocioNegocio);

                            query = query.Replace("%LineMemo%", LineMemo);

                            oRecordset.DoQuery(query);

                            string valorRD = FuncionesGenerales.DoubleToDBDataSource(sapCompany, oRecordset.Fields.Item("BalDueCred").Value, false, "$", 0, "HANA");

                            oFormCredito.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").SetValue("U_VlrRC", 0, valorRD);

