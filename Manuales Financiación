        public int RegistrarAsientoRetencion(ArrayList arrRetenciones, int iBranch)
        {
            int iResultado = 0;
            int iNroLinea = 0;
            SAPbobsCOM.JournalEntries oJE = null;
            DateTime dtFechaReg;
            double dbValorCapital = 0;
            double dbValorIntereses = 0;
            double dbValorIntMora = 0;
            double dbValorTotalRte = 0;
            string strSolicitante = "";
            string strDocEntryFra = "";
            try
            {
                FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);
                //FRC 20160218 El Calculo de la Retenciòn se hace sobre el interes pagado y no sobre el calculado
                //dbValorIntereses = this.dbVlrInteres;
                //dbValorIntMora = this.dbVlrIntMora;
                dbValorCapital = this.dbVlrPagoCapital;
                dbValorIntereses = this.dbVlrPagoIntCorr;
                dbValorIntMora = this.dbVlrPagoMora;
                //FRC

                strSolicitante = this.strCardCode;
                oJE = (SAPbobsCOM.JournalEntries)this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.oJournalEntries);
                dtFechaReg = this.dtFecFra;
                //iDocEntry = int.Parse(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString());
                oJE.ReferenceDate = dtFechaReg;
                oJE.DueDate = dtFechaReg;
                oJE.TaxDate = dtFechaReg;
                oJE.TransactionCode = "RECR";
                oJE.ProjectCode = this.stProyecto; //FRC 20160525 Se adiciona el proyecto al asiento
                //oJE.Reference = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_DocNum").Specific).Value.ToString();
                foreach (ArrayList arrRte in arrRetenciones)
                {
                    oJE.Lines.AccountCode = arrRte[2].ToString();
                    oJE.Lines.Debit = Math.Round((((dbValorCapital * Convert.ToDouble(arrRte[1])) / 100) + (dbValorIntereses * Convert.ToDouble(arrRte[1])) / 100) + ((dbValorIntMora * Convert.ToDouble(arrRte[1])) / 100), 0);
                    oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = strSolicitante;
                    oJE.Lines.UserFields.Fields.Item("U_BaseRet").Value = dbValorIntereses + dbValorIntMora;
                    oJE.Lines.UserFields.Fields.Item("U_CodRet").Value = arrRte[0].ToString();
                    oJE.Lines.ProjectCode = this.stProyecto; //FRC 20160525 Se adiciona el proyecto al asiento
                    oJE.Lines.BPLID = iBranch;
                    oJE.Lines.Add();
                    dbValorTotalRte += Math.Round((((dbValorCapital * Convert.ToDouble(arrRte[1])) / 100) + (dbValorIntereses * Convert.ToDouble(arrRte[1])) / 100) + ((dbValorIntMora * Convert.ToDouble(arrRte[1])) / 100), 0);
                    strDocEntryFra = arrRte[3].ToString();
                    iNroLinea++;
                }
                //Segunda linea del JE es la contrapartida que es la que esta conf en aquerencias
                oJE.Lines.ShortName = strSolicitante;
                oJE.Lines.AccountCode = oFG.ObtenerCuentasGenerales(oFG.GetStringValue(CreditosFinanciacion.ClaseCuenta.CreditoPorDesembolsar));
                oJE.Lines.Credit = Math.Round(dbValorTotalRte, 0);
                oJE.Lines.BPLID = iBranch;
                oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = "";
                //FRC 20160801 Se agregan info en campos de usuario para reporte en libros fiscales
                oJE.UserFields.Fields.Item("U_TipoDoc").Value = "OINV";
                oJE.UserFields.Fields.Item("U_SerieDoc").Value = oFG.ObtenerSerieFactura(strDocEntryFra);
                oJE.UserFields.Fields.Item("U_ClaveDoc").Value = strDocEntryFra;
                oJE.Memo = "Retención de Impuestos Nro " + oFG.DevolverItemEnTabla("OINV", "DocNum", "DocEntry", strDocEntryFra, this.oCmp) + "";
                int iErrorJE = oJE.Add();
                if (iErrorJE == 0)
                {
                    iResultado = Convert.ToInt32(this.oCmp.GetNewObjectKey());
                    this.iNroLineaAsiento = iNroLinea + 1; // Linea del asiento contable donde qdfa el SN
                }
                else
                {
                    iResultado = 0;
                    this.strError = "No se pudo crear el Asiento Contable. " + this.oCmp.GetLastErrorDescription();
                }
            }
            catch (Exception e)
            {
                iResultado = 0;
                this.strError = "No se pudo crear el Asiento Contable. " + e.Message;
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oJE);
            }
            return iResultado;
        }
