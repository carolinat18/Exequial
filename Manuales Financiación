                            }

                            db_saldotempo = db_Saldo - db_CuotM;
                            db_CuotM = db_CuotM + db_Dif;

                            if (bDescuentoAdicional)
                                db_IntMen = (Math.Round(db_VlrCuota) - Math.Round(db_CuotM) - Math.Round(db_VlrDescuentoAdicional));
                            else
                                db_IntMen = (Math.Round(db_VlrCuota) - Math.Round(db_CuotM));
                            if (db_IntMen < 0)
                            {
                                db_IntMen = 0;
                            }

                        }
                        #endregion


                        #endregion

                        #region saldo

                        if (bDescuentoAdicional)
                            db_Saldo = db_Saldo - db_CuotM - db_VlrDescuentoAdicional;
                        else
                            db_Saldo = db_Saldo - db_CuotM;

                        if (db_Saldo < 0)
                        {
                            db_Saldo = 0;
                        }
                        #endregion

                        oMtxS.AddRow(1, oMtxS.RowCount);
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_f", oMtxS.RowCount.ToString());
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_6", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, (i_Linea + 1).ToString()));

                        #region Pagos adicionales y descuentos adicionales
                        if (!bPagoAdicional && !bDescuentoAdicional)
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuota, 0, MidpointRounding.AwayFromZero)));
                        else
                            if (bPagoAdicional && bDescuentoAdicional)
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuota + db_VlrAdicional - db_VlrDescuentoAdicional, 0, MidpointRounding.AwayFromZero)));
                        else
                                if (bPagoAdicional)
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuota + db_VlrAdicional, 0, MidpointRounding.AwayFromZero)));
                        else
                                    if (bDescuentoAdicional)
                            oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuota - db_VlrDescuentoAdicional, 0, MidpointRounding.AwayFromZero)));

                        #endregion

                        #region OLD
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_1", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_CuotM, 0, MidpointRounding.AwayFromZero)));
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_2", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_IntMen, 0, MidpointRounding.AwayFromZero)));
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_3", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_Saldo, 0, MidpointRounding.AwayFromZero)));
                        oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_4", OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(oFG.ObtenerFechaCuota(dt_fecIni, i_Linea), this.oApp));
                    }

                    bPagoAdicional = false;
                    bDescuentoAdicional = false;

                    #endregion


                    #region ajuste por redondeo

                    double NroCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_6").Cells.Item(oMtxS.RowCount).Specific).Value);
                    if (NroCuota != 0)
                    {
                        #region valores 
                        CuotaMensual = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_0").Cells.Item(oMtxS.RowCount).Specific).Value);
                        Capital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_1").Cells.Item(oMtxS.RowCount).Specific).Value);
                        Interes = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_2").Cells.Item(oMtxS.RowCount).Specific).Value);
                        CuotaTemp = Capital + Interes;

                        Diferencia = Math.Round(CuotaMensual - CuotaTemp);
                        #endregion

                        #region cuotas diferentes de la ultima
                        {
                            if (Diferencia != 0)
                            {
                                SumatoriaDiferencia += Diferencia;
                                Capital += Diferencia;
                                oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_1", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Capital));
                            }
                        }
                        #endregion

                        #region ultima

                        #region sumatorias
                        sumatoriaCuotas += CuotaMensual;
                        sumatoriaInteres += Interes;
                        sumatoriaCapital += Capital;
                        #endregion

                        #region  SaldoCredito de la penultima cuota

                        if (NroCuota == i_NroCuotas - 1)
                        {
                            SaldoCredito = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_3").Cells.Item(i_Linea + 1).Specific).Value);
                        }
                        #endregion

                        #endregion
                    }

                    #endregion
                }

                #region Asignacion de saldo pendiente ultima cuota

                if (db_Saldo > 0)
                {
                    db_CuotM = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.GetCellSpecific("col_0", oMtxS.RowCount)).Value);
                    db_CuotM = db_CuotM + db_Saldo;
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_CuotM, 0, MidpointRounding.AwayFromZero)));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_3", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, "0"));
                }

                #region ultima cuota
                if (i_Linea + 1 == i_NroCuotas)
                {
                    Capital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_1").Cells.Item(oMtxS.RowCount).Specific).Value);
                    Interes = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, ((SAPbouiCOM.EditText)oMtxS.Columns.Item("col_2").Cells.Item(oMtxS.RowCount).Specific).Value);
