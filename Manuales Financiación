                    else
                        this.strError = "La Factura no pudo ser creada." + strError;
                }
            }
            else
            {
                blResultado = true;
                this.dbVlrCapital = this.dbVlrPagoCapital;
                this.dbVlrInteres = this.dbVlrPagoIntCorr;
            }
            return blResultado;
        }

