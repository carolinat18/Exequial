        public bool ActualizarFacturaCancelada(string strIdCred, string strEntryFact, int iBranch, SAPbouiCOM.Application sapApplication, bool bUpdateCredito = true)
        {
            Consultas oConsulta = new Consultas(sapCompany, this.StrPath, this.strTipoServer);
            SAPbobsCOM.Recordset oRsT = null;
            SAPbobsCOM.Recordset oRs = null;
            SAPbobsCOM.Recordset oRsPagPar = null;
            SAPbobsCOM.Documents oFact = null;
            string strSerieCanc = "";
            string strQuery = "";
            int intDocNumFact = 0;
            bool exito = false;

            try
            {
                #region tipo de factura
                string strTipoFact = DevolverItemEnTabla("@OK1_FINAN_PARAM", "U_TipFact", "U_TipCre", DevolverItemEnTabla("@OK1_FINAN_CRED_HEAD", "U_TipCre", "DocEntry", strIdCred, sapCompany), sapCompany);
                oFact = (SAPbobsCOM.Documents)sapCompany.GetBusinessObject(BoObjectTypes.oInvoices);
                switch (strTipoFact)
                {
                    case "F":
                        oFact.DocumentSubType = BoDocumentSubType.bod_None;
                        break;
                    case "B":
                        oFact.DocumentSubType = BoDocumentSubType.bod_Bill;
                        break;
                    default:
                        oFact.DocumentSubType = BoDocumentSubType.bod_None;
                        break;
                }
                #endregion

                oFact.GetByKey(int.Parse(strEntryFact));
                if (oFact.DocumentStatus == BoStatus.bost_Open)
                {
                    intDocNumFact = oFact.DocNum;

                    #region cancela documento si esta abierto

                    #region dias de cancelacion
                    int iMaxDiasCanc = int.Parse(DevolverItemEnTabla("OADM", "CnclMaxDay", "CompnyName", sapCompany.CompanyName, sapCompany));
                    TimeSpan otime = DateTime.Now - oFact.DocDate;
                    int DiasDif = otime.Days;
                    #endregion

                    if (DiasDif <= iMaxDiasCanc && !iMaxDiasCanc.Equals(0))
                    {
                        SAPbobsCOM.Documents oCancelDoc = oFact.CreateCancellationDocument();

                        #region serie y sucursal
                        if (iBranch >= 1)
                        {
                            strSerieCanc = DevolverItemEnTabla("@OK1_FINAN_PARAM_SUC", "U_SerieDocCanc", "U_codSucursal", iBranch.ToString(), sapCompany);
                            oCancelDoc.BPL_IDAssignedToInvoice = iBranch;
                            if (!strSerieCanc.Equals(""))
                                oCancelDoc.Series = int.Parse(strSerieCanc);
                        }
                        else
                        {
                            strSerieCanc = DevolverItemEnTabla("@OK1_FINAN_PARAM", "U_SerieDocCanc", "U_TipCre", DevolverItemEnTabla("@OK1_FINAN_CRED_HEAD", "U_TipCre", "DocEntry", strIdCred, sapCompany), sapCompany);

                            if (!strSerieCanc.Equals(""))
                                oCancelDoc.Series = int.Parse(strSerieCanc);
                        }
                        #endregion

                        #region fecha
                        oCancelDoc.DocDate = DateTime.Now;
                        #endregion



                        int err = oCancelDoc.Add();
                        if (err.Equals(0))
                        {

                            #region success
                            sapApplication.StatusBar.SetText("El documento No. " + strEntryFact + " fue cancelado correctamente.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Success);
                            exito = true;

                            string newDocEntry = this.sapCompany.GetNewObjectKey();

                            string newDocNum = "";

                            SAPbobsCOM.Documents oCancelDocInfo = (SAPbobsCOM.Documents)this.sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.oInvoices);

                            if (oCancelDocInfo.GetByKey(int.Parse(newDocEntry)))
                            {
                                newDocNum = oCancelDocInfo.DocNum.ToString();
                            }

                            ActualizarDatosBoletaCancelada(sapCompany, this.StrPath, newDocEntry, newDocNum, strEntryFact);

                            #region actualizacions del credito
                            sapApplication.StatusBar.SetText("Actualizando informacion importante del credito por favor espere...", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);
                            #region actualizar factura cuota
                            strQuery = oConsulta.QryActualizarCuotaFra(strEntryFact, strIdCred);
                            oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                            #endregion

                            #region actualizar lineas 1 con los documentos de pagos parciales despues de cancelar documento
                            //FRC 20161011 Si la cuota afectada tuvo pagos parciales
                            #region buscar cuotas pagos parciales
                            oConsulta.EjecutarConsulta(ref oRsPagPar, oConsulta.QryBuscarPagoParcialporFactura(strEntryFact, strIdCred));
                            #endregion

                            if (oRsPagPar.RecordCount > 0)
                            {
                                oRsPagPar.MoveFirst();
                                #region  recorrer pagos parciales
                                while (!oRsPagPar.EoF)
                                {
                                    string strNroTabla = oRsPagPar.Fields.Item(0).Value.ToString();
                                    string strNroCuota = oRsPagPar.Fields.Item(1).Value.ToString();
                                    string strDocEntryCred = oRsPagPar.Fields.Item(2).Value.ToString();
                                    string strLineId = oRsPagPar.Fields.Item(3).Value.ToString();

                                    #region mostrar pagos parciales y actualizarlos por cuota
                                    oConsulta.EjecutarConsulta(ref oRs, oConsulta.QryMostrarPagosParciales(strDocEntryCred, strNroTabla, strNroCuota));
                                    if (oRs.RecordCount > 0)
                                    {
                                        oRs.MoveLast();
                                        strLineId = oRs.Fields.Item(0).Value.ToString();

                                        #region actualizar Actualizar Cuota Factura Parcial
                                        oConsulta.NEW_ActualizarCuotaFraParcial(sapCompany, sapApplication, strDocEntryCred, strLineId, strNroTabla, strNroCuota);
                                        #endregion
                                    }
                                    #endregion
                                    oRsPagPar.MoveNext();
                                }
                                #endregion
                            }

                            #endregion

                            #region actualizar valor pago en el formulario del credito
                            strQuery = oConsulta.QryVlrTotalPagoPrenecesidad(strIdCred);
                            oConsulta.EjecutarConsulta(ref oRs, strQuery);
                            double dbVlrTotalPago = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRs.Fields.Item(0).Value);

                            strQuery = oConsulta.QryActualizarTotalPagoPrenec(OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrTotalPago), strIdCred);
                            oConsulta.EjecutarConsulta(ref oRs, strQuery);
                            #endregion

                            #region Valor pendiente de capital
                            strQuery = oConsulta.QryVlrPendienteCapInteCredito(strIdCred);
                            oConsulta.EjecutarConsulta(ref oRs, strQuery);

                            double dbVlrPendiCap = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRs.Fields.Item(0).Value);
                            double dbVlrPendiInt = OK1.SBO.Helpers.DoubleFromDBDataSource(this.sapCompany, oRs.Fields.Item(1).Value);

                            strQuery = oConsulta.QryActualizarVlrPendienteCapIntCredito(OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrPendiCap), OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrPendiInt), strIdCred);
                            oConsulta.EjecutarConsulta(ref oRs, strQuery);


                            #endregion

                            #region actualizar cuotas pendientes
                            if (!string.IsNullOrEmpty(strIdCred))
                                oConsulta.ActualizarCuotaPendientesDespuesCancelacionFactura(sapCompany, strIdCred);
                            #endregion

                            #region saldo cuota credito
                            try
                            {
                                actualizarSaldoCreditoCuotasSQL(sapCompany, strIdCred);
                            }
                            catch { }
                            #endregion


                            #region Cancelar Asiento excedente o defecto
                            try
                            {
                                cancelarAsientoExcesoDefecto(sapCompany, intDocNumFact);
                            }
                            catch { }
                            #endregion

                            sapApplication.StatusBar.SetText("actualizacion de  informacion importante del credito Finalizada.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Success);

                            #endregion

                            #endregion
                        }
                        else
                        {
                            #region Fail
                            exito = false;
                            string errorMsj = sapCompany.GetLastErrorDescription();
                            sapApplication.StatusBar.SetText("El documento Boleta No. " + strEntryFact + " no pudo ser cancelada. " + errorMsj + "", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                            #endregion
                        }

                        if (bUpdateCredito)
                            sapApplication.ActivateMenuItem("1304");
                    }
                    else
                        sapApplication.StatusBar.SetText("La cantidad máxima de días para cancelación de documento de marketing antes o después de la contabilización es de: " + iMaxDiasCanc + "", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                    #endregion
                }
                else
                    sapApplication.StatusBar.SetText("El documento No. " + strEntryFact + " no fue cancelado correctamente. El documento no se encuentra abierto.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

            }
            catch (Exception ex)
            {
                OK1.SBO.Helpers.reportar_error(ex, "FuncionesGenerales", "ActualizarFacturaCancelada", this.sapCompany);
            }
            return exito;
        }

