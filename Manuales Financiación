        public void FacturarSegurosPorCuota(ref SAPbobsCOM.Documents oFra, int iNroCuota, int iCantCuotas = 1, double dbVlrDispSeguro = 0)
        {
            SAPbobsCOM.CompanyService oCmpServ = null;
            SAPbobsCOM.GeneralService oGralServ = null;
            SAPbobsCOM.GeneralDataParams oGralDP = null;
            SAPbobsCOM.GeneralData oGralData = null;
            SAPbobsCOM.GeneralDataCollection oGralDC = null;
            string strTotSeg = string.Empty;
            string strCuotaSeg;
            double dbVlrSeg = 0;
            int iNroCuotasSeg = 0;
            int iCuotaIniSeg = 0;
            int iCuotaIniOr = iNroCuota;
            int iNroCuotasPago = 0;
            string stTipCre = string.Empty;
            bool blPrenec = false;
            string str_C0 = string.Empty;
            string str_C1 = string.Empty;
            string str_C2 = string.Empty;
            string str_C3 = string.Empty;

            try
            {
                this.blOk = false;
                FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

                #region Edgar Granada 2018/01/03
                if (this.iNroPrenecesidad != 0)
                {
                    oFG.ObtenerCCPrenecesidad(this.iNroPrenecesidad, ref str_C0, ref str_C1, ref str_C2, ref str_C3);
                    blPrenec = true;
                }
                #endregion


                oCmpServ = this.oCmp.GetCompanyService();
                oGralServ = (SAPbobsCOM.GeneralService)oCmpServ.GetGeneralService("OK1_FINAN_CRED");
                oGralDP = (SAPbobsCOM.GeneralDataParams)oGralServ.GetDataInterface(GeneralServiceDataInterfaces.gsGeneralDataParams);
                oGralDP.SetProperty("DocEntry", this.strDocEntry);
                oGralData = (SAPbobsCOM.GeneralData)oGralServ.GetByParams(oGralDP);
                oGralDC = (SAPbobsCOM.GeneralDataCollection)oGralData.Child("OK1_FINAN_CRED_LIN2");

                int iCont = 0;
                int iCont1 = 0;
                //dbSegVida = (this.dbValorSegVida / this.iNroCuotas);
                while (iCont < oGralDC.Count)
                {
                    iCuotaIniSeg = Convert.ToInt32(oGralDC.Item(iCont).GetProperty("U_CuotaIni").ToString());
                    iNroCuotasSeg = Convert.ToInt32(oGralDC.Item(iCont).GetProperty("U_NroCuot").ToString());

                    iCont1 = 0;

                    while (iCont1 < iCantCuotas)//if (iCantCuotas > 1)
                    {
                        if (iNroCuota >= iCuotaIniSeg && iNroCuota <= (iNroCuotasSeg + (iCuotaIniSeg - 1)))
                        {
                            if (oFG.SeguroPagoTotal(oGralDC.Item(iCont).GetProperty("U_CodeSeg").ToString()))
                            {
                                strTotSeg = oGralDC.Item(iCont).GetProperty("U_VlrSeg").ToString();
                                iNroCuotasPago = iNroCuota - (iCuotaIniSeg);
                                strCuotaSeg = oGralDC.Item(iCont).GetProperty("U_VlrCuota").ToString();
                                dbVlrSeg += (OK1.SBO.Helpers.DoubleFromEditText(strTotSeg) - (iNroCuotasPago * OK1.SBO.Helpers.DoubleFromEditText(strCuotaSeg)));
                                strTotSeg = dbVlrSeg.ToString();
                            }
                            else
                            {
                                dbVlrSeg = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oGralDC.Item(iCont).GetProperty("U_VlrCuota"));
                                //strTotSeg = oGralDC.Item(iCont).GetProperty("U_VlrCuota").ToString(); 
                            }
                        }
                        else
                        {
                            dbVlrSeg = 0;
                        }

                        iCont1++;
                        iNroCuota++;
                    }
                    //else
                    //{
                    //    strTotSeg = oGralDC.Item(iCont).GetProperty("U_VlrCuota").ToString();
                    //}
                    //FRC 20160311 Se valida que exista valor de seguro para crear el registro
                    if (dbVlrSeg > 0)
                    {
                        if (dbVlrDispSeguro > 0)
                        {
                            if (dbVlrDispSeguro < dbVlrSeg)
                                dbVlrSeg = dbVlrDispSeguro;
                        }
                        oFra.Lines.ItemDescription = oFG.SeguroNombre(oGralDC.Item(iCont).GetProperty("U_CodeSeg").ToString());
                        oFra.Lines.AccountCode = oFG.SeguroCuenta(oGralDC.Item(iCont).GetProperty("U_CodeSeg").ToString());
                        oFra.Lines.TaxCode = oFG.ObtenerCodigoIVA(this.stTipCre);
                        oFra.Lines.UnitPrice = dbVlrSeg;//OK1.SBO.Helpers.DoubleFromEditText(strTotSeg);
                        oFra.Lines.TaxLiable = BoYesNoEnum.tNO;
                        oFra.Lines.WTLiable = BoYesNoEnum.tNO;
                        oFra.Lines.ProjectCode = this.stProyecto;

                        #region Edgar Granada 2018/01/03
                        if (blPrenec)
                        {
                            if (!str_C0.Equals(""))
                            {
                                oFra.Lines.CostingCode = str_C0;
                            }

                            if (!str_C1.Equals(""))
                            {
                                oFra.Lines.CostingCode2 = str_C1;
                            }
                            if (!str_C2.Equals(""))
                            {
                                oFra.Lines.CostingCode3 = str_C2;
                            }
                            if (!str_C3.Equals(""))
                            {
                                oFra.Lines.CostingCode4 = str_C3;
                            }
                        }
                        #endregion

                        oFra.Lines.Add();
                    }
                    iNroCuota = iCuotaIniOr;

                    iCont++;
                }
                blOk = true;
            }
            catch (Exception ex)
            {
                this.blOk = false;
                this.strError = "Se presento Error al Calcular el valor de los Seguros por cuota: " + ex.Message;
                OK1.SBO.Helpers.reportar_error(ex, "addInFinanciacion", "FacturarSegurosPorCuota CreditosFinanciacion", this.oCmp);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oCmpServ);
                OK1.SBO.Helpers.LiberarCOM(oGralServ);
                OK1.SBO.Helpers.LiberarCOM(oGralDP);
                OK1.SBO.Helpers.LiberarCOM(oGralData);
                OK1.SBO.Helpers.LiberarCOM(oGralDC);
            }
        }

