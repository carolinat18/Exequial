        public bool CrearNotaCredito(SAPbobsCOM.Company OCompany, SAPbouiCOM.Application OApplication, string docEntryFac, ref string strDocEntryNotaCredito, ref string strDocNumNC)
        {
            #region Variables

            Documents notaCredito = null;
            Documents notaCredito1 = null;
            Documents oFactura = null;
            int exito = 0;
            bool creada = false;
            string idSerie = string.Empty;

            #endregion

            try
            {
                notaCredito = (Documents)OCompany.GetBusinessObject(BoObjectTypes.oCreditNotes);
                notaCredito1 = (Documents)OCompany.GetBusinessObject(BoObjectTypes.oCreditNotes);
                oFactura = (Documents)OCompany.GetBusinessObject(BoObjectTypes.oInvoices);
                oFactura.GetByKey(int.Parse(docEntryFac));

                #region cabecera
                #region  Serie Numeracion
                idSerie = DevolverItemEnTabla("@OK1_FINAN_PARAM", "U_SerieNCAnulFina", "Code", "01", OCompany);
                if (!idSerie.Equals(string.Empty))
                    notaCredito.Series = int.Parse(idSerie);
                else
                    OApplication.StatusBar.SetText("No hay serie de numeración para crear nota crédito. ", SAPbouiCOM.BoMessageTime.bmt_Short, SAPbouiCOM.BoStatusBarMessageType.smt_Error);
                #endregion

                notaCredito.BPL_IDAssignedToInvoice = oFactura.BPL_IDAssignedToInvoice;
                notaCredito.CardCode = oFactura.CardCode;
                //notaCredito.TaxDate = oFactura.TaxDate;
                //notaCredito.DocDate = oFactura.DocDate;
                notaCredito.TaxDate = DateTime.Now;
                notaCredito.DocDate = DateTime.Now;
                notaCredito.DocDueDate = DateTime.Now;
                notaCredito.DocType = oFactura.DocType;
                //notaCredito.UserFields.Fields.Item("U_TipoNota").Value = "A"; // ANULACION
                notaCredito.UserFields.Fields.Item("U_TipoNota").Value = "N"; // ANULACION no reportable
                notaCredito.Comments = "Basado en la Boleta_" + oFactura.DocNum + "[ " + docEntryFac + " ]";
                notaCredito.UserFields.Fields.Item("U_NroFinan").Value = oFactura.UserFields.Fields.Item("U_NroFinan").Value;// docnum credito
                notaCredito.UserFields.Fields.Item("U_FNroCuot").Value = oFactura.UserFields.Fields.Item("U_FNroCuot").Value; // nro de cuota
                OApplication.StatusBar.SetText("Generando notacredito de boleta. " + oFactura.DocNum + " [" + docEntryFac + " ] ", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);
                #endregion

                #region lineas
                for (int i = 0; i < oFactura.Lines.Count; i++)
                {
                    #region Detalle
                    oFactura.Lines.SetCurrentLine(i);

                    notaCredito.Lines.ItemDescription = oFactura.Lines.ItemDescription;
                    notaCredito.Lines.Quantity = oFactura.Lines.Quantity;
                    notaCredito.Lines.Price = oFactura.Lines.Price;
                    notaCredito.Lines.TaxCode = oFactura.Lines.TaxCode;
                    notaCredito.Lines.LineTotal = oFactura.Lines.LineTotal;
                    notaCredito.Lines.WarehouseCode = oFactura.Lines.WarehouseCode;
                    notaCredito.Lines.UseBaseUnits = oFactura.Lines.UseBaseUnits;
                    notaCredito.Lines.AccountCode = oFactura.Lines.AccountCode;

                    notaCredito.Lines.CostingCode = oFactura.Lines.CostingCode;
                    notaCredito.Lines.CostingCode2 = oFactura.Lines.CostingCode2;
                    notaCredito.Lines.CostingCode3 = oFactura.Lines.CostingCode3;
                    notaCredito.Lines.CostingCode4 = oFactura.Lines.CostingCode4;

                    notaCredito.Lines.BaseEntry = Convert.ToInt32(docEntryFac);
                    notaCredito.Lines.BaseLine = Convert.ToInt32(oFactura.Lines.LineNum);//numline; // line de la devolucion numero de la linea que correponde con linea en el documento
                    notaCredito.Lines.BaseType = 13; // basado en un documento tipo nota debito
                    notaCredito.Lines.Add();
                    #endregion
                }
                #endregion

                exito = notaCredito.Add();

                #region Agregar nota credito
                if (exito != 0)
                {
                    #region Error
                    OApplication.StatusBar.SetText(OCompany.GetLastErrorDescription(), SAPbouiCOM.BoMessageTime.bmt_Short, SAPbouiCOM.BoStatusBarMessageType.smt_Error);
                    OK1.SBO.Helpers.reportar_error("addInFinanciacion", "NotaCredito", "Error DI al crear la nota credito. " + OCompany.GetLastErrorCode() + ": " + OCompany.GetLastErrorDescription(), OCompany, false);
                    #endregion
                }
                else
                {
                    #region Success
                    creada = true;
                    strDocEntryNotaCredito = OCompany.GetNewObjectKey();
                    notaCredito1.GetByKey(int.Parse(strDocEntryNotaCredito));
                    strDocNumNC = notaCredito1.DocNum.ToString().Trim();
                    #endregion
                }
                #endregion

            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "CrearNotaCredito", OCompany);
                OApplication.StatusBar.SetText("Ocurrió una excepción al crear nota crédito. " + e.Message, SAPbouiCOM.BoMessageTime.bmt_Short, SAPbouiCOM.BoStatusBarMessageType.smt_Error);
            }
            finally
            {

            }
            return creada;
        }

