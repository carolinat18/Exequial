                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarVlrPendienteCapIntCredito", "/TQueries/Queries/Query");

                query = query.Replace("%IdCredito%", credito);

