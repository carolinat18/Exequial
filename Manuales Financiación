            string strCodSN = "";
            string strQuery = string.Empty;
            int iTabla = 0;
            int iCuotaIniTabla = 1; //FRC 20160607 Para obtner el nro de la fuota inicial de la tabla actual.
            bool blBand = true;
            SAPbobsCOM.Recordset oRs = null;
            DateTime dtFechaCuota;

            oComboEstado = (SAPbouiCOM.ComboBox)oForm.Items.Item("Ed_Estado").Specific;
            strDato = oComboEstado.Value.ToString();
            strEstado = oComboEstado.Value.ToString(); //FRC 20160302 Se almacena el estado
