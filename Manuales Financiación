            double db_VlrCapital;
            double db_VlrPagado;
            double db_VlrCuota = 0;
            double db_VlrAdicional = 0;
            double db_VlrPgAd = 0;
            double db_TIM = 0;
            double db_VlrIni = 0;
            int i_UltimaTabla;
            int i_UltimaCuotaPaga = 0;
            int i_Linea = 0;
            int i_NumCuotas;
            bool b_PagosExistentes = false;
            bool bPagoAdicional = false;
            DateTime dt_FechaPagoUltimaCuota = DateTime.Now;
            DateTime dt_FechaCuota = DateTime.Now;

            Consultas oConsulta = new Consultas(this.oCmp, this.strPath, this.strTipoServer);
            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            oRset = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(BoObjectTypes.BoRecordset);

            #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021

            string strNroCuota = "0";
            bool bDescuentoAdicional = false;
            double db_VlrDescAdicional = 0;
            double db_VlrDCad = 0;

            #endregion
            #endregion

            try
            {
                db_VlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_valorPrenec", 0));
                i_NumCuotas = int.Parse(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_nCuotas", 0));

                str_Sql = oConsulta.QryVlrPagadoCreditoPrenecesidad(this.strDocEntry);
                oRset.DoQuery(str_Sql);

                db_VlrPagado = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRset.Fields.Item(0).Value);

                if (db_VlrPagado == 0)
                {
                    db_VlrPagado = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oFormPreNecFina.DataSources.UserDataSources.Item("valorCI").Value);
                }
                else
                {
                    b_PagosExistentes = true;
                }

                str_Sql = oConsulta.QryUltimaTablaAmortizacion(this.strDocEntry);
                oRset.DoQuery(str_Sql);

                i_UltimaTabla = int.Parse(oRset.Fields.Item(0).Value.ToString().Trim());

                str_Sql = oConsulta.QryPrimeraCuotaSinPagoCredito(this.strDocEntry);//oConsulta.QryUltimaCuotaPagaCreditoPrenecesidad(this.strDocEntry);
                oRset.DoQuery(str_Sql);

                if (oRset.Fields.Item(0).Value.ToString().Trim().Equals(string.Empty))
                {
                    i_UltimaCuotaPaga = -1;
                }
                else
                {
                    i_UltimaCuotaPaga = int.Parse(oRset.Fields.Item(0).Value.ToString().Trim());
                }

                str_Sql = oConsulta.QryUltimaCuotaPagaCreditoPrenecesidad(this.strDocEntry);//oConsulta.QryFechaPagoProximaCuota(this.strDocEntry);
                oRset.DoQuery(str_Sql);

                dt_FechaPagoUltimaCuota = Convert.ToDateTime(oRset.Fields.Item(1).Value.ToString().Trim());

                if (i_UltimaCuotaPaga == 0)
                {
                    dt_FechaPagoUltimaCuota = OK1.SBO.Helpers.FechaFormateadaAsDateTime(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_fecIn", 0).Trim(), this.oApp);
                }


                this.dbVlrCapital = db_VlrCapital;
                this.dbVlrBaseSegVida = dbVlrCapital;
                this.dbVlrCuotaInicial = db_VlrPagado;
                this.dtFechaPago = dt_FechaPagoUltimaCuota;
                this.ICuotaInicialTabla = i_UltimaCuotaPaga;
                this.iTabla = i_UltimaTabla + 1;
                this.iNroCuotas = this.iNroCuotas - (i_UltimaCuotaPaga - 1);

                #region Calculo valor Cuota

                this.dbTIM = this.dbTIM / 100;

                db_VlrIni = this.dbVlrCapital - this.dbVlrCuotaInicial;

                #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021

                PagosAdicionalesCuotas oPAC = new PagosAdicionalesCuotas();

                i_Linea = 1;

                for (int i = 1; i <= this.iNroCuotas; i++)
                {
                    strNroCuota = Convert.ToString(i);
                    foreach (PagosAdicionalesCuotas item in listaPA)
                    {
                        oPAC = (PagosAdicionalesCuotas)item;

                        if (oPAC.str_CuotaMes.Equals(strNroCuota))
                        {
                            db_VlrAdicional = oPAC.db_VlrAdi;
                            bPagoAdicional = true;
                            break;
                        }
                    }

                    if (bPagoAdicional)
                    {
                        db_VlrPgAd += db_VlrAdicional / Math.Pow((1 + this.dbTIM), i_Linea);
                    }

                    bPagoAdicional = false;

                    i_Linea++;
                }

                #endregion


                #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021
                DescuentosAdicionalesCuotas oDAC = new DescuentosAdicionalesCuotas();

                i_Linea = 1;

                for (int i = 1; i <= this.iNroCuotas; i++)
                {
                    strNroCuota = Convert.ToString(i);
                    foreach (DescuentosAdicionalesCuotas item in listaDA)
                    {
                        oDAC = (DescuentosAdicionalesCuotas)item;

                        if (oDAC.str_Cuota.Equals(strNroCuota))
                        {
                            db_VlrDescAdicional = oDAC.db_VlrDes;
                            bDescuentoAdicional = true;
                            break;
                        }
                    }

                    if (bDescuentoAdicional)
                    {
                        db_VlrDCad += db_VlrDescAdicional / Math.Pow((1 + this.dbTIM), i_Linea);
                    }

                    bDescuentoAdicional = false;

                    i_Linea++;
                }
                #endregion

                db_VlrCuota = (db_VlrIni - db_VlrPgAd + db_VlrDCad) / ((1 - Math.Pow((1 + this.dbTIM), -(this.iNroCuotas))) / this.dbTIM);

                db_VlrCuota = Math.Truncate(db_VlrCuota);

                #endregion

                this.dbVlrCuotaMensual = Math.Truncate(db_VlrCuota);

                this.dbTIM = this.dbTIM * 100;

                this.CalcularCreditoPrenecesidad(db_VlrCuota, listaPA, listaDA);

                str_Sql = oConsulta.QryActualizarDatosCreditoPrenecesidad(OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, db_VlrCapital), OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, db_VlrPagado), this.strDocEntry);
                oRset.DoQuery(str_Sql);

                if (b_PagosExistentes)
                {
                    str_Sql = oConsulta.QryActualizarCuota0NewTablaSiPagoCreditoPrenecesidad(this.strDocEntry);
                    oRset.DoQuery(str_Sql);
                }
            }
            catch (Exception ex)
            {
                db_VlrCuota = 0;
                OK1.SBO.Helpers.reportar_error(ex, "AddInFinanciacion", "EX001", this.oCmp);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRset);
            }

            return Math.Truncate(db_VlrCuota);
        }


