            ((EditText)oForm.Items.Item("Ed_VlTCu").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, Math.Round(dbVlrTCuot + dbVlrSegVid + dbVlrOtrSeg));
