        public bool RegistrarAsientoPagoExcesoDefecto(CreditosFinanciacion oCredit, double valorDiferencia, int iBranch)
        {
            bool blResultado = true;
            string cc1 = "", cc2 = "", cc3 = "", cc4 = "", ctaPagoExceso = "", ctaPagoDefecto = "";
            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            oFG.ObtenerCCPrenecesidad(oCredit.iNroPrenecesidad, ref cc1, ref cc2, ref cc3, ref cc4);
            SAPbobsCOM.JournalEntries oJE = (JournalEntries)this.oCmp.GetBusinessObject(BoObjectTypes.oJournalEntries);
            oJE.Memo = "Ajuste Pago Exceso o Defecto - " + oCredit.strDocEntryFact.ToString() + "";
            oJE.DueDate = DateTime.Now;
            oJE.TaxDate = DateTime.Now;
            oJE.ReferenceDate = DateTime.Now;
            oJE.UserFields.Fields.Item("U_contra").Value = oCredit.iNroPrenecesidad.ToString();
            oJE.Reference = oFG.DevolverItemEnTabla("OINV", "DocNum", "DocEntry", oCredit.strDocEntryFact.ToString(), this.oCmp);
            oJE.ProjectCode = oCredit.stProyecto;

            if (valorDiferencia > 0)
            {
                oJE.Lines.AccountCode = oFG.ObtenerCuentasGenerales(oFG.GetStringValue(CreditosFinanciacion.ClaseCuenta.PagoExcesoDefecto));
                oJE.Lines.ShortName = oCredit.strCardCode;
                oJE.Lines.Debit = valorDiferencia;
            }
            else
            {
                oJE.Lines.AccountCode = oJE.Lines.AccountCode = oFG.ObtenerCuentasGenerales(oFG.GetStringValue(CreditosFinanciacion.ClaseCuenta.PagoExcesoDefecto));
                oJE.Lines.ShortName = oCredit.strCardCode;
                oJE.Lines.Credit = Math.Abs(valorDiferencia);
            }

            oJE.Lines.CostingCode = cc1;
            oJE.Lines.CostingCode2 = cc2;
            oJE.Lines.CostingCode3 = cc3;
            oJE.Lines.CostingCode4 = cc4;
            oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = oCredit.strCardCode;
            oJE.Lines.BPLID = iBranch;
            oJE.Lines.Add();

            CuentasPagoExcesoDefecto(this.oCmp, ref ctaPagoExceso, ref ctaPagoDefecto);

            if (valorDiferencia > 0)
            {
                oJE.Lines.AccountCode = ctaPagoExceso;
                oJE.Lines.Credit = valorDiferencia;
            }
            else
            {
                oJE.Lines.AccountCode = ctaPagoDefecto;
                oJE.Lines.Debit = Math.Abs(valorDiferencia);
            }

            oJE.Lines.CostingCode = cc1;
            oJE.Lines.CostingCode2 = cc2;
            oJE.Lines.CostingCode3 = cc3;
            oJE.Lines.CostingCode4 = cc4;
            oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = oCredit.strCardCode;
            oJE.Lines.BPLID = iBranch;
            oJE.Lines.Add();

            int iError = oJE.Add();

            if (iError != 0)
            {
                string strError = this.oCmp.GetLastErrorDescription().ToString();
                blResultado = false;
            }

            return blResultado;
        }

