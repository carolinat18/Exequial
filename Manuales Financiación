                if (DatosCargados && (ComboTipoPago.Selected.Value.Equals("7") || ComboTipoPago.Selected.Value.Equals("8")) && ComboDocumentoVinculado.Equals("RD"))
                {

                    oProgress = (SAPbouiCOM.ProgressBar)sapApplication.StatusBar.CreateProgressBar("Proceso de reconciliacion Iniciado.", 3, false);

                    oProgress.Value = 0;

                    oProgress.Text = "Procesando reconciliacion manual…";

                    sapApplication.ActivateMenuItem("9459");

                    SAPbouiCOM.Form oFormReconciliacionInternaSN = sapApplication.Forms.GetForm("120060803", 0);
                    oFormReconciliacionInternaSN.Visible = false;
                    oFormReconciliacionInternaSN.Freeze(true);

                    oFormReconciliacionInternaSN.Items.Item("120000005").Click(BoCellClickType.ct_Regular);

                    ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = true;

                    SAPbouiCOM.Matrix oMtxReconciliacionInternaSN = (SAPbouiCOM.Matrix)oFormReconciliacionInternaSN.Items.Item("10000085").Specific;

                    oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    oRecord = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ValidacionRegistroDiario", "/TQueries/Queries/Query");

                    string cambio = oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString();

                    if (cambio.Length < 1)
                    {
                        cambio = "00000";
                    }
                    query = query.Replace("%Number%", cambio);

                    oRecordSet.DoQuery(query);

                    if (oRecordSet.RecordCount > 0)
                    {

                        if (!SocioNegocioRD.Equals(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString()))
                        {
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInternaSN.Columns.Item("10000003").Cells.Item(1).Specific)).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInternaSN.Columns.Item("10000003").Cells.Item(2).Specific)).Value = SocioNegocioRD;

                        }
                        else
                        {
                            ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = false;
                            ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("120000008").Specific).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();
                        }
                    }
                    else
                    {
                        ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = false;
                        ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("120000008").Specific).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();

                    }

                    ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("1980000002").Specific).Value = OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(DateTime.Now, sapApplication);

                    oProgress.Value++;

                    oFormReconciliacionInternaSN.Items.Item("120000001").Click(BoCellClickType.ct_Regular);

                    SAPbouiCOM.Form oFormReconciliacionInterna = (SAPbouiCOM.Form)sapApplication.Forms.ActiveForm;
                    oFormReconciliacionInterna.Visible = false;
                    oFormReconciliacionInterna.Freeze(true);

                    SAPbouiCOM.Matrix oMtxReconciliacionInterna = (SAPbouiCOM.Matrix)oFormReconciliacionInterna.Items.Item("120000039").Specific;

                    SAPbouiCOM.Matrix oMtxCuotasPagas = (SAPbouiCOM.Matrix)oFormFinanPagos.Items.Item("mtx_0").Specific;

                    for (int i = oMtxCuotasPagas.RowCount; i >= 1; i--)
                    {
                        string DocEntryBoleta = ((SAPbouiCOM.EditText)(oMtxCuotasPagas.Columns.Item("col_11").Cells.Item(i).Specific)).Value.ToString();

                        query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerNumeroBoleta", "/TQueries/Queries/Query");

                        query = query.Replace("%DocEntry%", DocEntryBoleta);

                        oRecord.DoQuery(query);

                        string TransIdBoleta = oRecord.Fields.Item("TransId").Value.ToString();

                        for (int j = 1; j <= oMtxReconciliacionInterna.RowCount; j++)
                        {

                            string NumeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(j).Specific)).Value.ToString();

                            if (TransIdBoleta.Equals(NumeroOperacion))
                            {
                                oProgress.Value++;
                                ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(j).Specific)).Checked = true;
                                BoletasEncontradas = true;
                                j = oMtxReconciliacionInterna.RowCount + 1;

                            }

                        }

                    }

                    string TransIdAsiento = oRecordSet.Fields.Item("TransId").Value.ToString();

                    double ValorPagado = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value.ToString());

                    double ValorDocumento = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("ValorRC").Specific).Value.ToString());

                    for (int k = 1; k <= oMtxReconciliacionInterna.RowCount; k++)
                    {
                        string NumeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(k).Specific)).Value.ToString();

                        string ComentariosDocumento = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("1320000097").Cells.Item(k).Specific)).Value.ToString();

                        string ImporteReconciliar = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(k).Specific)).Value.ToString();

                        ImporteReconciliar = Regex.Replace(ImporteReconciliar, @"[$.,() ]", "");

                        if (ImporteReconciliar.Length >= 2)
                        {
                            ImporteReconciliar = ImporteReconciliar.Substring(0, ImporteReconciliar.Length - 2);
                        }

                        if (TransIdAsiento.Equals(NumeroOperacion) && ComentariosDocumento.Equals(LineMemo) && ImporteReconciliar.Equals(ValorDocumento.ToString()))
                        {
                            oProgress.Value++;
                            ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(k).Specific)).Checked = true;
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(k).Specific)).Value = ValorPagado.ToString();
                            DocumentoEncontrado = true;
                        }

                    }



                    if (DocumentoEncontrado && BoletasEncontradas)
                    {

                        oFormReconciliacionInterna.Items.Item("120000001").Click(BoCellClickType.ct_Regular);


                    }
                    else
                    {
                        sapApplication.StatusBar.SetText("No se encontraron documentos pendientes por reconciliar.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);


                    }
                    oFormReconciliacionInterna.Close();
                }

            }
            catch (Exception e)
            {

                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "ValidacionNumeroPagoAddin", sapCompany);
                sapApplication.StatusBar.SetText("Error durante el proceso de reconciliacion.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                sapApplication.MessageBox("Error durante el proceso de reconciliacion.", 1, "Aceptar", "", "");


            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
                OK1.SBO.Helpers.LiberarCOM(oRecord);
                if (oProgress != null)
                {
                    oProgress.Stop();
                    OK1.SBO.Helpers.LiberarCOM(oProgress);
                }

            }

        }

