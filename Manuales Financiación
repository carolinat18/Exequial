        public bool RetornarCuotasPagarFromMatrixFinanPagos(SAPbouiCOM.Form oForm, SAPbobsCOM.Company SapCompany, SAPbouiCOM.Application sapApplication, string DocEntryCredito, string strPath, ref string StrDocnumCuotas)
        {
            SAPbouiCOM.Matrix omtx = null;
            SAPbobsCOM.Recordset orset = null;
            string query = string.Empty;
            int fila = 1;
            string strCuotas = string.Empty;
            ArrayList CuotasMatrix = null;
            string numeroCuota = string.Empty;
            bool exito = false;
            int indice = 0;
            string cuotaStr = string.Empty;

            try
            {

                CuotasMatrix = new ArrayList();
                omtx = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_0").Specific;
                omtx.FlushToDataSource();
                while (fila <= omtx.RowCount)
                {
                    numeroCuota = ((SAPbouiCOM.EditText)omtx.Columns.Item("col_0").Cells.Item(fila).Specific).Value.ToString().Trim();
                    if (!CuotasMatrix.Contains(numeroCuota))
                        CuotasMatrix.Add(numeroCuota);
                    fila++;
                }

                if (CuotasMatrix.Count == 1)
                {
                    cuotaStr = "'" + CuotasMatrix[0].ToString() + "'";
                    strCuotas = cuotaStr;
                }
                else
                {
                    while (indice < CuotasMatrix.Count)
                    {
                        if (indice == CuotasMatrix.Count - 1)
                        {
                            cuotaStr = "'" + CuotasMatrix[indice] + "'";
                            strCuotas = strCuotas + cuotaStr;
                        }
                        else
                        {
                            cuotaStr = "'" + CuotasMatrix[indice] + "'";
                            strCuotas = strCuotas + cuotaStr + ",";
                        }
                        indice++;
                    }
                }

                if (!string.IsNullOrEmpty(DocEntryCredito) && !string.IsNullOrEmpty(strCuotas))
                {
                    orset = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                    query = OK1.Generic.Helpers.configParteConsulta(strPath + @"AddInQueries\Queries_HANA.xml", "RetornarCuotasPagarFromMatrixFinanPagos", "/TQueries/Queries/Query");
                    query = query.Replace("%DocEntryCredito%", DocEntryCredito);
                    query = query.Replace("%Cuotas%", strCuotas);
                    orset.DoQuery(query);

                    if (orset.RecordCount > 0)
                    {
                        try
                        {
                            while (!orset.EoF)
                            {
                                StrDocnumCuotas += orset.Fields.Item("Nro Boleta").Value.ToString() + " ";
                                orset.MoveNext();
                            }
                            exito = true;
                        }
                        catch (Exception e) { }
                        finally
                        {
                            //oFormBuscar.Freeze(true); 
                        }

                    }
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "RetornarCuotasPagarFromMatrixFinanPagos", SapCompany);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(orset);
            }
            return exito;
        }

