            SAPbobsCOM.Recordset oRecCurrencyDecimals = null;
            string tipoServer = string.Empty;
            tipoServer = server;
            string sql = string.Empty;

            try
            {
                #region CultureInfo
                CultureInfo confSBOI = new CultureInfo("es-CO", false);
                CultureInfo confDB = new CultureInfo("es-CO", false);

                SAPbobsCOM.CompanyService oCompanyService;
                SAPbobsCOM.AdminInfo oAdminInfo;
                int DecimalesVis = 0;
                try
                {
                    oCompanyService = (SAPbobsCOM.CompanyService)SBO_Company.GetCompanyService();
                    oAdminInfo = oCompanyService.GetAdminInfo();
                    DecimalesVis = oAdminInfo.PriceAccuracy;

                    confSBOI.NumberFormat.NumberDecimalSeparator = oAdminInfo.DecimalSeparator;
                    confSBOI.NumberFormat.NumberGroupSeparator = oAdminInfo.ThousandsSeparator;

                    confDB.NumberFormat.NumberDecimalSeparator = ".";
                    confDB.NumberFormat.NumberGroupSeparator = ",";
                }
                catch (Exception e)
                { throw e; }
                //return dValor;
                #endregion
                #region Numero de Decimales de la moneda o poner decimales de la visualizacion
                try
                {
                    if (truncate == true && Currency.Trim() != "")
                    {
                        oRecCurrencyDecimals = (SAPbobsCOM.Recordset)SBO_Company.GetBusinessObject(BoObjectTypes.BoRecordset);

                        if (tipoServer.Equals("HANA"))
                        {
                            sql = "SELECT \"Decimals\" FROM OCRN WHERE \"CurrCode\" = '" + Currency + "'";
                        }
                        else
                        {
                            sql = "SELECT Decimals FROM OCRN Where CurrCode='" + Currency + "'";
                        }
                        oRecCurrencyDecimals.DoQuery(sql);
                        Decimales = int.Parse(oRecCurrencyDecimals.Fields.Item(0).Value.ToString());
                    }
                    // Cuando el numero de decimales es el valor de la propuesta debo utilizar los decimales de visualizacion
                    if (Decimales == -1)
                        Decimales = DecimalesVis;
                }
                catch (Exception e)
                {
                    throw e;
                    Decimales = 0;
                }
                #endregion
                try
                {
                    //Traigo el valor con referencia a .
                    double stepper = Convert.ToDouble(oDBDataSource, confDB);
                    //lo redondeo al numero de decimales
                    stepper = Math.Round(stepper, Decimales);
                    //lo entrego con base en el .
                    strValor = Convert.ToString(stepper, confDB);
                }
                catch (Exception e)
                { throw e; }
            }
            catch (Exception e)
            { throw e; }
            finally
            {
                try
                {
                    OK1.SBO.Helpers.LiberarCOM(oRecCurrencyDecimals);
                }
                catch
                {

                }
            }
            return strValor;
        }

