                        }
                    }
                    else
                        iTabla++;
                    //}
                    //FRC
                }
                else
                {
                    iTabla = 1;
                    oFG.EliminarTabla(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString(), iTabla);
                }
            }
            oComboEstado = (SAPbouiCOM.ComboBox)oForm.Items.Item("Ed_Estado").Specific;
