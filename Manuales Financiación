                            oCRED.LineasAmortizacion[i].dbVlrCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrCuota").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_Capital").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrIntereses = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_Intereses").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrSaldo = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_SaldoCr").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrSeguros = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrSeg").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrPago = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrPago").Value.ToString());
                            oCRED.LineasAmortizacion[i].FechaProxPago = Convert.ToDateTime(oRs.Fields.Item("U_FechPPag").Value.ToString());
                            oCRED.LineasAmortizacion[i].blFacturado = oRs.Fields.Item("U_Factura").Value.ToString().Equals("Y") ? true : false;

                            strDato = oRs.Fields.Item("U_FechaFra").Value.ToString();
                            if (!strDato.Equals(""))
                                dtFechaCuota = Convert.ToDateTime(strDato);
                            else
                                dtFechaCuota = Convert.ToDateTime("1988/12/30");
                            oCRED.LineasAmortizacion[i].FechaFactura = dtFechaCuota;
                            oCRED.LineasAmortizacion[i].strEntFactura = oRs.Fields.Item("U_EntrFact").Value.ToString();
                            oCRED.LineasAmortizacion[i].strNroFactura = oRs.Fields.Item("U_NroFact").Value.ToString();
                            oCRED.LineasAmortizacion[i].dbVlrFrado = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrFrado").Value.ToString());

                            bool sipagado = false;

                            string stPagado = oRs.Fields.Item("U_Pagado").Value.ToString().Trim();


                            if (stPagado.Equals("Y"))
                            {
                                sipagado = true;
                            }


                            oCRED.LineasAmortizacion[i].blPagado = sipagado;
                            oCRED.LineasAmortizacion[i].strEntPago = oRs.Fields.Item("U_EntrPago").Value.ToString();
                            oCRED.LineasAmortizacion[i].strNroPago = oRs.Fields.Item("U_NroPago").Value.ToString();
                            oCRED.LineasAmortizacion[i].dbVlrPagado = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlPagado").Value.ToString());
                            oCRED.LineasAmortizacion[i].strNroPagoAddIn = oRs.Fields.Item("U_NroPagoAddin").Value.ToString();
                            i++;
                            oRs.MoveNext();
                        }
                        oCRED.InsertarLineasAmortizacion();
                        //FRC 20160930 Copiar Tabla de Pagos Parciales
                        oConsulta.EjecutarConsulta(ref oRs, oConsulta.QryCopiarPagoParcial(oCRED.strDocEntry, (iTabla - 1).ToString()));
                        oConsulta.EjecutarConsulta(ref oRs, oConsulta.QryActualizarCantPagoParcial(oCRED.strDocEntry, iTabla.ToString()));

                    }

                }
                //FRC Fin

                oCRED.CalcularCredito();
                sapApplication.StatusBar.SetText("Cálculo de Crédito Finalizado.", BoMessageTime.bmt_Medium, BoStatusBarMessageType.smt_Success);

                //if (oComboEstado.Selected.Value.Equals("01"))
