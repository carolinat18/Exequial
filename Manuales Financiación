                }

                oGralServ.Update(oGralData);
                if (dbVlrExcedente > 0)
                {
                    blBand = true;
                    for (int i = iNCuotas; i > 0 && blBand; i--)
                    {
                        dbValor = oFG.ObtenerVlrCapitalCuota(this.strDocEntry, iTabla, i);
