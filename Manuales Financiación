        /// <summary>Asigna datos de pago a linea de cuota pagada </summary>
        /// <param name="sapCompany"> Compañia SAP </param>
        /// <param name="credito">DocEntry credito</param>
        /// <param name="clave">DocEntry pago </param>
        /// <param name="numero">Numero pago</param>
        /// <param name="addin">Numero Addin</param>
        /// <param name="posicion">Posicion cuota a modificar </param>
        /// <param name="path">Ruta</param>
        /// <param name="TipoPago">Tipo de pago creado</param>
        /// <param name="PagoTotal">True si el pago original proviene de un pago total tipo 8</param>
        /// <returns>Ok --> correcto</returns>
        public static string datosPagoVinculadoCreditoRD(string path, SAPbobsCOM.Company sapCompany, string credito, string clave, string numero, string addin, int posicion, string TipoPago, bool PagoTotal)
        {
            SAPbobsCOM.GeneralService oGeneralService = null;

            SAPbobsCOM.GeneralData oGeneralData = null;

            SAPbobsCOM.GeneralDataCollection oChildren = null;

            SAPbobsCOM.CompanyService oCmpSrv = null;

            SAPbobsCOM.GeneralDataParams oGeneralParams = null;

            try
            {
                oCmpSrv = sapCompany.GetCompanyService();

                oGeneralService = oCmpSrv.GetGeneralService("OK1_FINAN_CRED");

                oGeneralParams = oGeneralService.GetDataInterface(SAPbobsCOM.GeneralServiceDataInterfaces.gsGeneralDataParams);

                oGeneralParams.SetProperty("DocEntry", credito);

                oGeneralData = oGeneralService.GetByParams(oGeneralParams);

                oChildren = oGeneralData.Child("OK1_FINAN_CRED_LIN1");

                int contador = 0;

                for (int i = 0; i < oChildren.Count; i++)
                {

                    int validacion = oChildren.Item(i).GetProperty("U_NroPagoAddin");
                    if (validacion.ToString().Equals(addin))
                    {
                        contador++;
                        if (contador == posicion)
                        {
                            oChildren.Item(i).SetProperty("U_TransId", clave);
                            oChildren.Item(i).SetProperty("U_NroPago", numero);
                            oChildren.Item(i).SetProperty("U_EntrPago", "");

                            if (oChildren.Item(i).GetProperty("U_VlPendCa") == 0)
                            {
                                oChildren.Item(i).SetProperty("U_Pagado", "Y");
                                if (oChildren.Item(i).GetProperty("U_PagosPar") > 0)
                                {
                                    oChildren.Item(i).SetProperty("U_PagosPar", (oChildren.Item(i).GetProperty("U_PagosPar") + 1).ToString());
                                    oGeneralService.Update(oGeneralData);
                                    pagosParcialesLineas8RD(path, sapCompany, credito, oChildren.Item(i).GetProperty("DocEntry").ToString(), oChildren.Item(i).GetProperty("U_NroCuot").ToString());

                                }
                                else
                                {
                                    oChildren.Item(i).SetProperty("U_PagosPar", "0");
                                    oGeneralService.Update(oGeneralData);
                                }



                            }
                            else
                            {
                                oChildren.Item(i).SetProperty("U_Pagado", "N");
                                oChildren.Item(i).SetProperty("U_PagosPar", (oChildren.Item(i).GetProperty("U_PagosPar") + 1).ToString());
                                oGeneralService.Update(oGeneralData);
                                pagosParcialesLineas8RD(path, sapCompany, credito, oChildren.Item(i).GetProperty("DocEntry").ToString(), oChildren.Item(i).GetProperty("U_NroCuot").ToString());

                            }

                            if (TipoPago.Equals("8") || (TipoPago.Equals("7") && PagoTotal))
                            {
                                contador = posicion - 1;
                            }

                        }

                    }


                }



                return "OK";

            }
            catch (Exception e)
            {

                OK1.SBO.Helpers.reportar_error("addInFinanciacion", "ERROR2022", e.ToString().Substring(e.ToString().Length - 254), sapCompany, true);

                return "ERROR :" + e.ToString();


            }


        }

