                                    #region Ultimo (datos pago)
                                    strLineId = oRsT.Fields.Item(0).Value.ToString();

                                    #region 2.2.1 actualiza datos del pago en lineas 1 (limpia docentrys pero actualiza valores pendiente)
                                    oConsulta.NEW_ActualizarCuotaPagoParcial(sapCompany, strDocEntry, strLineId, strNroTabla, strNroCuota);
                                    #endregion

                                    #endregion

                                    #region 2.2.2 consulta pagos parciales por cuota de nuevo
                                    oConsulta.EjecutarConsulta(ref oRsT, oConsulta.QryMostrarPagosParciales(strDocEntry, strNroTabla, strNroCuota));
