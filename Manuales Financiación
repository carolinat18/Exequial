            db_TIM = db_TIM / 100;
            i_NroCuotas = Convert.ToInt32(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_nCuotas", 0));
            dt_fecIni = OK1.SBO.Helpers.FechaFormateadaAsDateTime(oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_HEAD").GetValue("U_fecIn", 0).Trim(), this.oApp);
            db_VlrIni = db_VlrCapital - db_VlrCuotaInicial;
            #endregion

            #region inicializar matrix simulacion
            oMtxS = (SAPbouiCOM.Matrix)oFormPreNecFina.Items.Item("mtx_7").Specific;
            oDBDataS = (SAPbouiCOM.DBDataSource)oFormPreNecFina.DataSources.DBDataSources.Item("@OK1_EXE_PRFIN_AMORT");
            #endregion

            #region actualizar matriz de simulacion
            oFormPreNecFina.Freeze(true);

            try
            {

                #region cargar matrix de simulacion
                oMtxS.Clear();
                oDBDataS.Clear();

                #region CUOTA INICIAL
                if (db_VlrCuotaInicial != 0)
                {
                    oMtxS.AddRow(1, oMtxS.RowCount);
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_f", oMtxS.RowCount.ToString());
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_6", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, "0"));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_0", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuotaInicial, 0)));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_1", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrCuotaInicial, 0)));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_2", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, "0"));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_3", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.oCmp, Math.Round(db_VlrIni, 0)));
                    oMtxS.SetCellWithoutValidation(oMtxS.RowCount, "col_4", fechaPagoCuota0);
                }
                #endregion

                db_Saldo = db_VlrIni;

                #region Calculo valor Cuota

                #region Tasa de interes diferente de cero (0)

                if (db_TIM != 0)
                {


                    for (int i = 0; i < i_NroCuotas; i++)
                    {
                        i_Linea = i;

                        #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (PagosAdicionalesCuotas item in PgAdicionales)
                        {
                            oPAC = (PagosAdicionalesCuotas)item;

                            if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                            {
                                db_VlrAdicional = oPAC.db_VlrAdi;
                                bPagoAdicional = true;
                                break;
                            }
                        }

                        if (bPagoAdicional)
                        {
                            db_VlrPgAd += db_VlrAdicional / Math.Pow((1 + db_TIM), i_Linea);
                        }

                        bPagoAdicional = false;
                        #endregion

                        #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (DescuentosAdicionalesCuotas item in DcAdicionales)
                        {
                            oDAC = (DescuentosAdicionalesCuotas)item;

                            if (oDAC.str_Cuota.Equals(str_NroCuota))
                            {
                                db_VlrDescuentoAdicional = oDAC.db_VlrDes;
                                bDescuentoAdicional = true;
                                break;
                            }
                        }

                        if (bDescuentoAdicional)
                        {
                            db_VlrDcAd += db_VlrDescuentoAdicional / Math.Pow((1 + db_TIM), i_Linea);
                        }

                        bDescuentoAdicional = false;
                        #endregion
                    }

                    db_VlrCuota = (db_VlrIni - db_VlrPgAd) / ((1 - Math.Pow((1 + db_TIM), -i_NroCuotas)) / db_TIM);

                }

                #endregion

                #region Tasa de interes Cero (0)

                if (db_TIM == 0)
                {


                    for (int i = 0; i < i_NroCuotas; i++)
                    {
                        i_Linea = i;

                        #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (PagosAdicionalesCuotas item in PgAdicionales)
                        {
                            oPAC = (PagosAdicionalesCuotas)item;

                            if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                            {
                                db_VlrAdicional = oPAC.db_VlrAdi;
                                bPagoAdicional = true;
                                break;
                            }
                        }

                        if (bPagoAdicional)
                        {
                            db_VlrPgAd += db_VlrAdicional;
                        }

                        bPagoAdicional = false;
                        #endregion

                        #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (DescuentosAdicionalesCuotas item in DcAdicionales)
                        {
                            oDAC = (DescuentosAdicionalesCuotas)item;

                            if (oDAC.str_Cuota.Equals(str_NroCuota))
                            {
                                db_VlrDescuentoAdicional = oDAC.db_VlrDes;
                                bDescuentoAdicional = true;
                                break;
                            }
                        }

                        if (bDescuentoAdicional)
                        {
                            db_VlrDcAd += db_VlrDescuentoAdicional / Math.Pow((1 + db_TIM), i_Linea);
                        }

                        bDescuentoAdicional = false;
                        #endregion
                    }

                    db_VlrCuota = (db_VlrIni - db_VlrPgAd) / i_NroCuotas;

                }

                #endregion

                #endregion

                bPagoAdicional = false;
                bDescuentoAdicional = false;

                #region Calculo de tabla de amortizacion

                for (int i1 = 0; i1 < i_NroCuotas; i1++)
                {

                    if (db_Saldo > 0)
                    {
                        i_Linea = i1;

                        #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (PagosAdicionalesCuotas item in PgAdicionales)
                        {
                            oPAC = (PagosAdicionalesCuotas)item;

                            if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                            {
                                db_VlrAdicional = oPAC.db_VlrAdi;
                                bPagoAdicional = true;
                                break;
                            }
                        }

                        #endregion

                        #region OBTENER DESCUENTOS ADICIONALES CAB 22-01-2021

                        str_NroCuota = Convert.ToString(i_Linea + 1);

                        foreach (DescuentosAdicionalesCuotas item in DcAdicionales)
                        {
                            oDAC = (DescuentosAdicionalesCuotas)item;

                            if (oDAC.str_Cuota.Equals(str_NroCuota))
                            {
                                db_VlrDescuentoAdicional = oDAC.db_VlrDes;
                                bDescuentoAdicional = true;
                                break;
                            }
                        }

                        if (bDescuentoAdicional)
                        {
                            db_VlrDcAd += db_VlrDescuentoAdicional / Math.Pow((1 + db_TIM), i_Linea);
                        }

                        // bDescuentoAdicional = false;
                        #endregion

                        if (bDescuentoAdicional)
                            db_IntMen = (db_Saldo - db_VlrDescuentoAdicional) * db_TIM;
                        else
                            db_IntMen = db_Saldo * db_TIM;
                        db_TotInt += db_IntMen;
                        db_TotIntR += db_IntMen;

                        #region Pagos adicionales y descuentos adicionales
                        if (!bPagoAdicional && !bDescuentoAdicional)
                        {
                            db_CuotM = db_VlrCuota - db_IntMen;
                        }
                        else
                            if (bPagoAdicional && bDescuentoAdicional)
                        {
                            db_CuotM = db_VlrCuota - db_IntMen + db_VlrAdicional - db_VlrDescuentoAdicional;
                        }
                        else
                                if (bPagoAdicional)
                        {
                            db_CuotM = db_VlrCuota - db_IntMen + db_VlrAdicional;
                        }
                        else
                                    if (bDescuentoAdicional)
                            db_CuotM = db_VlrCuota - db_IntMen - db_VlrDescuentoAdicional;
                        #endregion


                        #region  db_CuotM  db_IntMen
                        if (bDescuentoAdicional)
                            db_TotCuot += Math.Round(db_CuotM) + db_VlrDescuentoAdicional;
                        else
                            db_TotCuot += Math.Round(db_CuotM);

                        #region calculo por redondeo de la ultima cuota

                        if (i_Linea == (i_NroCuotas - 1))
