        /// <summary>
        /// Ejecuta la funcionalidad del Botón Cambiar A (Estado) según el estado actual.
        /// </summary>
        /// <param name="oForm">Instancia al Objeto Formulario</param>
        public void PasarA(SAPbouiCOM.Form oForm)
        {
            SAPbouiCOM.Matrix oMatrix = null;
            SAPbouiCOM.ComboBox oComboSerie = null;
            SAPbouiCOM.ComboBox oComboEstado = null;
            SAPbouiCOM.ComboBox oComboTipCre = null;
            SAPbobsCOM.Recordset oRs = null;
            Consultas oConsulta = new Consultas(sapCompany, this.StrPath, this.strTipoServer);
            FuncionesGenerales oFG = new FuncionesGenerales(sapCompany, this.StrPath, this.strTipoServer);
            string strCampo = "";
            string strCampo2 = "";
            string strSerie;
            bool blContinuar = true;
            string strErrores = "";
            bool blReqCodeu = false;
            int iDocEntry;
            string strSerieNueva = "";
            string strEstado = "";
            string strSolic = "";
            string stTipCre = string.Empty;
            int iDocEntryNuevo = 0;
            int iNroCuotas = 0;
            string strDato = "";
            double dbVlrCuota = 0;
            double dbVlrSeg = 0;
            string strIdGarantia = string.Empty;
            string strQuery = string.Empty;
            string strIdCred = string.Empty;
            CreditosFinanciacion creditoFinanciacion = new CreditosFinanciacion(sapCompany, sapApplication, StrPath, this.strTipoServer); //FRC 20160915 Se agrega parametro Path
                                                                                                                                          //SAPbobsCOM.Recordset oRs = null;

            oComboEstado = (SAPbouiCOM.ComboBox)oForm.Items.Item("Ed_Estado").Specific;
            oComboTipCre = (SAPbouiCOM.ComboBox)oForm.Items.Item("CboTipCred").Specific;

            try
            {
                stTipCre = oComboTipCre.Selected.Value.ToString().Trim();
            }
            catch
            {
                stTipCre = string.Empty;
            }

            strIdCred = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("DocEntry", 0).Trim();

            #region Pasar a Cotización
            //if (oComboEstado.Selected.Value.Equals(FuncionesGenerales.GetStringValue(CreditosFinanciacion.Estado.Cotizacion)))
            if (oComboEstado.Selected.Value.Equals("02"))
            {
                oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrOtrSg", 0, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, CalcularSegurosPorCuota(oForm, 1)));
                oComboEstado = (SAPbouiCOM.ComboBox)oForm.Items.Item("Ed_Estado").Specific;
                #region Valida Solicitante
                strCampo = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_CardCode", 0);
                iDocEntry = Convert.ToInt32(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString());
                strCampo2 = oFG.CardCodeActual(iDocEntry);
                if (strCampo.Equals(""))
                {
                    sapApplication.SetStatusBarMessage("Debe seleccionar el Solicitante y Actualizar la Simulación", BoMessageTime.bmt_Short, true);
                    blContinuar = false;
                }
                else
                {
                    if (!strCampo2.Trim().Equals(strCampo.Trim()))
                    {
                        sapApplication.SetStatusBarMessage("La Simulación no ha sido actualizada, cambie el Estado y actualice el documento.", BoMessageTime.bmt_Short, true);
                        blContinuar = false;
                    }
                }
                #endregion
                #region Valida Fecha Desembolso
                strCampo = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_FecDesem", 0);
                if (strCampo.Equals(""))
                {
                    sapApplication.SetStatusBarMessage("Debe seleccionar la fecha de desembolso", BoMessageTime.bmt_Short, true);
                    blContinuar = false;
                }
                #endregion
                //FRC 20160211 Se agrega validaciòn de codeudor al crear la cotizacion
                #region Valida que existan Datos del Codeudor
                if (blContinuar)
                {
                    if (((SAPbouiCOM.CheckBox)oForm.Items.Item("Chk_Codeud").Specific).Checked == true)
                        blReqCodeu = true;
                    else
                    {
                        if (sapApplication.MessageBox("Esta seguro que no se requiere codeudor?", 1, "Si", "No") == 1)
                            blContinuar = true;
                        else
                            blContinuar = false;
                    }
                    oMatrix = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_4").Specific;
                    oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN5").Clear();
                    oMatrix.FlushToDataSource();
                    strCampo = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN5").GetValue("U_CodCode", 0);
                    if (strCampo.Equals("") && blReqCodeu)
                    {
                        sapApplication.SetStatusBarMessage("Debe existir al menos un registro de Codeudor", BoMessageTime.bmt_Short, true);
                        oComboEstado.Select("01");
                        blContinuar = false;
                    }
                }
                #endregion
                //FRC
                #region Valida Tabla de Amortización
                if (oFG.UltimaTablaAmortizacion(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString()) == 0)
                {
                    sapApplication.SetStatusBarMessage("Debe generar el cuadro de amortización calculando el crédito", BoMessageTime.bmt_Short, true);
                    //oComboEstado.Select(FuncionesGenerales.GetStringValue(CreditosFinanciacion.Estado.Simulación));
                    oComboEstado.Select("01");
                    blContinuar = false;
                }
                #endregion
                if (blContinuar)
                {
                    if (!((SAPbouiCOM.EditText)oForm.Items.Item("Ed_VlrTCa").Specific).Value.ToString().Equals(""))
                    {
                        iDocEntry = int.Parse(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString());
                        //strSerie = FuncionesGenerales.BuscarSerieEstado(FuncionesGenerales.GetStringValue(CreditosFinanciacion.Estado.Cotizacion), sapCompany);
                        strSerie = oFG.BuscarSerieEstado("02");
                        if (oFG.ExisteSerie(int.Parse(strSerie)))
                        {
                            CreditosFinanciacion oCRED = new CreditosFinanciacion(sapCompany, sapApplication, this.StrPath, this.strTipoServer); //FRC 20160915 Se agrega parametro Path
                            oCRED.CopiarACotizacion(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString(), this.StrPath);
                            if (oCRED.blOk == true)
                            {
                                strSolic = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_Solic").Specific).Value.ToString();
                                //iDocEntryNuevo = FuncionesGenerales.NuevoDocEntry(strSolic, FuncionesGenerales.GetStringValue(CreditosFinanciacion.Estado.Cotizacion), sapCompany);
                                iDocEntryNuevo = oFG.NuevoDocEntry(strSolic, "02");
                                sapApplication.SetStatusBarMessage("Se creo la Cotización Correctamente", BoMessageTime.bmt_Short, false);
                                oForm.Mode = BoFormMode.fm_FIND_MODE;
                                oForm.Items.Item("3").Enabled = true;
                                ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value = iDocEntry.ToString();
                                oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                                oForm.Mode = BoFormMode.fm_UPDATE_MODE;
                                ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_CredAct").Specific).Value = iDocEntryNuevo.ToString();
                                oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                                oForm.Mode = BoFormMode.fm_FIND_MODE;
                                oForm.Items.Item("3").Enabled = true;
                                ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value = iDocEntryNuevo.ToString();
                                oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                                ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_OtSeg").Specific).Value = "0.0";
                                oForm.Items.Item("3").Enabled = false;
                                //oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);

                            }
                            else
                                sapApplication.SetStatusBarMessage("Se presento error al crear la Cotizacion. Revisar Excepciones", BoMessageTime.bmt_Short, true);
                        }
                        else
                            sapApplication.SetStatusBarMessage("No existe Serie para el Estado Cotización. Revice parametrización de Estados.", BoMessageTime.bmt_Short, true);
                    }
                    else
                        sapApplication.SetStatusBarMessage("La Simulación no tiene Credito Calculado.", BoMessageTime.bmt_Short, true);
                }

                if (blContinuar)
                {
                    string stCredSI = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_CredSI", 0).Trim();
                    string stDocNumCre = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("DocNum", 0).Trim();

                    creditoFinanciacion.enviarAlerta(CreditosFinanciacion.TipoAlerta.alerta2, stCredSI, stDocNumCre, oForm.TypeEx);
                }

            }
            #endregion
            #region Pasar a Activo
            //if (oComboEstado.Selected.Value.Equals(FuncionesGenerales.GetStringValue(CreditosFinanciacion.Estado.Activo)))
            if (oComboEstado.Selected.Value.Equals("05"))
            {
                oComboSerie = (SAPbouiCOM.ComboBox)oForm.Items.Item("cbSerie").Specific;
                strSerie = oComboSerie.Selected.Value.ToString();
                #region Garantía de Vehículos
                if (oFG.BuscarSerieEstadoActivoGVehi(stTipCre).Equals(strSerie) || oFG.BuscarSerieEstadoActivoGAmb(stTipCre).Equals(strSerie))
                {
