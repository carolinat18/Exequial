                {
                    sapApplication.SetStatusBarMessage("No se encontro ningun campo diligenciado para realizar la Busqueda.", BoMessageTime.bmt_Short, true);
                }
                else
                {
                    strQuery = " SELECT ";
                    strQuery += " \"U_CardCode\"  AS \"Cod. Cliente\", ";
                    strQuery += " \"U_CardName\" AS \"Nombre Cliente\", ";
                    strQuery += " \"DocEntry\" AS \"Consecutivo\",  ";
                    strQuery += " \"U_NoPrenec\" AS \"Nro. Prenecesidad\",  ";
                    strQuery += " \"U_numcont\" AS \"Ref. Contrato\",  ";
                    strQuery += " \"DocNum\" AS \"Nro. Credito\",  ";
                    strQuery += " \"U_FecDesem\" AS \"Fecha Desembolso\", ";
                    strQuery += " \"U_Estado\" AS \"Estado\", ";
                    strQuery += " \"U_VlrCred\"  AS \"Valor_Credito\" ";
                    strQuery += " FROM \"@OK1_FINAN_CRED_HEAD\" T0 ";

                    strQuery += "WHERE ";
                    if (!dsCardCode.Equals(""))
                        strFiltro += " \"U_CardCode\"  =  '" + dsCardCode + "' ";

                    if (!dsCardName.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " UPPER (\"U_CardName\") LIKE UPPER ('%" + dsCardName + "%')";
                    }

                    if (!dsConsecutivo.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " \"DocEntry\" = " + dsConsecutivo;
                    }

                    if (!dsDocNum.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " \"DocNum\" = " + dsDocNum;
                    }

                    if (!dsPrenec.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " T0.\"U_NoPrenec\" = " + dsPrenec;
                    }

                    if (!dsDesembolso.Equals(""))
                    {
                        string strFec = OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(Convert.ToDateTime(dsDesembolso), sapApplication);
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " \"U_FecDesem\"  = '" + strFec + "'";
                    }

                    if (!dsEstado.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " T0.\"U_Estado\" = '" + dsEstado + "'";
                    }

                    if (!dsValorCredito.Equals("") && !dsOperador.Equals(""))
                    {
                        if (!strFiltro.Equals(""))
                            strFiltro += " AND ";
                        strFiltro += " \"U_VlrCred\" " + dsOperador + " " + dsValorCredito;
