            string strOrigen = string.Empty;
            SAPbobsCOM.Recordset oRset = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

            //strQry = "SELECT SUM(U_VlPendCa) + SUM(U_VlPendInt) + SUM(U_VlPendOS) + SUM(U_VlPendSV) FROM [@OK1_FINAN_CRED_LIN1] ";
