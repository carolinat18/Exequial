        /// <summary>Actualiza valores pendientes en las cuotas que seran pagadas reutlizando boletas</summary>
        /// <param name="sapCompany">Conmpañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="Path">Ruta</param>
        /// <param name="oMatrixPago">Matriz de formulario generacion de pagos</param>
        /// <param name="DocEntryCredito">DocEntry credito de las cuotas</param>
        /// <param name="TipoPago">Tipo de pago en formulario de generacion de pagos</param>
        /// <returns>True correcto</returns>
        public static bool ActualizarPendientesCuota(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string Path, SAPbouiCOM.Matrix oMatrixPago, string DocEntryCredito, string TipoPago, string nroPagoAddin)
        {

            SAPbobsCOM.Recordset oRecordSet = null;

            SAPbobsCOM.Recordset oRecordSetPagoOcho = null;

            try
            {
                string query = "";

                string ParcialesCuota = "";

                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);


                for (int i = 1; i <= oMatrixPago.RowCount; i++)
                {
                    string NumeroCuota = ((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_0").Cells.Item(i).Specific)).Value.ToString();
                    string docEntryFactura = ((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_11").Cells.Item(i).Specific)).Value.ToString();
                    string docNumFactura = ((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_12").Cells.Item(i).Specific)).Value.ToString();

                    if (TipoPago.Equals("8"))
                    {
                        oRecordSetPagoOcho = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerPendientesCuotaCredito", "/TQueries/Queries/Query");

                        query = query.Replace("%DocEntry%", DocEntryCredito);

                        query = query.Replace("%Cuota%", NumeroCuota);

                        oRecordSet.DoQuery(query);

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerCuotasPagoTotal", "/TQueries/Queries/Query");

                        if (oRecordSet.Fields.Item("U_PagosPar").Value.ToString().Equals("0"))
                        {
                            query = query.Replace("%Operador%", "=");
                        }
                        else
                        {
                            #region Actualiza valores pendientes en la cuota

                            query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ActualizarValoresPendientesCuotaPagoTotal", "/TQueries/Queries/Query");

                            query = query.Replace("%U_VlPendCa%", "0");

                            query = query.Replace("%U_VlPendInt%", "0");

                            query = query.Replace("%U_VlPendSV%", "0");

                            query = query.Replace("%U_VlPendOS%", "0");

                            query = query.Replace("%U_VlPendMo%", "0");

                            query = query.Replace("%Pagado%", "Y");

                            query = query.Replace("%DocEntry%", DocEntryCredito);

                            query = query.Replace("%Cuota%", NumeroCuota);

                            oRecordSetPagoOcho.DoQuery(query);

                            #endregion

                            query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerCuotasPagoTotal", "/TQueries/Queries/Query");

                            query = query.Replace("%Operador%", "");


                        }

                        query = query.Replace("%DocEntry%", DocEntryCredito);

                        query = query.Replace("%CuotaPagoTotal%", NumeroCuota);

                        oRecordSet.DoQuery(query);

                        if (oRecordSet.RecordCount > 0)
                        {
                            while (!oRecordSet.EoF)
                            {
                                if (oRecordSet.Fields.Item("U_Pagado").Value.ToString() == "N")
                                {
                                    #region Actualiza valores pendientes en la cuota

                                    query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ActualizarValoresPendientesCuotaBoleta", "/TQueries/Queries/Query");

                                    query = query.Replace("%Parciales%", "0");

                                    query = query.Replace("%U_VlPagado%", "0");

                                    query = query.Replace("%U_VlPendCa%", "0");

                                    query = query.Replace("%U_VlPendInt%", "0");

                                    query = query.Replace("%U_VlPendSV%", "0");

                                    query = query.Replace("%U_VlPendOS%", "0");

                                    query = query.Replace("%U_VlPendMo%", "0");

                                    query = query.Replace("%Pagado%", "Y");

                                    query = query.Replace("%docEntryFac%", docEntryFactura);

                                    query = query.Replace("%docNumFac%", docNumFactura);

                                    query = query.Replace("%pagoAddin%", nroPagoAddin);

                                    query = query.Replace("%DocEntry%", DocEntryCredito);

                                    NumeroCuota = oRecordSet.Fields.Item("U_NroCuot").Value.ToString();

                                    query = query.Replace("%Cuota%", NumeroCuota);

                                    oRecordSetPagoOcho.DoQuery(query);

                                    #endregion

                                }
                                else
                                {
                                    sapApplication.StatusBar.SetText("Una o varias cuotas ya se encuentran en estado pagado.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                                    return false;
                                }

                                oRecordSet.MoveNext();
                            }
                        }
                        i = oMatrixPago.RowCount + 1;
                    }
                    else
                    {
                        double AplicadoCapital = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_15").Cells.Item(i).Specific)).Value.ToString());

                        double AplicadoInteres = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_16").Cells.Item(i).Specific)).Value.ToString());

                        double AplicadoSeguro = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_17").Cells.Item(i).Specific)).Value.ToString());

                        double AplicadoMora = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_18").Cells.Item(i).Specific)).Value.ToString());

                        double TotalAplicado = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)(oMatrixPago.Columns.Item("col_9").Cells.Item(i).Specific)).Value.ToString());

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerPendientesCuotaCredito", "/TQueries/Queries/Query");

                        query = query.Replace("%DocEntry%", DocEntryCredito);

                        query = query.Replace("%Cuota%", NumeroCuota);

                        oRecordSet.DoQuery(query);

                        if (oRecordSet.RecordCount > 0)
                        {

                            if (oRecordSet.Fields.Item("U_Pagado").Value.ToString() == "N")
                            {
                                AplicadoCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendCa").Value) - AplicadoCapital;

                                AplicadoInteres = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendInt").Value) - AplicadoInteres;

                                AplicadoSeguro = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendSV").Value) - AplicadoSeguro;

                                AplicadoMora = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendMo").Value) - AplicadoMora;

                                TotalAplicado = TotalAplicado + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPagado").Value);

                                ParcialesCuota = oRecordSet.Fields.Item("U_PagosPar").Value.ToString();

                                #region Actualiza valores pendientes en la cuota

                                query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ActualizarValoresPendientesCuotaBoleta", "/TQueries/Queries/Query");

                                query = query.Replace("%Parciales%", ParcialesCuota);

                                query = query.Replace("%U_VlPagado%", TotalAplicado.ToString());

                                query = query.Replace("%U_VlPendCa%", AplicadoCapital.ToString());

                                query = query.Replace("%U_VlPendInt%", AplicadoInteres.ToString());

                                query = query.Replace("%U_VlPendSV%", AplicadoSeguro.ToString());

                                query = query.Replace("%U_VlPendOS%", "0");

                                query = query.Replace("%U_VlPendMo%", AplicadoMora.ToString());

                                query = query.Replace("%Pagado%", "N");

                                query = query.Replace("%docEntryFac%", docEntryFactura);

                                query = query.Replace("%docNumFac%", docNumFactura);

                                query = query.Replace("%pagoAddin%", nroPagoAddin);

                                query = query.Replace("%DocEntry%", DocEntryCredito);

                                query = query.Replace("%Cuota%", NumeroCuota);

                                oRecordSet.DoQuery(query);

                                #endregion
                            }
                            else
                            {
                                sapApplication.StatusBar.SetText("Una o varias cuotas ya se encuentran en estado pagado.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                                return false;
                            }


                        }
                        else
                        {
                            return true;
                        }
                    }
                }



                return true;

            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "ActualizarPendientesCuota", sapCompany);
                return false;
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
            }




        }


        public static bool ActualizarPendientesPagoMigrado(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string Path, string DocEntryCredito, int Cuota, double Pago, string Pagado)
        {

            SAPbobsCOM.Recordset oRecordSet = null;
            try
            {
                string query = "";

                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerPendientesCuotaCredito", "/TQueries/Queries/Query");

                query = query.Replace("%DocEntry%", DocEntryCredito);

                query = query.Replace("%Cuota%", Cuota.ToString());

                oRecordSet.DoQuery(query);

                if (oRecordSet.RecordCount > 0)
                {

                    if (oRecordSet.Fields.Item("U_Pagado").Value.ToString() == "N")
                    {
                        double PendienteCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendCa").Value);

                        double pendienteInteres = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPendInt").Value);

                        if (Pago <= pendienteInteres)
                        {
                            pendienteInteres = pendienteInteres - Pago;
                        }
                        else
                        {
                            pendienteInteres = 0;

                            PendienteCapital = PendienteCapital - (Pago - pendienteInteres);

                        }

                        double TotalAplicado = Pago + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSet.Fields.Item("U_VlPagado").Value);

                        #region Actualiza valores pendientes en la cuota

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ActualizarValoresPendientesCuota", "/TQueries/Queries/Query");

                        query = query.Replace("%Parciales%", oRecordSet.Fields.Item("U_PagosPar").Value.ToString());

                        query = query.Replace("%U_VlPagado%", TotalAplicado.ToString());

                        query = query.Replace("%U_VlPendCa%", PendienteCapital.ToString());

                        query = query.Replace("%U_VlPendInt%", pendienteInteres.ToString());

                        query = query.Replace("%U_VlPendSV%", oRecordSet.Fields.Item("U_VlPendSV").Value.ToString());

                        query = query.Replace("%U_VlPendOS%", "0");

                        query = query.Replace("%U_VlPendMo%", oRecordSet.Fields.Item("U_VlPendMo").Value.ToString());

                        query = query.Replace("%DocEntry%", DocEntryCredito);

                        query = query.Replace("%Cuota%", Cuota.ToString());

                        query = query.Replace("%Pagado%", Pagado);

                        oRecordSet.DoQuery(query);

                        #endregion

                        #region Guardar registro pago migrado

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "GuardarRegistroPagoMigrado", "/TQueries/Queries/Query");

                        query = query.Replace("%Cuota%", Cuota.ToString());

                        query = query.Replace("%Pago%", Pagado);

                        query = query.Replace("%PendienteCapital%", PendienteCapital.ToString());

                        query = query.Replace("%PendienteInteres%", pendienteInteres.ToString());

                        query = query.Replace("%U_VlPendSV%", oRecordSet.Fields.Item("U_VlPendSV").Value.ToString());

                        query = query.Replace("%U_VlPendOS%", "0");

                        query = query.Replace("%U_VlPendMo%", oRecordSet.Fields.Item("U_VlPendMo").Value.ToString());

                        query = query.Replace("%DocEntry%", DocEntryCredito);

                        query = query.Replace("%Cuota%", Cuota.ToString());

                        query = query.Replace("%Pagado%", Pagado);

                        oRecordSet.DoQuery(query);

                        #endregion
                    }
                    else
                    {
                        sapApplication.StatusBar.SetText("La cuota ya se encuentra en estado pagado.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                        return false;
                    }


                }


                return true;

            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "ActualizarPendientesPagoMigrado", sapCompany);
                return false;
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
            }




        }

