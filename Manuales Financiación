                oComboOperador = (SAPbouiCOM.ComboBox)oForm.Items.Item("14").Specific;
                dsOperador = oComboOperador.Selected.Value;

                if (dsCardCode.Equals("") && dsCardName.Equals("") && dsDocNum.Equals("") && dsDesembolso.Equals("") && dsValorCredito.Equals("")
