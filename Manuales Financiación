        /// <summary>Realiza la reconciliacion manual de los documentos generados por pagos masivo</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP </param>
        /// <param name="path">Ruta</param>
        /// <param name="cardCode">CadCode Socio de negocio asociado al proceso</param>
        /// <param name="fechaFacturacion">Fecha de creacion</param>
        /// <param name="boletas">Lista de Boletas creadas</param>
        /// <param name="recibo">Recibo de caja creado</param>
        public static void ReconciliacionManualPagoMasivo(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string path, string cardCode, DateTime fechaFacturacion, List<string> boletas, string recibo)
        {
            SAPbobsCOM.Recordset oRecordSet = null;
            bool boletasEncontradas = false;
            bool reciboEncontrado = false;
            double ValorPagado = 0;
            try
            {

                // Abrir formulario de reconciliación interna
                sapApplication.ActivateMenuItem("9459");
                SAPbouiCOM.Form oFormReconciliacionInternaSN = sapApplication.Forms.GetForm("120060803", 0);
                oFormReconciliacionInternaSN.Visible = false;
                oFormReconciliacionInternaSN.Freeze(true);

                // Configuración inicial del formulario
                oFormReconciliacionInternaSN.Items.Item("120000005").Click(BoCellClickType.ct_Regular);
                ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = false;
                ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("120000008").Specific).Value = cardCode;
                ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("1980000002").Specific).Value = fechaFacturacion.ToString("yyyyMMdd");

                oFormReconciliacionInternaSN.Items.Item("120000001").Click(BoCellClickType.ct_Regular);
                SAPbouiCOM.Form oFormReconciliacionInterna = sapApplication.Forms.ActiveForm;
                oFormReconciliacionInterna.Visible = false;
                oFormReconciliacionInterna.Freeze(true);

                SAPbouiCOM.Matrix oMtxReconciliacionInterna = (SAPbouiCOM.Matrix)oFormReconciliacionInterna.Items.Item("120000039").Specific;

                // Procesar boletas
                foreach (var boleta in boletas)
                {

                    oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                    string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerNumeroBoleta", "/TQueries/Queries/Query");
                    query = query.Replace("%DocEntry%", boleta);
                    oRecordSet.DoQuery(query);

                    string transIdBoleta = oRecordSet.RecordCount > 0 ? oRecordSet.Fields.Item("TransId").Value.ToString() : null;

                    if (!string.IsNullOrEmpty(transIdBoleta))
                    {
                        for (int j = oMtxReconciliacionInterna.RowCount; j >= 1; j--)
                        {
                            string numeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(j).Specific)).Value.ToString();

                            if (transIdBoleta.Equals(numeroOperacion))
                            {
                                string ValorOperacion = Regex.Replace(((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(j).Specific)).Value.ToString(), @"[^\d,.-]", "");
                                ValorPagado = ValorPagado + OK1.SBO.Helpers.DoubleFromEditText(ValorOperacion);
                                ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(j).Specific)).Checked = true;
                                boletasEncontradas = true;
                                break;
                            }
                        }
                    }
                }

                // Procesar recibo de caja

                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                string queryRecibo = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerTransIdRC", "/TQueries/Queries/Query");
                queryRecibo = queryRecibo.Replace("%DocEntry%", recibo);
                oRecordSet.DoQuery(queryRecibo);

                string transIdRC = oRecordSet.RecordCount > 0 ? oRecordSet.Fields.Item("TransId").Value.ToString() : null;

                if (!string.IsNullOrEmpty(transIdRC))
                {
                    for (int k = oMtxReconciliacionInterna.RowCount; k >= 1; k--)
                    {
                        string numeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(k).Specific)).Value.ToString();

                        if (transIdRC.Equals(numeroOperacion))
                        {
                            ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(k).Specific)).Checked = true;
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(k).Specific)).Value = ValorPagado.ToString();
                            reciboEncontrado = true;
                            break;
                        }
                    }
                }

                // Validar si se completó la reconciliación
                if (boletasEncontradas && reciboEncontrado)
                {
                    oFormReconciliacionInterna.Items.Item("120000001").Click(BoCellClickType.ct_Regular);
                }
                else
                {
                    sapApplication.StatusBar.SetText("No se encontraron todos los documentos para la reconciliación.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                }

                oFormReconciliacionInterna.Close();
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "ValidacionNumeroPagoAddin", sapCompany);
                sapApplication.StatusBar.SetText("Error durante el proceso de reconciliación.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                sapApplication.MessageBox("Error durante el proceso de reconciliación.", 1, "Aceptar", "", "");
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);

            }
        }

