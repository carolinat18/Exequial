        /// <summary>Se realizan validaciones para llevar a cabo el proceso de reversa en reconciliaciones manuales</summary>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="strIdCred">DocEntry del Credito</param>
        /// <param name="StrPath">Ruta</param>
        /// <param name="oDBS1">DBDataSource Lineas 1 del credito</param>
        /// <param name="fila">Linea siguiente a la seleccionada dentro de la matriz</param>
        /// <param name="strPagoAddIn">DocNum del pago addIn relacionado</param>
        /// <returns>True si la boleta queda en estado abierto</returns>
        public static bool validacionReconciliacionCancelacion(SAPbouiCOM.Application sapApplication, SAPbobsCOM.Company sapCompany, string strIdCred, string StrPath, SAPbouiCOM.DBDataSource oDBS1, int fila, string strPagoAddIn)
        {

            SAPbobsCOM.Recordset oRecord = null;

            SAPbobsCOM.Recordset oRecordSet = null;
            try
            {
                bool ReversaReconciliacion = false;

                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                string queryHana = OK1.Generic.Helpers.configParteConsulta(StrPath + @"AddInQueries\Queries_HANA.xml", "obtenerInformacionPagoCancelar", "/TQueries/Queries/Query");

                queryHana = queryHana.Replace("%DocEntry%", strIdCred);

                string NumeroPagoAddIn = oDBS1.GetValue("U_NroPagoAddin", fila - 1).ToString().Trim();

                queryHana = queryHana.Replace("%PagoAddin%", NumeroPagoAddIn);

                if (string.IsNullOrEmpty(NumeroPagoAddIn) || NumeroPagoAddIn.Equals("0"))
                {
                    int innerJoinIndex = queryHana.IndexOf("INNER JOIN");

                    if (innerJoinIndex != -1)
                    {
                        queryHana = queryHana.Substring(0, innerJoinIndex);

                        queryHana += $"WHERE T0.\"DocEntry\"='{strIdCred}';";
                    }
                }

                oRecordSet.DoQuery(queryHana);

                if (oRecordSet.RecordCount > 0)
                {
                    oRecord = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    while (!oRecordSet.EoF)
                    {
                        if (!FuncionesGenerales.validarEstadoBoleta(sapApplication, sapCompany, StrPath, oRecordSet.Fields.Item("U_EntrFact").Value.ToString()))
                        {
                            queryHana = OK1.Generic.Helpers.configParteConsulta(StrPath + @"AddInQueries\Queries_HANA.xml", "ObtenerNumeroBoleta", "/TQueries/Queries/Query");
                            queryHana = queryHana.Replace("%DocEntry%", oRecordSet.Fields.Item("U_EntrFact").Value.ToString());
                            oRecord.DoQuery(queryHana);

                            ReversaReconciliacion = false;


                            if (oRecord.RecordCount > 0)
                            {

                                string mensaje = FuncionesGenerales.cancelacionReconciliacionesManuales(sapApplication, sapCompany, StrPath, oRecord.Fields.Item("DocNum").Value.ToString(), strPagoAddIn, oRecordSet.Fields.Item("U_EntrFact").Value.ToString(), ref ReversaReconciliacion);
                                if (mensaje != "")
                                {

                                    sapApplication.StatusBar.SetText(mensaje, BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);

                                    sapApplication.MessageBox(mensaje, 1, "Aceptar", "", "");

                                    if (!ReversaReconciliacion)
                                    {
                                        return false;
                                    }

                                }

                            }

                        }
                        else
                        {
                            ReversaReconciliacion = true;
                        }

                        oRecordSet.MoveNext();
                    }

                }

                return ReversaReconciliacion;

            }
            catch (Exception e)
            {
                sapApplication.StatusBar.SetText("Error reversando las reconciliaciones manuales.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                sapApplication.MessageBox("Error reversando las reconciliaciones manuales.", 1, "Aceptar", "Cancelar", "");

                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "FuncionesGenerales---validacionReconciliacionCancelacion", sapCompany);

                return false;

            }
            finally
            {

                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
                OK1.SBO.Helpers.LiberarCOM(oRecord);
            }

        }

