        /// <summary>
        /// Llena la matriz de la Tabla de Amortización 
        /// </summary>
        /// <param name="oForm">Instancia al Objeto Formulario</param>
        private void CargarTabla(SAPbouiCOM.Form oForm, bool blTodas = false)
        {
            double dbVlrPenCap = 0;
            double dbVlrPendInt = 0;
            double dbVlrOtrSeg = 0;
            double dbVlrSegVid = 0;
            double dbVlrTCuot = 0;
            string strDato = "";
            string strTabla = "";
            string strDocEntry = "";
            FuncionesGenerales oFG = new FuncionesGenerales(sapCompany, this.StrPath, this.strTipoServer);

            SAPbouiCOM.Matrix oMtx = null;
            SAPbouiCOM.Conditions oCons;
            SAPbouiCOM.Condition oCon;
            strDocEntry = ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString();
            oFG.EliminarNullAmortizacion(strDocEntry);
            if (oForm.Items.Item("CboNroAmor").Enabled == true)
            {
                //SAPbouiCOM.ComboBox oCombo = (SAPbouiCOM.ComboBox)oForm.Items.Item("CboNroAmor").Specific;
                //strTabla = oCombo.Selected.Value.ToString();
                strTabla = oForm.DataSources.UserDataSources.Item("DS_NroAmor").Value.ToString().Trim();
            }
            else
                strTabla = oFG.UltimaTablaAmortizacion(strDocEntry).ToString();
            oCons = (SAPbouiCOM.Conditions)sapApplication.CreateObject(BoCreatableObjectType.cot_Conditions);
            oCon = oCons.Add();
            if (blTodas)
                oCon.BracketOpenNum = 1;
            else
                oCon.BracketOpenNum = 2;
            oCon.Alias = "DocEntry";
            oCon.Operation = BoConditionOperation.co_EQUAL;
            oCon.CondVal = strDocEntry;
            oCon.BracketCloseNum = 1;
            if (!blTodas)
            {
                oCon.Relationship = BoConditionRelationship.cr_AND;
                oCon = oCons.Add();
                oCon.BracketOpenNum = 1;
                oCon.Alias = "U_NroTabla";
                oCon.Operation = BoConditionOperation.co_EQUAL;
                oCon.CondVal = strTabla;
                oCon.BracketCloseNum = 2;
            }

            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN1").Clear();
            oMtx = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_0").Specific;
            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN1").Query(oCons);
            oMtx.LoadFromDataSource();
            SAPbouiCOM.Column oclm = (SAPbouiCOM.Column)oMtx.Columns.Item("col_0");
            oclm.TitleObject.Sortable = true;
            oclm.TitleObject.Sort(BoGridSortType.gst_Ascending);
            //oclm.TitleObject.Click(BoCellClickType.ct_Double);

            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrCaPen", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            dbVlrPenCap = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);

            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrInPen", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            dbVlrPendInt = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);

            ((EditText)oForm.Items.Item("Ed_VlrTCa").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrPenCap));
            ((EditText)oForm.Items.Item("Ed_VlrTIn").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, Math.Round(dbVlrPendInt));

            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrSegV", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            dbVlrSegVid = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrOtrSg", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            dbVlrOtrSeg = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrTCuot", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            dbVlrTCuot = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);

            ((EditText)oForm.Items.Item("Ed_VlTCu").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, Math.Round(dbVlrTCuot + dbVlrSegVid + dbVlrOtrSeg));
        }

