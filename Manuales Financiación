            sapApplication.StatusBar.SetText("Cálculo de Crédito iniciado, por favor espere ...", BoMessageTime.bmt_Medium, BoStatusBarMessageType.smt_Warning);
            if (oForm.Mode == BoFormMode.fm_ADD_MODE)
            {
                oForm.Items.Item("Ed_Proyec").Click(BoCellClickType.ct_Regular);

                oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                strConsec = oFG.NuevoDocEntry(strCodSN, strDato).ToString();
                oForm.Mode = BoFormMode.fm_FIND_MODE;
                oForm.Items.Item("3").Enabled = true;
                oForm.Items.Item("1").Enabled = true;
                ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value = strConsec;
                oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                oForm.Items.Item("3").Enabled = false;
            }
            strConsec = ((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString();
            if (strConsec.Equals(""))
            {
                iTabla = 1;
                strDato = "1";
            }
            else
            {
                //FRC 20160302 Solo se crea nueva tabla si el Estado es distinto a Simulación
                if (!strEstado.ToString().Trim().Equals(oFG.GetStringValue(CreditosFinanciacion.Estado.Simulación)))
                {
                    oForm.Items.Item("CboNroAmor").Enabled = true;
                    strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_NroTabla", 0);

                    if (strDato.Equals("") || strDato.Equals("0"))
                        strDato = "1";
                    iTabla = int.Parse(strDato);
                    //FRC 20160301 Se quita condición de nombre del Botón
                    //if (((SAPbouiCOM.Button)oForm.Items.Item("CalcCred").Specific).Caption == "Refinanciar")
                    //{
                    if (iTabla > 1)
                    {
                        if (sapApplication.MessageBox("Existe una Tabla de Amortización Refinanciada, desde crear una nueva?", 2, "Si", "No") == 1)
                        {
                            iTabla++;
                        }
                        else
                        {
                            oFG.EliminarTabla(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString(), iTabla);
                        }
                    }
                    else
                        iTabla++;
                    //}
                    //FRC
                }
                else
                {
                    iTabla = 1;
                    oFG.EliminarTabla(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString(), iTabla);
                }
            }
            oComboEstado = (SAPbouiCOM.ComboBox)oForm.Items.Item("Ed_Estado").Specific;
            CreditosFinanciacion oCRED = new CreditosFinanciacion(sapCompany, sapApplication, this.StrPath, this.strTipoServer); //FRC 20160915 Se agrega parametro Path
            oCRED.GetByKey(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString());
            oCRED.strCardCode = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_CardCode", 0);
            oCRED.strCardName = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_CardName", 0);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrCred", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_NroCuot", 0);
            oCRED.iNroCuotas = Convert.ToInt32(strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_TIM", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbTIM = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            oCRED.strTipoAmortizacion = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_TipAmort", 0);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrCuota", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrCuotaMensual = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrBasSV", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrBaseSegVida = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrSegV", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrSegVida = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrOtrSg", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrSeguros = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_VlrTCuot", 0);
            strDato = OK1.SBO.Helpers.DoubleToDBDataSource(sapCompany, strDato, false, "", 2);
            oCRED.dbVlrTotalCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, strDato);
            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_FecDesem", 0);
            oCRED.dtFechaPago = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
            oCRED.strReqCodeudor = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_Codeud", 0);
            oCRED.strEstado = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_Estado", 0);
            //FRC 20160607 Se consulta el nro de la primer cuota de la tabla
            if (oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN1").Size > 0)
            {
                strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN1").GetValue("U_NroCuot", 0);
                //FRC 20170118 Se valida si el campo esta vacio quiere decir que la cuota inicial es la 1
                if (!strDato.Equals(""))
                    iCuotaIniTabla = Convert.ToInt32(strDato);
                else
                    iCuotaIniTabla = 1;
            }

            if (oCRED.CrearSimulacion())
                blBand = true;
            else
                blBand = false;

            if (blBand)
            {

                strQuery = oConsulta.QryUltimaCuotaSinPagoSinFacturaCredito(oCRED.strDocEntry);
                oConsulta.EjecutarConsulta(ref oRs, strQuery);

                try
                {
                    int iCuotaIni = int.Parse(oRs.Fields.Item(0).Value.ToString().Trim());

                    if (iCuotaIni > 0)
                    {
                        oCRED.ICuotaInicialTabla = iCuotaIni;
                        //FRC 20160428 Se tiene en cuenta por si se va a cambiar la fecha de desembolso, solo aplica si la nueva fecha es mayor a la de la cuota
                        //oCRED.dtFechaPago = Convert.ToDateTime(stFecNew).AddMonths(-1);
                        if (sapApplication.MessageBox("Desea modificar la fecha de pago basado en la fecha de desembolso?", 1, "Si", "No") == 1)
                        {
                            strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_FecDesem", 0);
                            DateTime dtFecPag = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
                            oCRED.dtFechaPago = dtFecPag;
                        }
                        else
                        {
                            string stFecNew = oRs.Fields.Item(1).Value.ToString().Trim();
                            oCRED.dtFechaPago = Convert.ToDateTime(stFecNew).AddMonths(-1);
                        }
                        //FRC
                    }
                    else
                    {
                        oCRED.ICuotaInicialTabla = 1;
                        strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_FecDesem", 0);
                        oCRED.dtFechaPago = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
                    }
                }
                catch
                {
                    oCRED.ICuotaInicialTabla = 1;
                    strDato = oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").GetValue("U_FecDesem", 0);
                    oCRED.dtFechaPago = OK1.SBO.Helpers.FechaFormateadaAsDateTime(strDato, sapApplication);
                }

                oCRED.iTabla = iTabla;
                //FRC 20160520 Se copian las cuotas ya pagas a la nueva tabla de amortización
                if (iTabla > 1 && oCRED.ICuotaInicialTabla > 1)
                {
                    strQuery = oConsulta.QryCuotasPagasTablaAmortiz(oCRED.strDocEntry, (iTabla - 1).ToString(), oCRED.ICuotaInicialTabla);
                    oConsulta.EjecutarConsulta(ref oRs, strQuery);
                    if (oRs.RecordCount > 0)
                    {
                        oRs.MoveFirst();
                        int i = 0;

                        oCRED.LineasAmortizacion = new CreditosFinanciacionLineasAmortizacion[oRs.RecordCount];
                        while (!oRs.EoF)
                        {
                            oCRED.LineasAmortizacion[i] = new CreditosFinanciacionLineasAmortizacion();
                            oCRED.LineasAmortizacion[i].iTabla = iTabla;
                            oCRED.LineasAmortizacion[i].strTipoAmortizacion = oCRED.strTipoAmortizacion;
                            int tempocuota = int.Parse(oRs.Fields.Item("U_NroCuot").Value.ToString());
                            oCRED.LineasAmortizacion[i].iNroCuota = tempocuota;
                            oCRED.LineasAmortizacion[i].dbVlrCuota = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrCuota").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrCapital = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_Capital").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrIntereses = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_Intereses").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrSaldo = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_SaldoCr").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrSeguros = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrSeg").Value.ToString());
                            oCRED.LineasAmortizacion[i].dbVlrPago = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrPago").Value.ToString());
                            oCRED.LineasAmortizacion[i].FechaProxPago = Convert.ToDateTime(oRs.Fields.Item("U_FechPPag").Value.ToString());
                            oCRED.LineasAmortizacion[i].blFacturado = oRs.Fields.Item("U_Factura").Value.ToString().Equals("Y") ? true : false;

                            strDato = oRs.Fields.Item("U_FechaFra").Value.ToString();
                            if (!strDato.Equals(""))
                                dtFechaCuota = Convert.ToDateTime(strDato);
                            else
                                dtFechaCuota = Convert.ToDateTime("1988/12/30");
                            oCRED.LineasAmortizacion[i].FechaFactura = dtFechaCuota;
                            oCRED.LineasAmortizacion[i].strEntFactura = oRs.Fields.Item("U_EntrFact").Value.ToString();
                            oCRED.LineasAmortizacion[i].strNroFactura = oRs.Fields.Item("U_NroFact").Value.ToString();
                            oCRED.LineasAmortizacion[i].dbVlrFrado = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlrFrado").Value.ToString());

                            bool sipagado = false;

                            string stPagado = oRs.Fields.Item("U_Pagado").Value.ToString().Trim();


                            if (stPagado.Equals("Y"))
                            {
                                sipagado = true;
                            }


                            oCRED.LineasAmortizacion[i].blPagado = sipagado;
                            oCRED.LineasAmortizacion[i].strEntPago = oRs.Fields.Item("U_EntrPago").Value.ToString();
                            oCRED.LineasAmortizacion[i].strNroPago = oRs.Fields.Item("U_NroPago").Value.ToString();
                            oCRED.LineasAmortizacion[i].dbVlrPagado = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRs.Fields.Item("U_VlPagado").Value.ToString());
                            oCRED.LineasAmortizacion[i].strNroPagoAddIn = oRs.Fields.Item("U_NroPagoAddin").Value.ToString();
                            i++;
                            oRs.MoveNext();
                        }
                        oCRED.InsertarLineasAmortizacion();
                        //FRC 20160930 Copiar Tabla de Pagos Parciales
                        oConsulta.EjecutarConsulta(ref oRs, oConsulta.QryCopiarPagoParcial(oCRED.strDocEntry, (iTabla - 1).ToString()));
                        oConsulta.EjecutarConsulta(ref oRs, oConsulta.QryActualizarCantPagoParcial(oCRED.strDocEntry, iTabla.ToString()));

                    }

                }
                //FRC Fin

                oCRED.CalcularCredito();
                sapApplication.StatusBar.SetText("Cálculo de Crédito Finalizado.", BoMessageTime.bmt_Medium, BoStatusBarMessageType.smt_Success);

                //if (oComboEstado.Selected.Value.Equals("01"))
                //{
                oForm.Items.Item("2").Click(BoCellClickType.ct_Regular);
                this.sapApplication.ActivateMenuItem("OK1_FINAN_CRED");
