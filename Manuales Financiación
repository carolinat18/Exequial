        /// <param name="oMatrix">Matriz</param>
        /// <param name="iRow">Fila</param>
        /// <param name="strCol">UniqueID de la Columna</param>
        /// <param name="blEditable">Habilitar/Deshabilitar</param>
        public void Deshabilitar_Celda(SAPbouiCOM.Matrix oMatrix, int iRow, string strCol, bool blEditable)
        {
            for (int i = 0; i < oMatrix.Columns.Count; i++)
            {
                if (oMatrix.Columns.Item(i).UniqueID.Equals(strCol))
                {
                    try
                    {
                        oMatrix.CommonSetting.SetCellEditable(iRow, i, blEditable);
                    }
                    catch { }
                    i = oMatrix.Columns.Count + 1;
                }
            }
        }

