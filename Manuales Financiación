                        oRs1.MoveNext();
                    }
                }
            }
            catch (Exception ex)
            {
                OK1.SBO.Helpers.reportar_error(ex, "FuncionesGenerales", "generarTablaCreditoDTW", this.sapCompany);
            }
            finally
