        /// <param name="LineMemo">Comentario de linea del asiento seleccionado</param>
        /// <param name="SocioNegocioRD">Codigo SN linea seleccionada</param>
        public static void ReconciliacionManualRD(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string path, SAPbouiCOM.Form oFormFinanPagos, bool DatosCargados, string LineMemo, string SocioNegocioRD)
        {
            SAPbouiCOM.ProgressBar oProgress = null;

            SAPbobsCOM.Recordset oRecordSet = null;

            SAPbobsCOM.Recordset oRecord = null;

            bool BoletasEncontradas = false;

            bool DocumentoEncontrado = false;


            try
            {
                SAPbouiCOM.ComboBox ComboTipoPago = (SAPbouiCOM.ComboBox)oFormFinanPagos.Items.Item("cb_TPago").Specific;

