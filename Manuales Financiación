        public double VlrTotalPago(DateTime dtFechaPago, string IdCredito, string IntMora, string IntReten, string strPath)
        {
            double vlrPagar = 0d;
            string stQuery = string.Empty;
            SAPbobsCOM.Recordset oRec = null;
            int diasMora = 0;
            int tdiasmora = 0;
            double dbVlrintCorriente = 0d;
            double dbVlrintMora = 0d;
            double dbVlrseguros = 0d;
            double dbVlrCapital = 0d;
            double dbVlrPendSaldo = 0d; //FRC 20160218 Para obtener el saldo de la ultima cuota
            double dbvlrTempoIntCorr = 0d;
            bool blCalcular = true; //FRC 20160215 Bandera para determinar si se calcula o no interes corriente en la cuota
            DateTime dtFecUltPagoCalc = DateTime.Now; //FRC 20160216 Se calcula para obtener intereses corrientes
            bool blPrimer = true; //FRC 20160216 Bandera para saber si entra la primera vez
            int diasdif = 0;
            Consultas oConsulta = new Consultas(this.oCmp, this.strPath, this.strTipoServer);
            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            stQuery = oConsulta.QryDatosPagoTotalCredito(IdCredito, IntMora, OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(dtFechaPago, this.oApp), IntReten);
            oConsulta.EjecutarConsulta(ref oRec, stQuery);

            if (oRec.RecordCount > 0)
            {
                //FRC 20160217 Se obtiene el saldo en el ùltimo registro
                oRec.MoveLast();
                dbVlrPendSaldo = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("SaldoCR").Value);
                //FRC

                oRec.MoveFirst();
                DateTime dtFecUltimoPago = Convert.ToDateTime(oRec.Fields.Item("fecUltPago").Value.ToString());
                dbvlrTempoIntCorr = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrIntereses").Value);

                while (!oRec.EoF)
                {
                    diasMora = int.Parse(oRec.Fields.Item("DiasMora").Value.ToString());
                    /*if (blPrimer)
                    {
                        dtFecUltPagoCalc = dtFecUltimoPago;
                        blPrimer = false;
                    }*/

                    if (diasMora > 0)
                    {
                        tdiasmora += diasMora;

                        //dbVlrintCorriente += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrIntereses").Value);
                        dbVlrintMora += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrMora").Value);
                        dbVlrseguros += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrSeguros").Value);
                        dbVlrCapital += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrCapital").Value);
                        //FRC 20160216 Como se calcula todos los intereses en esta cuota se actualiza fecha ult pago.
                        //dtFecUltPagoCalc = Convert.ToDateTime(oRec.Fields.Item("FechaPago").Value.ToString());
                    }
                    else
                    {
                        diasdif = 0;
                        DateTime dtFecPagoCuota = Convert.ToDateTime(oRec.Fields.Item("FechaPago").Value.ToString());
                        //if (dtFecUltPagoCalc == dtFecUltimoPago)
                        //FRC 20160516 El càlculo de los intereses corrientes se realiza sobre la fecha de pago de la cuota y no sobre la ùltima fecha de pago
                        DateTime dtFecPagoUltCuota = Convert.ToDateTime(oRec.Fields.Item("FecPagoUltCuota").Value.ToString());
                        diasdif = oFG.DiferenciaDias2(dtFecPagoUltCuota, dtFechaPago);
                        //else
                        //diasdif = FuncionesGenerales.DiferenciaDias2(dtFecUltPagoCalc, dtFechaPago);

                        if (blCalcular)
                        {
                            //dbvlrTempoIntCorr = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrIntereses").Value);
                            dbvlrTempoIntCorr = (dbvlrTempoIntCorr / 30);
                            dbvlrTempoIntCorr = (dbvlrTempoIntCorr) * diasdif;
                            dbVlrintCorriente += dbvlrTempoIntCorr;
                        }
                        dbVlrseguros += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrSeguros").Value);
                        dbVlrCapital += OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRec.Fields.Item("VlrCapital").Value);

                        if (dtFechaPago <= dtFecPagoCuota)
                        {
                            blCalcular = false;
                        }

                        //oRec.MoveLast();
                    }

                    oRec.MoveNext();
                }

                //FRC 20160219 Si no se calcula interes corriente porque todo el credito esta vencido, se realiza el calculo total
                if (dbVlrintCorriente == 0)
                {
                    diasdif = oFG.DiferenciaDias2(dtFecUltimoPago, dtFechaPago);
                    dbvlrTempoIntCorr = (dbvlrTempoIntCorr / 30);
                    dbvlrTempoIntCorr = (dbvlrTempoIntCorr) * diasdif;
                    dbVlrintCorriente += dbvlrTempoIntCorr;
                }
                //FRC 20160218 Se agrega valor pendiente de la ultima cuota (dbVlrPendSaldo)
                vlrPagar = dbVlrCapital + dbVlrintCorriente + dbVlrintMora + dbVlrseguros + dbVlrPendSaldo; //+ dbVlrCapital;

            }
            //FRC 20160216 Quito decimales
            return Math.Round(vlrPagar, 0);
        }

