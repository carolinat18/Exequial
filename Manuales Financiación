                    SAPbouiCOM.Form oFormReconciliacionInternaSN = sapApplication.Forms.GetForm("120060803", 0);
                    oFormReconciliacionInternaSN.Visible = false;
                    oFormReconciliacionInternaSN.Freeze(true);

                    oFormReconciliacionInternaSN.Items.Item("120000005").Click(BoCellClickType.ct_Regular);

                    ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = true;

                    SAPbouiCOM.Matrix oMtxReconciliacionInternaSN = (SAPbouiCOM.Matrix)oFormReconciliacionInternaSN.Items.Item("10000085").Specific;

                    oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                    string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "SocioNegocioReciboCaja", "/TQueries/Queries/Query");

                    string cambio = oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString();

                    if (cambio.Length < 1)
                    {
                        cambio = "00000";
                    }
                    query = query.Replace("%DocNum%", cambio);

                    oRecordSet.DoQuery(query);

                    if (oRecordSet.RecordCount > 0)
                    {

                        if (!oRecordSet.Fields.Item("CardCode").Value.ToString().Equals(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString()))
                        {
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInternaSN.Columns.Item("10000003").Cells.Item(1).Specific)).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();
                            ((SAPbouiCOM.EditText)(oMtxReconciliacionInternaSN.Columns.Item("10000003").Cells.Item(2).Specific)).Value = oRecordSet.Fields.Item("CardCode").Value.ToString();

                        }
                        else
                        {
                            ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = false;
                            ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("120000008").Specific).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();
                        }
                    }
                    else
                    {
                        ((SAPbouiCOM.CheckBox)oFormReconciliacionInternaSN.Items.Item("10000084").Specific).Checked = false;
                        ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("120000008").Specific).Value = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edCliente").Specific).Value.ToString();

                    }

                    ((SAPbouiCOM.EditText)oFormReconciliacionInternaSN.Items.Item("1980000002").Specific).Value = OK1.SBO.Helpers.FechaFormateadaAsAAAAMMDD(DateTime.Now, sapApplication);

                    oProgress.Value++;

                    oFormReconciliacionInternaSN.Items.Item("120000001").Click(BoCellClickType.ct_Regular);

                    oFormReconciliacionInterna = (SAPbouiCOM.Form)sapApplication.Forms.ActiveForm;

                    oFormReconciliacionInterna.Visible = false;


                    oFormReconciliacionInterna.Freeze(true);


                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "NotaCreditoReconciliacion", "/TQueries/Queries/Query");

                    query = query.Replace("%DocNum%", ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_NroPag").Specific).Value.ToString());

                    oRecordSet.DoQuery(query);

                    if (oRecordSet.RecordCount > 0)
                    {
                        string ContenidoNC = oRecordSet.Fields.Item("NC").Value.ToString();
                        if (!ContenidoNC.Equals("0"))
                        {
                            NotaCredito = true;

                        }

                    }

                    SAPbouiCOM.Matrix oMtxReconciliacionInterna = (SAPbouiCOM.Matrix)oFormReconciliacionInterna.Items.Item("120000039").Specific;

                    SAPbouiCOM.Matrix oMtxCuotasPagas = (SAPbouiCOM.Matrix)oFormFinanPagos.Items.Item("mtx_0").Specific;

                    for (int i = oMtxCuotasPagas.RowCount; i >= 1; i--)
                    {
                        string DocEntryBoleta = ((SAPbouiCOM.EditText)(oMtxCuotasPagas.Columns.Item("col_11").Cells.Item(i).Specific)).Value.ToString();

                        query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerNumeroBoleta", "/TQueries/Queries/Query");

                        query = query.Replace("%DocEntry%", DocEntryBoleta);

                        oRecordSet.DoQuery(query);

                        string DocNumBoleta = oRecordSet.Fields.Item("DocNum").Value.ToString();

                        ValorBoleta = Convert.ToDouble(oRecordSet.Fields.Item("DocTotal").Value);

                        for (int j = 1; j <= oMtxReconciliacionInterna.RowCount; j++)
                        {

                            string ref1 = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000011").Cells.Item(j).Specific)).Value.ToString();

                            if (DocNumBoleta.Equals(ref1))
                            {
                                oProgress.Value++;
                                ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(j).Specific)).Checked = true;
                                ValorBoletaTotal += ValorBoleta;
                                BoletasEncontradas = true;

                            }

                        }


                    }

                    if (!NotaCredito)
                    {

                        double ValorPagado = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value.ToString());

                        string DocEntryRecibo = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_EntrPag").Specific).Value.ToString();

                        query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerTransIdRC", "/TQueries/Queries/Query");

                        query = query.Replace("%DocEntry%", DocEntryRecibo);

                        oRecordSet.DoQuery(query);

                        string TransIdRC = oRecordSet.Fields.Item("TransId").Value.ToString();

                        for (int k = 1; k <= oMtxReconciliacionInterna.RowCount; k++)
                        {
                            string NumeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(k).Specific)).Value.ToString();

                            if (TransIdRC.Equals(NumeroOperacion))
                            {
                                oProgress.Value++;
                                ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(k).Specific)).Checked = true;
                                if (pagoSaldoPendiente)
                                    ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(k).Specific)).Value = ValorBoletaTotal.ToString();
                                else
                                    ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000027").Cells.Item(k).Specific)).Value = ValorPagado.ToString();
                                ReciboEncontrado = true;
                            }

                        }
                    }
                    else
                    {
                        query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "NotaCreditoReconciliacion", "/TQueries/Queries/Query");

                        query = query.Replace("%DocNum%", ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_NroPag").Specific).Value.ToString());

                        oRecordSet.DoQuery(query);

                        if (oRecordSet.RecordCount > 0)
                        {
                            while (!oRecordSet.EoF)
                            {
                                string NumeroTransIdNC = oRecordSet.Fields.Item("TRANSID_NC").Value.ToString();

                                for (int j = 1; j <= oMtxReconciliacionInterna.RowCount; j++)
                                {
                                    string NumeroOperacion = ((SAPbouiCOM.EditText)(oMtxReconciliacionInterna.Columns.Item("120000003").Cells.Item(j).Specific)).Value.ToString();

                                    if (NumeroTransIdNC.Equals(NumeroOperacion))
                                    {
                                        oProgress.Value++;
                                        ((SAPbouiCOM.CheckBox)(oMtxReconciliacionInterna.Columns.Item("120000002").Cells.Item(j).Specific)).Checked = true;
                                        NCEncontradas = true;
                                        j = oMtxReconciliacionInterna.RowCount + 1;
                                    }

                                }
                                oRecordSet.MoveNext();
                            }

                        }

                    }

                    if ((ReciboEncontrado || NCEncontradas) && BoletasEncontradas)
                    {

                        oFormReconciliacionInterna.Items.Item("120000001").Click(BoCellClickType.ct_Regular);

                    }
                    else
                    {
                        sapApplication.StatusBar.SetText("No se encontraron documentos pendientes por reconciliar.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);


                    }
                    oFormReconciliacionInterna.Close();
                }

            }
            catch (Exception e)
            {
                oFormReconciliacionInterna.Close();
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "ValidacionNumeroPagoAddin", sapCompany);
                sapApplication.StatusBar.SetText("Error durante el proceso de reconciliacion.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                sapApplication.MessageBox("Error durante el proceso de reconciliacion.", 1, "Aceptar", "", "");


            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);
                if (oProgress != null)
                {
                    oProgress.Stop();
                    OK1.SBO.Helpers.LiberarCOM(oProgress);
                }

            }

        }

        /// <summary>Validacion para habilitar tipo pago 7-8 en un registro de addIn </summary>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="DocNum">DocNum del pago</param>
        /// <param name="oForm">Formulario generacion de pago</param>
        /// <param name="path">Ruta</param>
        /// <param name="SoloCheck">Control para el contenido a habilitar y modificar</param>
        public static void HabilitarPagoVinculado(SAPbouiCOM.Application sapApplication, SAPbobsCOM.Company sapCompany, string DocNum, SAPbouiCOM.Form oForm, string path, bool SoloCheck = true)
        {
            SAPbobsCOM.Recordset oRecordSet = null;
            try
            {
                SAPbouiCOM.ComboBox oCombo = (SAPbouiCOM.ComboBox)oForm.Items.Item("cb_TPago").Specific;

                string NumeroRC = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_NroPag").Specific).Value.ToString();

                if ((oCombo.Selected.Value.Equals("7") || oCombo.Selected.Value.Equals("8")) && (NumeroRC.Equals("0") || string.IsNullOrEmpty(NumeroRC)))
                {
                    if (!SoloCheck)
                    {

                        oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                        string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "EstadoBoletasPago", "/TQueries/Queries/Query");

                        query = query.Replace("%DocNum%", DocNum);

                        oRecordSet.DoQuery(query);

                        if (oRecordSet.RecordCount > 0)
                        {

                            sapApplication.StatusBar.SetText("Existen documentos liquidados en estado cerrado. No es posible vincular un nuevo pago", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);

                            sapApplication.MessageBox("Existen documentos liquidados en estado cerrado. No es posible vincular un nuevo pago", 1, "Aceptar", "", "");

                            ((SAPbouiCOM.CheckBox)oForm.Items.Item("ChkVinc").Specific).Checked = false;

                            oForm.Items.Item("ChkVinc").Enabled = false;

                        }
                        else
                        {
                            ((SAPbouiCOM.ComboBox)oForm.Items.Item("cb_TPago").Specific).Select("7");
                            ((SAPbouiCOM.EditText)oForm.Items.Item("edVlrTC").Specific).Value = "0,00";
                            oForm.Items.Item("OKEddocVi").Enabled = true;
                            oForm.Items.Item("BtnList").Enabled = true;
                            BloqueoFormaDePago(sapApplication, sapCompany, oForm, true);
                        }

                    }
                    else
                    {
                        oForm.Items.Item("ChkVinc").Enabled = true;

                    }
                }
                else
                {
                    oForm.Items.Item("ChkVinc").Enabled = false;
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "HabilitarPagoVinculado", sapCompany);
            }
        }


