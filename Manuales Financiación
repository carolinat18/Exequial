        /// <summary>Proceso de cancelacion para un registro de pago</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="path">Ruta</param>
        /// <param name="oFormFinanCreditos">Formulario credito</param>
        /// <param name="DocEntryCredito">DocEntry credito</param>
        /// <param name="PagoAddIn">Numero pago AddIn</param>
        /// <returns>True proceso correcto</returns>
        public bool CancelarRegistroPagoVinculado(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string path, SAPbouiCOM.Form oFormFinanCreditos, string DocEntryCredito, string PagoAddIn)
        {
            SAPbobsCOM.Recordset oRecordSetCuotas = null;

            SAPbobsCOM.Recordset oRecordSetActualizacion = null;

            try
            {

                string Parciales = "";

                string Cuota = "";

                double ValorPagado = 0;

                oRecordSetCuotas = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                oRecordSetActualizacion = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                string query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerCuotasPagoAddIn", "/TQueries/Queries/Query");

                query = query.Replace("%DocEntry%", DocEntryCredito);

                query = query.Replace("%AddIn%", PagoAddIn);

                oRecordSetCuotas.DoQuery(query);

                if (oRecordSetCuotas.RecordCount > 0)
                {
                    sapApplication.StatusBar.SetText("Actualizando registros.", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);

                    while (!oRecordSetCuotas.EoF)
                    {
                        Parciales = oRecordSetCuotas.Fields.Item("U_PagosPar").Value.ToString();

                        Cuota = oRecordSetCuotas.Fields.Item("U_NroCuot").Value.ToString();

                        if (int.Parse(Parciales) > 1)
                        {
                            #region Anula parcial de cuota

                            query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "AnularParcial", "/TQueries/Queries/Query");

                            query = query.Replace("%DocEntry%", DocEntryCredito);

                            query = query.Replace("%AddIn%", PagoAddIn);

                            query = query.Replace("%Cuota%", Cuota);

                            oRecordSetActualizacion.DoQuery(query);

                            #endregion

                            #region Obtiene valores pendiente para la cuota
                            query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ObtenerValoresPendientesCuota", "/TQueries/Queries/Query");

                            query = query.Replace("%DocEntry%", DocEntryCredito);

                            query = query.Replace("%Cuota%", Cuota);

                            oRecordSetActualizacion.DoQuery(query);

                            #endregion

                            #region Actualiza valores pendientes en la cuota

                            query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarValoresPendientesCuota", "/TQueries/Queries/Query");

                            query = query.Replace("%Parciales%", (int.Parse(Parciales) - 1).ToString());

                            ValorPagado = (OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetCuotas.Fields.Item("U_VlrCuota").Value)
                                         - (OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetActualizacion.Fields.Item("U_VlPendCa").Value)
                                         + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetActualizacion.Fields.Item("U_VlPendInt").Value)
                                         + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetActualizacion.Fields.Item("U_VlPendSV").Value)
                                         + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetActualizacion.Fields.Item("U_VlPendOS").Value)
                                         + OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRecordSetActualizacion.Fields.Item("U_VlPendMo").Value)));

                            query = query.Replace("%U_VlPagado%", ValorPagado.ToString());

                            query = query.Replace("%U_VlPendCa%", oRecordSetActualizacion.Fields.Item("U_VlPendCa").Value.ToString());

                            query = query.Replace("%U_VlPendInt%", oRecordSetActualizacion.Fields.Item("U_VlPendInt").Value.ToString());

                            query = query.Replace("%U_VlPendSV%", oRecordSetActualizacion.Fields.Item("U_VlPendSV").Value.ToString());

                            query = query.Replace("%U_VlPendOS%", oRecordSetActualizacion.Fields.Item("U_VlPendOS").Value.ToString());

                            query = query.Replace("%U_VlPendMo%", oRecordSetActualizacion.Fields.Item("U_VlPendMo").Value.ToString());

                            query = query.Replace("%Pagado%", "N");

                            query = query.Replace("%DocEntry%", DocEntryCredito);

                            query = query.Replace("%Cuota%", Cuota);

                            oRecordSetActualizacion.DoQuery(query);

                            #endregion

                        }
                        else
                        {

                            if (int.Parse(Parciales) > 0)
                            {
                                #region Anula parcial de cuota

                                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "AnularParcial", "/TQueries/Queries/Query");

                                query = query.Replace("%DocEntry%", DocEntryCredito);

