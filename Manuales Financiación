                query = query.Replace("%VlrInPen%", OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, VlrPendiInt));

                ors.DoQuery(query);

                ((SAPbouiCOM.EditText)Form.Items.Item("Ed_VlrTCa").Specific).Value = VlrPendiCap.ToString();

                ((SAPbouiCOM.EditText)Form.Items.Item("Ed_VlrTIn").Specific).Value = VlrPendiInt.ToString();

                //Cambia cuotas pendientes
                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "ActualizarCuotaPendientesDespuesCancelacionFactura", "/TQueries/Queries/Query");

                query = query.Replace("%DocEntry%", credito);

                ors.DoQuery(query);

                //Obtener valor total condonacion
                query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "obtenerTotalCondonado", "/TQueries/Queries/Query");

                query = query.Replace("%docentry%", credito);

                ors.DoQuery(query);

