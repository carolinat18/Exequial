        public static void AddLine(SAPbouiCOM.Form oForm, string matrixUID, string dbDataSourceUID)
        {
            if (oForm.Mode != BoFormMode.fm_FIND_MODE)
            {
                oForm.Freeze(true);

                //FRC 20160905 Se pasa para arriba Cambio de estado del form para evitar error al cargar línea
                if (oForm.Mode != BoFormMode.fm_ADD_MODE)
                    oForm.Mode = BoFormMode.fm_UPDATE_MODE;

                Item oItem = oForm.Items.Item(matrixUID);
                Matrix oMtx = (Matrix)oItem.Specific;

                //Limpia el DBDataSource de la matriz
                oForm.DataSources.DBDataSources.Item(dbDataSourceUID).Clear();

                // Añade la línea
                int rowCount = oMtx.RowCount;
                oMtx.AddRow(1, rowCount);

                //Selecciona la fila añadida
                oMtx.SelectRow(1 + rowCount, true, false);

                //FRC 20160905 Se comenta ya que no se está utilizando y posiblemente generaba error al adicionar la línea
                //Pone el número de la fila en la columna #
                //((EditText)oMtx.Columns.Item(0).Cells.Item(oMtx.RowCount).Specific).Value = oMtx.RowCount.ToString();

                //FRC 20160905 Se pasa este bloque para la parte superior, después del primer If
                //if (oForm.Mode != BoFormMode.fm_ADD_MODE)
                //    oForm.Mode = BoFormMode.fm_UPDATE_MODE;

                oForm.Freeze(false);
            }
        }

