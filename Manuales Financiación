        private void FuncActualizarPagocancelado(string strDocNum, string strSerie)
        {
            string sttempo = string.Empty;
            string stSiAbono = "N";
            Consultas oConsulta = new Consultas(sapCompany, this.StrPath, this.strTipoServer);
            string strQuery = oConsulta.QryPagoCanceladoDocNumSerie(strDocNum, strSerie);
            SAPbobsCOM.Recordset oRsT = null;
            SAPbobsCOM.Recordset oRsPagPar = null; // Objeto para recorrer pagos parciales a anular
            oConsulta.EjecutarConsulta(ref oRsT, strQuery);
            if (oRsT.RecordCount > 0)
            {
                if (oRsT.Fields.Item(0).Value.ToString().Trim().Equals("Y"))
                {
                    strQuery = oConsulta.QryDatosCreditoSiAbonoCapital(strDocNum, strSerie);
                    oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                    sttempo = oRsT.Fields.Item(0).Value.ToString().Trim();
                    stSiAbono = oRsT.Fields.Item(1).Value.ToString().Trim();


                    strQuery = oConsulta.QryActualizarInformacionPagosCreditoCanceladoIdPagoSerie(strDocNum, strSerie);
                    oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                    // Se Consulta el valor de capital a devolver
                    strQuery = oConsulta.QryCreditoVlrCapitalPagoReEstandarNumPagserie(strDocNum, strSerie);
                    oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                    string strIdCred = oRsT.Fields.Item(0).Value.ToString().Trim();
                    double dbVlrCapDevol = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRsT.Fields.Item(1).Value);
                    double dbVlrICtDevol = OK1.SBO.Helpers.DoubleFromDBDataSource(sapCompany, oRsT.Fields.Item(2).Value);


                    if (!stSiAbono.Equals("Y"))
                    {

                        //Se asignan las variables
                        strQuery = oConsulta.QryActualizarSaldoAcreedorPagoReEstandarResta(strIdCred, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrCapDevol));
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                        //Se agrega parametro de lavor de capital a devolver
                        strQuery = oConsulta.QryActualizarCapitalCancelacionPagoRecibidoAbonoCapital(strDocNum, strSerie, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrCapDevol));
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                        strQuery = oConsulta.QryActualizarCapitalCancelacionPagoRecibidoAbonoCapital_E2(strDocNum, strSerie);
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                    }


                    if (stSiAbono.Equals("Y"))
                    {
                        strQuery = oConsulta.QryRecostruccionTablaAnteriorAbonoCapitalCancelacion(sttempo);
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                        // Se agrega parametro de lavor de capital a devolver
                        if (dbVlrCapDevol > 0)
                        {
                            strQuery = oConsulta.QryActualizarCapitalCancelacionPagoRecibidoAbonoCapital(strDocNum, strSerie, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(this.sapCompany, dbVlrCapDevol));
                            oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                        }

                        strQuery = oConsulta.QryActualizarCapitalCancelacionPagoRecibidoAbonoCapital_E1(strDocNum, strSerie);
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);

                        strQuery = oConsulta.QryActualizarCapitalCancelacionPagoRecibidoAbonoCapital_E2(strDocNum, strSerie);
                        oConsulta.EjecutarConsulta(ref oRsT, strQuery);
                    }

                    //Si la cuota afectada tuvo pagos parciales
                    oConsulta.EjecutarConsulta(ref oRsPagPar, oConsulta.QryBuscarPagoParcialporRecibo(strDocNum));
                    if (oRsPagPar.RecordCount > 0)
                    {
                        oRsPagPar.MoveFirst();

                        while (!oRsPagPar.EoF)
                        {
                            string strNroTabla = oRsPagPar.Fields.Item(0).Value.ToString();
                            string strNroCuota = oRsPagPar.Fields.Item(1).Value.ToString();
                            string strDocEntry = oRsPagPar.Fields.Item(2).Value.ToString();

                            string strLineId = oRsPagPar.Fields.Item(3).Value.ToString();
                            string strNroAddIn = oRsPagPar.Fields.Item(4).Value.ToString();

                            oConsulta.EjecutarConsulta(ref oRsT, oConsulta.QryAnularPagoParcial(strDocEntry, strLineId));
                            oConsulta.EjecutarConsulta(ref oRsT, oConsulta.QryMostrarPagosParciales(strDocEntry, strNroTabla, strNroCuota));
                            if (oRsT.RecordCount > 0)
                            {
                                oRsT.MoveLast();

                                #region cambio por consulta pagos parciales

                                strLineId = oRsT.Fields.Item(0).Value.ToString();
                                #endregion

                                oConsulta.NEW_ActualizarCuotaPagoParcial(sapCompany, strDocEntry, strLineId, strNroTabla, strNroCuota);
                            }
                            else
                            {
                                oConsulta.NEW_ActualizarCuotaPagoParcialA0(sapCompany, strDocEntry, strLineId, strNroTabla, strNroCuota);
                            }

                            oRsPagPar.MoveNext();
                        }
                    }

                }
            }
        }

