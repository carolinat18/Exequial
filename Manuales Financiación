                    query = OK1.Generic.Helpers.configParteConsulta(path + @"AddInQueries\Queries_HANA.xml", "actualizarTotalCondonado", "/TQueries/Queries/Query");

                    query = query.Replace("%docentry%", credito);

                    query = query.Replace("%condonado%", ors.Fields.Item("VALOR").Value.ToString());

                    ors.DoQuery(query);
                }
