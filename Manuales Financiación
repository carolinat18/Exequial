        /// <summary>
        /// Genera el Asiento contable al pasar el crédito a estado Activo
        /// </summary>
        /// <param name="oForm">Instancia al Objeto Formulario</param>
        /// <returns></returns>
        public bool RegistrarAsiento(SAPbouiCOM.Form oForm)
        {
            bool blResultado = false;
            SAPbobsCOM.JournalEntries oJE = null;
            DateTime dtFechaReg;
            int iDocEntry;
            double dbValorCredito = 0;
            double dbValorGastos = 0;
            string stSql = string.Empty;
            string strSolicitante = "";
            SAPbobsCOM.Recordset oRs = null;
            FuncionesGenerales oFG = new FuncionesGenerales(sapCompany, this.StrPath, this.strTipoServer);
            oRs = (SAPbobsCOM.Recordset)this.sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

            try
            {
                dbValorCredito = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oForm.Items.Item("Ed_VlCre").Specific).Value.ToString());
                dbValorGastos = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oForm.Items.Item("Ed_SegV").Specific).Value.ToString());
                strSolicitante = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_Solic").Specific).Value.ToString();
                oJE = (SAPbobsCOM.JournalEntries)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.oJournalEntries);
                dtFechaReg = DateTime.Now;
                iDocEntry = int.Parse(((SAPbouiCOM.EditText)oForm.Items.Item("3").Specific).Value.ToString());
                oJE.ReferenceDate = dtFechaReg;
                oJE.DueDate = dtFechaReg;
                oJE.TaxDate = dtFechaReg;
                oJE.TransactionCode = "RFIN";
                oJE.ProjectCode = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_Proyec").Specific).Value.ToString();
                oJE.Reference2 = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_DocNum").Specific).Value.ToString();
                oJE.Memo = "CRE - " + ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_DocNum").Specific).Value.ToString();

                //oJE.Lines.AccountCode = FuncionesGenerales.ObtenerCuentasGenerales(FuncionesGenerales.GetStringValue(CreditosFinanciacion.ClaseCuenta.Capital), sapCompany);
                //oJE.Lines.AccountCode = FuncionesGenerales.ObtenerCuentasGenerales(FuncionesGenerales.GetStringValue(CreditosFinanciacion.ClaseCuenta.OrdenDeCapital), sapCompany);
                oJE.Lines.AccountCode = oFG.ObtenerCuentasGenerales(oFG.GetStringValue(CreditosFinanciacion.ClaseCuenta.Capital));
                oJE.Lines.Debit = dbValorCredito;
                oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = strSolicitante;
                oJE.Lines.ProjectCode = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_Proyec").Specific).Value.ToString();
                oJE.Lines.Add();
                //Segunda linea del JE es la contrapartida que es la que esta conf en aquerencias
                oJE.Lines.ShortName = strSolicitante;
                //stSql = Consultas.QryCuentaSNPago(strSolicitante.Trim(), this.strPath);
                //Consultas.EjecutarConsulta(ref oRs, stSql, this.sapCompany);
                //oJE.Lines.AccountCode = oRs.Fields.Item(0).Value.ToString();
                oJE.Lines.AccountCode = oFG.ObtenerCuentasGenerales(oFG.GetStringValue(CreditosFinanciacion.ClaseCuenta.PasarPago));
                oJE.Lines.Credit = dbValorCredito;
                oJE.Lines.UserFields.Fields.Item("U_InfoCo01").Value = "";
                oJE.Lines.ProjectCode = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_Proyec").Specific).Value.ToString();
                int iErrorJE = oJE.Add();
                if (iErrorJE == 0)
                {
                    long strKey = Convert.ToInt32(sapCompany.GetNewObjectKey());
                    ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_CredAct").Specific).Value = strKey.ToString();
                    oForm.Mode = BoFormMode.fm_UPDATE_MODE;
                    oForm.Items.Item("1").Click(BoCellClickType.ct_Regular);
                    blResultado = true;
                }
                else
                {
                    sapApplication.StatusBar.SetText("No se pudo crear el Asiento Contable. " + sapCompany.GetLastErrorDescription(), BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                    blResultado = false;
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "Financiacion", "AF0003-RegistroAsiento", sapCompany);
                blResultado = false;
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oJE);
                OK1.SBO.Helpers.LiberarCOM(oRs);
            }
            return blResultado;
        }

        /// <summary>
        /// Valida si todos los documentos registrados tiene la marca de Entregados
        /// </summary>
        /// <param name="oForm">Instancia al Objeto Formulario</param>
        /// <returns></returns>
        public bool ValidarDocumentos(SAPbouiCOM.Form oForm)
        {
            bool blResultado = true;
            SAPbouiCOM.Matrix oMatrix = null;
            SAPbouiCOM.ComboBox oComboDoc = null;
            SAPbouiCOM.CheckBox oChk = null;
            oMatrix = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_6").Specific;
            int iCant = 0;
            if (oMatrix.RowCount > 0)
            {
                for (int i = 1; i <= oMatrix.RowCount; i++)
                {
                    oComboDoc = (SAPbouiCOM.ComboBox)oMatrix.Columns.Item("col_0").Cells.Item(i).Specific;
                    if (oComboDoc.Selected != null)
                    {
                        if (!(oComboDoc.Selected.Value.ToString().Equals("0") || oComboDoc.Selected.Value.ToString().Equals("")))
                        {
                            oChk = (SAPbouiCOM.CheckBox)oMatrix.Columns.Item("col_1").Cells.Item(i).Specific;
                            if (!oChk.Checked)
                            {
                                iCant++;
                            }
                        }
                    }
                }
            }
            if (iCant > 0)
            {
                blResultado = false;
            }
            return blResultado;
        }

