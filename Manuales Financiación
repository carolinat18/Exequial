                    }
                    while (blBand && iCont < oGralDC.Count)
                    {
                        strCuota = oGralDC.Item(iCont).GetProperty("U_NroCuot").ToString();
                        strTabla = oGralDC.Item(iCont).GetProperty("U_NroTabla").ToString();
                        if (strCuota.Equals((iNroCuota).ToString()) && strTabla.Equals(iTabla.ToString()))
                        {
                            SAPbobsCOM.Recordset oRecorset = ((SAPbobsCOM.Recordset)(this.oCmp.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset)));
