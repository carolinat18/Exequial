        /// <summary>Encriptar usando el algoritmo TripleDES con una clave y un vector inicial (IV)</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="Mensaje">Mensaje a encriptar</param>
        /// <returns>Mensaje encriptado</returns>
        public static string Encriptar(SAPbobsCOM.Company sapCompany, string Mensaje)
        {

            try
            {
                byte[] keyBytes = Encoding.UTF8.GetBytes("EstaEsUnaClave16");

                using (Aes aesAlg = Aes.Create())
                {
                    aesAlg.Key = keyBytes;
                    aesAlg.GenerateIV();

                    ICryptoTransform encryptor = aesAlg.CreateEncryptor(aesAlg.Key, aesAlg.IV);
                    byte[] encryptedBytes;

                    using (var ms = new System.IO.MemoryStream())
                    {
                        using (var cs = new CryptoStream(ms, encryptor, CryptoStreamMode.Write))
                        {
                            byte[] valueBytes = Encoding.UTF8.GetBytes(Mensaje);
                            cs.Write(valueBytes, 0, valueBytes.Length);
                        }

                        encryptedBytes = ms.ToArray();
                    }

                    byte[] ivBytes = aesAlg.IV;

                    byte[] combinedBytes = new byte[ivBytes.Length + encryptedBytes.Length];
                    Array.Copy(ivBytes, 0, combinedBytes, 0, ivBytes.Length);
                    Array.Copy(encryptedBytes, 0, combinedBytes, ivBytes.Length, encryptedBytes.Length);

                    return Convert.ToBase64String(combinedBytes);
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "Encriptar", sapCompany);
                return null;
            }
            finally
            {
                GC.Collect();
            }


        }

        /// <summary>Desencriptar usando cifrado simetrico AES </summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="mensajeEncriptado">Array de bytes con el mensaje encriptado</param>
        /// <returns>Mensaje desencriptado</returns>
        public static string Desencriptar(SAPbobsCOM.Company sapCompany, string mensajeEncriptado)
        {

            try
            {

                byte[] combinedBytes = Convert.FromBase64String(mensajeEncriptado);
                byte[] keyBytes = Encoding.UTF8.GetBytes("EstaEsUnaClave16");
                byte[] ivBytes = new byte[16];

                Array.Copy(combinedBytes, 0, ivBytes, 0, ivBytes.Length);
                byte[] encryptedBytes = new byte[combinedBytes.Length - ivBytes.Length];
                Array.Copy(combinedBytes, ivBytes.Length, encryptedBytes, 0, encryptedBytes.Length);

                using (Aes aesAlg = Aes.Create())
                {
                    aesAlg.Key = keyBytes;
                    aesAlg.IV = ivBytes;

                    ICryptoTransform decryptor = aesAlg.CreateDecryptor(aesAlg.Key, aesAlg.IV);
                    byte[] decryptedBytes;

                    using (var ms = new System.IO.MemoryStream())
                    {
                        using (var cs = new CryptoStream(ms, decryptor, CryptoStreamMode.Write))
                        {
                            cs.Write(encryptedBytes, 0, encryptedBytes.Length);
                        }

                        decryptedBytes = ms.ToArray();
                    }

                    return Encoding.UTF8.GetString(decryptedBytes);
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "Desencriptar", sapCompany);
                return string.Empty;
            }
            finally
            {
                GC.Collect();
            }
        }

        /// <summary>Identifica los pagos migrados realizados por Consensus</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="Path">Ruta</param>
        public static void IdentificadorPagosMigrados(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string Path)
        {
            SAPbobsCOM.Recordset oRecordSetSelect = null;

            SAPbobsCOM.Recordset oRecordSetUpdate = null;

            try
            {

                oRecordSetSelect = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                oRecordSetUpdate = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                string query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerMigradosCuotaTotal", "/TQueries/Queries/Query");

                oRecordSetSelect.DoQuery(query);

                if (oRecordSetSelect.RecordCount > 0)
                {

                    while (!oRecordSetSelect.EoF)
                    {

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "GuardarIdentificadorMigracionCuotaTotal", "/TQueries/Queries/Query");

                        query = query.Replace("%ValorEncriptado%", Encriptar(sapCompany, oRecordSetSelect.Fields.Item("U_DTW").Value.ToString()));

                        query = query.Replace("%DocEntry%", oRecordSetSelect.Fields.Item("DocEntry").Value.ToString());

                        query = query.Replace("%Cuota%", oRecordSetSelect.Fields.Item("U_NroCuot").Value.ToString());

                        oRecordSetUpdate.DoQuery(query);

                        oRecordSetSelect.MoveNext();
                    }

                }


                query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerMigradosCuotaParcial", "/TQueries/Queries/Query");

                oRecordSetSelect.DoQuery(query);

                if (oRecordSetSelect.RecordCount > 0)
                {

                    while (!oRecordSetSelect.EoF)
                    {

                        query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "GuardarIdentificadorMigracionCuotaParcial", "/TQueries/Queries/Query");

                        query = query.Replace("%ValorEncriptado%", Encriptar(sapCompany, oRecordSetSelect.Fields.Item("U_DTW").Value.ToString()));

                        query = query.Replace("%DocEntry%", oRecordSetSelect.Fields.Item("DocEntry").Value.ToString());

                        query = query.Replace("%Cuota%", oRecordSetSelect.Fields.Item("U_NroCuot").Value.ToString());

                        query = query.Replace("%Linea%", oRecordSetSelect.Fields.Item("LineId").Value.ToString());

                        oRecordSetUpdate.DoQuery(query);

                        oRecordSetSelect.MoveNext();
                    }

                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "IdentificadorPagosMigrados", sapCompany);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSetUpdate);
                OK1.SBO.Helpers.LiberarCOM(oRecordSetSelect);
                GC.Collect();
            }

        }

