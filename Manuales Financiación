                                        oConsulta.EjecutarConsulta(ref oRsT, oConsulta.QryMostrarPagosParciales(strDocEntry, strNroTabla, strNroCuota));
                                        #endregion

                                        oRsT.MoveLast();
                                        oRsT.MovePrevious();

                                        #region 3.2.3 anular pago parcial en lineas 8
                                        oConsulta.EjecutarConsulta(ref oRsTAnul, oConsulta.QryAnularPagoParcial(strDocEntry, strLineId));
                                        strLineId = oRsT.Fields.Item(0).Value.ToString();
                                        #endregion

