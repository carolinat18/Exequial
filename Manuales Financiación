        public static double redondeo(double vlrRedondear)
        {
            double vlrRedondeado = 0d;
            long d1, d2, ValRedon = 0;
            int ParteInt;
            bool validar = false;
            ParteInt = (int)vlrRedondear;

            if (ParteInt > 1000)
            {
                string valint = ParteInt.ToString();

                Int64[] valor = new long[valint.Length];

                for (int i1 = 0; i1 < valint.Length; i1++)
                {
                    Int64.TryParse(valint[i1].ToString(), out d1);
                    valor[i1] = d1;

                }

                d1 = valor[valint.Length - 4];
                d2 = valor[valint.Length - 3];

                if (d2 >= 5)
                {
                    for (int i = (valint.Length - 3); i < valint.Length; i++)
                    {
                        valor[i] = 0;
                    }

                    d1 = d1 + 1;
                    validar = true;
                }
                else
                {
                    for (int i = (valint.Length - 3); i < valint.Length; i++)
                    {
                        valor[i] = 0;
                    }

                    validar = false;
                }

                if (validar)
                {
                    if (d1 < 10)
                    {
                        valor[valint.Length - 4] = d1;
                    }
                    else
                    {
                        int i1 = valor.Length - 5;

                        if (i1 > 0)
                        {
                            valor[valint.Length - 4] = 0;

                            if ((i1 - 1) >= 0)
                                valor[i1] = valor[i1] + 1;
                        }
                        else
                        {
                            valor[valint.Length - 4] = d1;
                        }

                        bool continuar = true;

                        while (continuar && i1 >= 0)
                        {
                            if (valor[i1] >= 10)
                            {
                                if ((i1 - 1) >= 0)
                                {
                                    valor[i1] = 0;
                                    valor[i1 - 1] = valor[i1 - 1] + 1;
                                }

                                i1--;
                            }
                            else
                            {
                                //valor[i1] = valor[i1];
                                continuar = false;
                            }
                        }

                        //if ((double)ValRedon > vlrRedondear)
                        //{
                        //    vlrRedondeado = (double)ValRedon - vlrRedondear;
                        //}
                        //else
                        //{
                        //    vlrRedondeado = vlrRedondear - (double)ValRedon;
                        //    vlrRedondeado = vlrRedondeado * -1;
                        //}
                    }
                }

                for (int i2 = 1; i2 <= valor.Length; i2++)
                {
                    d1 = valor[i2 - 1];
                    d2 = d1 * (long)(Math.Pow(10, (valor.Length) - i2));
                    ValRedon += d2;
                }

                vlrRedondeado = ValRedon;

            }
            else if (ParteInt >= 500 && ParteInt <= 1000)
            {
                vlrRedondeado = 1000;
            }
            else if (ParteInt < 500)
            {
                vlrRedondeado = 0;
            }

            return vlrRedondeado;
        }

