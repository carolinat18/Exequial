        /// <summary>Obtiene boletas con reconciliacion pendiente en un credito especifico</summary>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="Path">Ruta</param>
        /// <param name="oFormCredito">Formulario credito</param>
        public static void CargarBoletasAbiertas(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string Path, SAPbouiCOM.Form oFormCredito)
        {
            SAPbobsCOM.Recordset oRecordSet = null;

            try
            {
                SAPbouiCOM.Grid oGrid = ((SAPbouiCOM.Grid)(oFormCredito.Items.Item("oGrid").Specific));

                oGrid.SelectionMode = BoMatrixSelect.ms_None;

                SAPbouiCOM.DataTable oDataTable = oFormCredito.DataSources.DataTables.Item("oDataTable");

                string Query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerBoletasAbiertasCredito", "/TQueries/Queries/Query");

                string NumeroCredito = ((SAPbouiCOM.EditText)oFormCredito.Items.Item("Ed_DocNum").Specific).Value.ToString();

                if (string.IsNullOrEmpty(NumeroCredito))
                {
                    NumeroCredito = "0";
                }

                Query = Query.Replace("%DocNum%", NumeroCredito);

                oDataTable.ExecuteQuery(Query);

                Query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerBoletasAbiertasManuales", "/TQueries/Queries/Query");

                Query = Query.Replace("%DocNum%", NumeroCredito);

                string Boletas = "";

                for (int i = 0; i < oDataTable.Rows.Count; i++)
                {

                    Boletas = Boletas + oDataTable.GetValue(2, i) + ",";

                }

                if (Boletas.Length > 0)
                {
                    Boletas = Boletas.Substring(0, Boletas.Length - 1);
                }
                else
                {
                    Boletas = "0";
                }

                Query = Query.Replace("%Boletas%", Boletas);

                oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                oRecordSet.DoQuery(Query);

                oGrid.DataTable = oDataTable;

                if (oRecordSet.RecordCount > 0)
                {
                    bool Valores = true;

                    if (oDataTable.GetValue(1, 0).ToString().Equals("0") && oDataTable.GetValue(0, 0).ToString().Equals("0"))
                    {
                        Valores = false;
                    }

                    int newRow = 0;

                    while (!oRecordSet.EoF)
                    {

                        if (Valores)
                        {
                            newRow = oGrid.DataTable.Rows.Count;

                            oGrid.DataTable.Rows.Add();
                        }


                        oDataTable.SetValue(1, newRow, "-1");

                        oDataTable.SetValue(2, newRow, oRecordSet.Fields.Item("DocEntry").Value.ToString());

                        oDataTable.SetValue(3, newRow, oRecordSet.Fields.Item("DocNum").Value.ToString());

                        oDataTable.SetValue(7, newRow, oRecordSet.Fields.Item("DocTotal").Value.ToString());

                        oRecordSet.MoveNext();

                        newRow++;

                        Valores = true;
                    }

                }

                oGrid.Columns.Item(0).TitleObject.Caption = "Pago Addin";

                ((SAPbouiCOM.EditTextColumn)oGrid.Columns.Item(0)).LinkedObjectType = "OK1_FINAN_PAGO";

                oGrid.Columns.Item(1).TitleObject.Caption = "Numero cuota";

                oGrid.Columns.Item(2).TitleObject.Caption = "Clave factura";

                ((SAPbouiCOM.EditTextColumn)oGrid.Columns.Item(2)).LinkedObjectType = "13";

                oGrid.Columns.Item(3).TitleObject.Caption = "Numero factura";

                oGrid.Columns.Item(4).TitleObject.Caption = "Aplicado capital";

                oGrid.Columns.Item(5).TitleObject.Caption = "Aplicado interes";

