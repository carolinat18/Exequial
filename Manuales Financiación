            this.EjecutarConsulta(ref oRset, strQry);

            strQry = string.Empty;

            if (oRset.RecordCount > 0)
            {
                strOrigen = oRset.Fields.Item(0).Value.ToString().Trim();                

                strQry = OK1.Generic.Helpers.configParteConsulta(this.StrPath + @"AddInQueries\Queries_" + this.TipoServerSQL.Trim() + ".xml", "ConsultarVlrPendPago", "/TQueries/Queries/Query");
                strQry = strQry.Replace("%strDocEntry%", strDocEntry);
                strQry = strQry.Replace("%strTabla%", strTabla);

                if (!strOrigen.Equals("O"))
                {
                    if (this.TipoServerSQL.Trim().Equals("HANA"))
                    {
                        strQry += " AND IFNULL(\"U_EntrPago\", 0) != 0 AND \"U_Factura\" = 'Y' ";
                    }
                    else
                    {
                        strQry += " AND ISNULL(\"U_EntrPago\", 0) != 0 AND \"U_Factura\" = 'Y' ";
                    }
                }
            }

            OK1.SBO.Helpers.LiberarCOM(oRset);

            return strQry;
        }

