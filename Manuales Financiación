        public static void actualizarPagadoCreditoCuotas(SAPbouiCOM.Form oForm, SAPbobsCOM.Company ocmp, string DocEntryCredito, string strPath)
        {

            int indice = 0;
            int tope = 0;
            int fila = 1;
            string pagado = string.Empty;
            SAPbouiCOM.Matrix omtx = null;
            bool actualizarPagado = false;
            string pagadoMatrix = string.Empty;
            int numeroCuota = -1;

            try
            {
                SAPbouiCOM.DBDataSource oDBS1 = null;
                oDBS1 = (SAPbouiCOM.DBDataSource)oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN1");
                omtx = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_0").Specific;
                omtx.FlushToDataSource();
                tope = omtx.RowCount;
                while (indice < tope)
                {

                    fila = indice + 1;
                    numeroCuota = Convert.ToInt32(((SAPbouiCOM.EditText)omtx.Columns.Item("col_0").Cells.Item(fila).Specific).Value.ToString().Trim());
                    if (((SAPbouiCOM.CheckBox)omtx.Columns.Item("col_5").Cells.Item(fila).Specific).Checked)
                        pagadoMatrix = "Y";
                    else
                        pagadoMatrix = "N";

                    pagado = retornarPagadoCuotasCreditos(ocmp, strPath, DocEntryCredito, numeroCuota.ToString());
                    actualizarPagado = !pagadoMatrix.Equals(pagado);

                    try
                    {
                        if (pagado.Equals("Y") && actualizarPagado)
                            omtx.SetCellWithoutValidation(fila, "col_5", pagado.ToString().Trim());
                    }
                    catch (Exception e) { OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "actualizarPagadoCreditoCuotas", ocmp); }
                    indice++;
                }
            }
            catch (Exception e) { OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "actualizarPagadoCreditoCuotas", ocmp); }
        }

