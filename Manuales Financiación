                            iValor = Convert.ToInt32(oGralData.GetProperty("U_NroCuPen").ToString()) - 1;
                            oGralData.SetProperty("U_NroCuPen", iValor);
                        }
                        iCont++;
                    }
                    //FRC 20170126 Se quita ya que no debe pasar a prefinanciado
                    /*if (this.blModCapital && dbVlrExcedente == 0)
                    {
                        oGralData.SetProperty("U_Estado", oFG.GetStringValue(Estado.PreFinanciado));
