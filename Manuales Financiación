        public void CalcularValoresCredito(SAPbouiCOM.Form oForm)
        {
            SAPbouiCOM.EditText oEdt = null;
            string strDato = "";
            double dbTIM = 0;
            double dbVlrCred = 0;
            double dbVlrSegV = 0;
            double dbVlrBaseSV = 0;
            double dbVlrOtSeg = 0;
            int iNroCuotas = 0;
            double dbVlrCuotaIni = 0;
            double dbVlrCuota = 0;
            double dbVlrTotCuo = 0;
            string stTipCre = string.Empty;
            SAPbouiCOM.ComboBox oCb_TipCre;
            FuncionesGenerales oFG = new FuncionesGenerales(sapCompany, this.StrPath, this.strTipoServer);

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_VlCre").Specific;
            if (!oEdt.Value.Equals(""))
                dbVlrCred = OK1.SBO.Helpers.DoubleFromEditText(oEdt.Value.ToString());
            else
                dbVlrCred = 0;
            //if (pVal.ItemUID.Equals("Ed_VlCre"))
            //oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrBasSV", 0, OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrCred)));

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_BaseSV").Specific;
            if (!oEdt.Value.Equals("") && !oEdt.Value.Equals("0.0"))
                dbVlrBaseSV = OK1.SBO.Helpers.DoubleFromEditText(oEdt.Value.ToString());
            else
                dbVlrBaseSV = 0;

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_TIM").Specific;
            if (!oEdt.Value.Equals(""))
                dbTIM = OK1.SBO.Helpers.DoubleFromEditText(oEdt.Value.ToString());
            else
                dbTIM = 0;

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_NroCuo").Specific;
            if (!oEdt.Value.Equals(""))
                iNroCuotas = Convert.ToInt32(oEdt.Value.ToString());
            else
                iNroCuotas = 0;

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_VlCIn").Specific;
            //strDato = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_VlCIn").Specific).Value.ToString();
            if (!oEdt.Value.Equals(""))
                dbVlrCuotaIni = OK1.SBO.Helpers.DoubleFromEditText(strDato);
            else
                dbVlrCuotaIni = 0;

            oEdt = (SAPbouiCOM.EditText)oForm.Items.Item("Ed_OtSeg").Specific;
            if (!oEdt.Value.Equals(""))
                dbVlrOtSeg = OK1.SBO.Helpers.DoubleFromEditText(oEdt.Value.ToString());
            else
                dbVlrOtSeg = 0;

            string strTipoAmor = ((SAPbouiCOM.ComboBox)oForm.Items.Item("CboTipAmor").Specific).Selected.Value.ToString();
            if (strTipoAmor.Equals("2"))
                dbVlrCuota = ((Math.Round((dbVlrCred)) - dbVlrCuotaIni) * dbTIM) / 100;
            else
                dbVlrCuota = (Math.Round((dbVlrCred)) - dbVlrCuotaIni) * ((dbTIM / 100) * (Math.Pow((1 + (dbTIM / 100)), iNroCuotas))) / (Math.Pow((1 + (dbTIM / 100)), (iNroCuotas)) - 1);

            try
            {
                oCb_TipCre = (SAPbouiCOM.ComboBox)oForm.Items.Item("CboTipCred").Specific;
                stTipCre = oCb_TipCre.Selected.Value.ToString().Trim();
            }
            catch
            {
                stTipCre = string.Empty;
            }

            dbVlrSegV = ((dbVlrBaseSV * oFG.ObtenerPrcSeguroVida(stTipCre)) / 100);

            //if (pVal.ItemUID.Equals("Ed_VlCre"))
            //dbVlrBaseSV = FuncionesGenerales.redondeo(dbVlrBaseSV);
            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrBasSV", 0, OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrBaseSV)));
            //dbVlrCuota = FuncionesGenerales.redondeo(dbVlrCuota);
            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrCuota", 0, OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrCuota)));
            //dbVlrSegV = FuncionesGenerales.redondeo(dbVlrSegV);
            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrSegV", 0, OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrSegV)));

            dbVlrTotCuo = dbVlrCuota + dbVlrSegV + dbVlrOtSeg;

            //dbVlrTotCuo = FuncionesGenerales.redondeo(dbVlrTotCuo);
            oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_HEAD").SetValue("U_VlrTCuot", 0, OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrTotCuo)));
            //((EditText)oForm.Items.Item("Ed_BaseSV").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrCred));
            //((EditText)oForm.Items.Item("Ed_VlCMe").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrCuota));
            //((EditText)oForm.Items.Item("Ed_SegV").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrSegV));
            //((EditText)oForm.Items.Item("Ed_VlTCu").Specific).Value = OK1.SBO.Helpers.DoubleToDBDataSourceTarifa(sapCompany, Math.Round(dbVlrTotCuo));
        }

