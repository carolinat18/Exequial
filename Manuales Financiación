                oGeneralParams.SetProperty("DocEntry", credito);

                oGeneralData = oGeneralService.GetByParams(oGeneralParams);

                oChildren = oGeneralData.Child("OK1_FINAN_CRED_LIN1");

                for (int i = 0; i < oChildren.Count; i++)
                {

                    int validacion_0 = int.Parse(oChildren.Item(i).GetProperty("U_NroPagoAddin").ToString());
                    int validacion_1 = int.Parse(oChildren.Item(i).GetProperty("U_EntrPago").ToString());
                    string tipo = "";
                    if (validacion_0 > 0)
                    {
                        tipo = "Pago Addin";
                        oChildren.Item(i).SetProperty("U_tipoPago", tipo);

                    }
                    else
                    {
                        if (validacion_0 == 0 && validacion_1 != 0)
                        {
                            tipo = "Pago Masivo";
                            oChildren.Item(i).SetProperty("U_tipoPago", tipo);

                        }
                        else
                        {
                            string condonada = oChildren.Item(i).GetProperty("U_Motivo").ToString().Trim();
                            if (condonada.Length > 0)
                            {
                                tipo = "Pago Condonado";
                                oChildren.Item(i).SetProperty("U_tipoPago", tipo);

                            }
                            else
                            {
                                if (oChildren.Item(i).GetProperty("U_Pagado").Equals("Y") || !oChildren.Item(i).GetProperty("U_PagosPar").ToString().Equals("0"))
                                {
                                    if (i == 0)
                                    {
                                        if (CuotaTipoCambio(sapCompany, sapApplication, oGeneralData.GetProperty("U_NoPrenec").ToString(), Path))
                                        {
                                            tipo = "Anticipo por Cambio";
                                            oChildren.Item(i).SetProperty("U_tipoPago", tipo);

                                        }
                                        else
                                        {
                                            if (Desencriptar(sapCompany, oChildren.Item(i).GetProperty("U_DTW").ToString()).Equals("MigracionesCSS"))
                                            {
                                                tipo = "Pago Migrado";
                                                oChildren.Item(i).SetProperty("U_tipoPago", tipo);
                                            }
                                            else
                                            {
                                                tipo = "Pago Invalido";
                                                oChildren.Item(i).SetProperty("U_tipoPago", tipo);
                                            }

                                        }

                                    }
                                    else
                                    {

                                        if (Desencriptar(sapCompany, oChildren.Item(i).GetProperty("U_DTW").ToString()).Equals("MigracionesCSS"))
                                        {
                                            tipo = "Pago Migrado";
                                            oChildren.Item(i).SetProperty("U_tipoPago", tipo);
                                        }
                                        else
                                        {
                                            tipo = "Pago Invalido";
                                            oChildren.Item(i).SetProperty("U_tipoPago", tipo);
                                        }
                                    }




                                }
                                else
                                {
                                    tipo = "";
                                    oChildren.Item(i).SetProperty("U_PagosPar", "");
                                    oChildren.Item(i).SetProperty("U_tipoPago", tipo);
                                }
                            }

                        }
                    }
                    if (!masivo)
                    {
                        ((SAPbouiCOM.EditText)(oMatrix.Columns.Item("T_pago").Cells.Item(i + 1).Specific)).Value = tipo;

                    }
                    oGeneralService.Update(oGeneralData);
                }



                return "OK";

