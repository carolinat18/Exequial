        /// <summary>Validaciones previas a la creacion de un pago tipo 7 (Vinculado</summary>
        /// <param name="sapApplication">Aplicacion SAP</param>
        /// <param name="sapCompany">Compañia SAP</param>
        /// <param name="Path">Ruta</param>
        /// <param name="oFormFinanPagos">Formulario generacion de pagos</param>
        /// <param name="ComboTipoPago">Combo del tipo pago en genracion de pagos</param>
        /// <param name="ErrorValidacion">False si no paso una validacion</param>
        /// <param name="Sucursal">Sucursal</param>
        /// <returns>True si pasa todas las validaciones</returns>
        public static bool validacionesPagoVinculadoRC(SAPbouiCOM.Application sapApplication, SAPbobsCOM.Company sapCompany, string Path, SAPbouiCOM.Form oFormFinanPagos, SAPbouiCOM.ComboBox ComboTipoPago, bool ErrorValidacion, ref int Sucursal)
        {

            SAPbobsCOM.Recordset oRecordSet = null;
            string query = "";
            try
            {
                if ((ComboTipoPago.Selected.Value.Equals("7") || ComboTipoPago.Selected.Value.Equals("8")) && ErrorValidacion)
                {
                    string ComboDocumentoVinculado = ((SAPbouiCOM.ComboBox)oFormFinanPagos.Items.Item("OKEddocVi").Specific).Selected.Value.ToString().Trim();

                    string NumeroDocumento = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("Ed_NroPag").Specific).Value.ToString().Trim();

                    if (!string.IsNullOrEmpty(NumeroDocumento))
                    {
                        if (ComboDocumentoVinculado.Equals("PR"))
                        {
                            oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                            query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ValidacionRecibosCaja", "/TQueries/Queries/Query");

                            query = query.Replace("%docnum%", oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString());

                            oRecordSet.DoQuery(query);

                            Sucursal = Convert.ToInt32(oRecordSet.Fields.Item("BPLId").Value);

                            string EstadoRC = oRecordSet.Fields.Item("U_FinanEstadoAnular").Value;

                            if (!EstadoRC.Equals("R"))
                            {
                                string valorRC = FuncionesGenerales.DoubleToDBDataSource(sapCompany, oRecordSet.Fields.Item("OpenBal").Value, true, "$", 2, "HANA");

                                if (valorRC.Equals("0"))
                                {
                                    sapApplication.SetStatusBarMessage("Debe indicar un recibo de caja con saldo", BoMessageTime.bmt_Short, true);
                                    sapApplication.MessageBox("Debe indicar un recibo de caja con saldo", 1, "Aceptar", "", "");
                                    ErrorValidacion = false;
                                }

                            }
                            else
                            {
                                string ValorCliente = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value;
                                string ValorRecibo = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("ValorRC").Specific).Value;
                                if (OK1.SBO.Helpers.DoubleFromEditText(ValorCliente) != OK1.SBO.Helpers.DoubleFromEditText(ValorRecibo))
                                {
                                    sapApplication.SetStatusBarMessage("El recibo de caja seleccionado no permite ser vinculado parcialmente. Registre su Importe Total", BoMessageTime.bmt_Short, true);
                                    sapApplication.MessageBox("El recibo de caja seleccionado no permite ser vinculado parcialmente. Registre su Importe Total", 1, "Aceptar", "", "");
                                    ErrorValidacion = false;
                                }
                            }

                            if (ErrorValidacion)
                            {
                                query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "validarReciboCaja", "/TQueries/Queries/Query");

                                query = query.Replace("%pago%", oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString());

                                oRecordSet.DoQuery(query);

                                if (oRecordSet.RecordCount > 0)
                                {
                                    double cuenta = 0;

                                    string pagos = "-";

                                    while (!oRecordSet.EoF)
                                    {
                                        cuenta = cuenta + OK1.SBO.Helpers.DoubleFromEditText(oRecordSet.Fields.Item("U_VlrPgCli").Value.ToString());

                                        pagos = pagos + oRecordSet.Fields.Item("DocNum").Value.ToString() + "-";

                                        oRecordSet.MoveNext();
                                    }
                                    query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ObtenerDocEntryRecibo", "/TQueries/Queries/Query");

                                    query = query.Replace("%DocNum%", oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString());

                                    oRecordSet.DoQuery(query);

                                    string docEntry = oRecordSet.Fields.Item("DocEntry").Value.ToString().Trim();

                                    query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "InformacionRecibosCaja", "/TQueries/Queries/Query");

                                    query = query.Replace("%docnum%", docEntry);

                                    oRecordSet.DoQuery(query);

                                    double docTotal = OK1.SBO.Helpers.DoubleFromEditText(oRecordSet.Fields.Item("DocTotal").Value.ToString().Trim());

                                    if (cuenta >= docTotal)
                                    {

                                        sapApplication.MessageBox("El saldo del recibo de caja seleccionado ya se encuentra utilizado en los pagos NO: " + pagos, 1, "Aceptar", "Cancelar", "");
                                        ErrorValidacion = false;
                                    }
                                    else
                                    {
                                        double pago = OK1.SBO.Helpers.DoubleFromEditText(oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_VlrPgCli", 0).ToString());
                                        if ((cuenta + pago) > docTotal)
                                        {
                                            sapApplication.MessageBox("El recibo de caja seleccionado solo tiene disponible un total de : " + (cuenta - docTotal).ToString() + ", debe cambiar el valor a pagar para continuar. ", 1, "Aceptar", "Cancelar", "");
                                            ErrorValidacion = false;
                                        }

                                    }
                                }
                            }
                        }
                        else
                        {
                            oRecordSet = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);

                            query = OK1.Generic.Helpers.configParteConsulta(Path + @"AddInQueries\Queries_HANA.xml", "ValidacionRegistroDiario", "/TQueries/Queries/Query");

                            query = query.Replace("%Number%", oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").GetValue("U_NroPago", 0).ToString());

                            oRecordSet.DoQuery(query);

                            Sucursal = Convert.ToInt32(oRecordSet.Fields.Item("BPLId").Value);

                            string valorRD = FuncionesGenerales.DoubleToDBDataSource(sapCompany, oRecordSet.Fields.Item("BalDueCred").Value, true, "$", 2, "HANA");

                            if (valorRD.Equals("0"))
                            {
                                sapApplication.SetStatusBarMessage("Debe indicar un registro de diario con saldo", BoMessageTime.bmt_Short, true);
                                sapApplication.MessageBox("Debe indicar un registro de diario con saldo", 1, "Aceptar", "", "");
                                ErrorValidacion = false;
                            }


                        }

                        if (ErrorValidacion)
                        {
                            string valor_cliente = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value;

                            string valor_recibo = ((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("ValorRC").Specific).Value;

                            if (OK1.SBO.Helpers.DoubleFromEditText(valor_cliente) > OK1.SBO.Helpers.DoubleFromEditText(valor_recibo))
                            {
                                sapApplication.SetStatusBarMessage("El valor a pagar debe ser menor o igual al valor del documento a vincular", BoMessageTime.bmt_Short, true);

                                ErrorValidacion = false;

                            }
                        }

                        if (ErrorValidacion)
                        {
                            double valorCliente = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value.ToString());
                            double valorPagoTotal = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTotP").Specific).Value.ToString());
                            double valorDescuento = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrDto").Specific).Value.ToString());


                            if (valorCliente != (valorPagoTotal + valorDescuento))
                            {
                                sapApplication.SetStatusBarMessage("El valor a pagar cliente es diferente al valor total a pagar.", BoMessageTime.bmt_Short, true);
                                sapApplication.MessageBox("El valor a pagar cliente es diferente al valor total a pagar.", 1, "Aceptar", "", "");
                                ErrorValidacion = false;
                            }
                        }

                        if (ErrorValidacion && ComboTipoPago.Selected.Value.Equals("8"))
                        {
                            double valorCliente = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTC").Specific).Value.ToString());
                            double valorTotalPagar = OK1.SBO.Helpers.DoubleFromEditText(((SAPbouiCOM.EditText)oFormFinanPagos.Items.Item("edVlrTP").Specific).Value.ToString());


                            if (valorCliente != valorTotalPagar)
                            {
                                sapApplication.SetStatusBarMessage("El valor a pagar cliente es diferente al valor total a pagar.", BoMessageTime.bmt_Short, true);
                                sapApplication.MessageBox("El valor a pagar cliente es diferente al valor total a pagar.", 1, "Aceptar", "", "");
                                ErrorValidacion = false;
                            }
                        }


                        oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").SetValue("U_GenPago", 0, "N");

                    }
                    else
                    {

                        sapApplication.SetStatusBarMessage("Debe elegir un documento a vincular.", BoMessageTime.bmt_Short, true);
                        sapApplication.MessageBox("Debe elegir un documento a vincular.", 1, "Aceptar", "", "");
                        ErrorValidacion = false;

                    }


                }
                else
                {
                    oFormFinanPagos.DataSources.DBDataSources.Item("@OK1_FINAN_PAGO_HEAD").SetValue("U_GenPago", 0, "Y");
                }

                return ErrorValidacion;

            }
            catch (Exception e)
            {

                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "validacionesPagoVinculadoRC", sapCompany);
                sapApplication.MessageBox("Error procesando datos : " + e.ToString(), 1, "Aceptar", "Cancelar", "");
                return false;

            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecordSet);

            }

        }

