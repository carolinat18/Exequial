                            strDocTotal = "0";
                            oRecorset.DoQuery(strQry);
                            if (oRecorset.RecordCount > 0)
                            {
                                strNroF = oRecorset.Fields.Item("DocNum").Value.ToString();
                                strDocTotal = oRecorset.Fields.Item("DocTotal").Value.ToString();
                                this.strNroFact = strNroF;
                                this.dbVlrAPagar = OK1.SBO.Helpers.DoubleFromEditText(strDocTotal);
                                ActualizarInfoCoFacturaSeguros(iNroCuota, Convert.ToInt32(oRecorset.Fields.Item("TransId").Value.ToString()));
                                dtFecha = Convert.ToDateTime(oRecorset.Fields.Item("DocDate").Value);
                            }
                            oGralDC.Item(iCont).SetProperty("U_EntrFact", this.strDocEntryFact);
                            oGralDC.Item(iCont).SetProperty("U_NroFact", strNroF);
                            oGralDC.Item(iCont).SetProperty("U_FechaFra", dtFecha);
                            oGralDC.Item(iCont).SetProperty("U_VlrFrado", strDocTotal);
                            oGralDC.Item(iCont).SetProperty("U_Factura", "Y");
                            oGralDC.Item(iCont).SetProperty("U_VlPendCa", this.dbVlrPendCapital);
                            oGralDC.Item(iCont).SetProperty("U_VlPendInt", this.dbVlrPendIntCte);
                            oGralDC.Item(iCont).SetProperty("U_VlPendMo", this.dbVlrPendMora); //FRC 20160329 Se actualiza el valor pendiente de mora
                            oGralDC.Item(iCont).SetProperty("U_VlPendSV", this.dbVlrPendSegVida);
                            oGralDC.Item(iCont).SetProperty("U_VlPendOS", this.dbVlrPendOtrSeg);
                            oGralDC.Item(iCont).SetProperty("U_FechaPMo", this.dtFechaPago); //FRC 20160329 Se actualiza la fecha de cálculo de la mora. FRC 20160410 Se almacena la Fecha de Pago
