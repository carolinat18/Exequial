        public bool GenerarFactura(int iBranch, int Sucursal, bool blFacturar = true, CreditosFinanciacion oCredit = null, bool blUnicaFra = false, bool blPagoMasivo = false)
        {
            bool blResultado = false, blPrenec = false;
            int iError;
            double dbVlrExcedente = 0;
            double dbVlrCapitalCuota = 0d;
            double dbVlrInteresCuota = 0d;
            double dbVlrDisponibleSeguros = 0d;
            double dbVlrOtrosSeg = 0d;
            double dbVlrMora = 0d; //FRC 20160329 Parta almacenar el valor de la mora
            string strTipoFact = "", cc1 = "", cc2 = "", cc3 = "", cc4 = "";
            CreditosFinanciacionLineasAmortizacion oCuota = this.BuscarCuota(this.iTabla, this.iCuotaAPagar);
            FuncionesGenerales oFG = new FuncionesGenerales(this.oCmp, this.strPath, this.strTipoServer);

            double U_VlrPago = 0d;
            bool esvalorCargadoMigracion = false;

            esvalorCargadoMigracion = oCuota.iPagosParciales == 1 && !oCuota.blPagado && !oCuota.dbVlrPagado.Equals(0) && !oCuota.blFacturado;

            if (this.blOk)
            {
                if (!oCuota.blFacturado)
                {
                    dbVlrCapitalCuota = oCuota.dbVlrCapital;
                }
                else
                {
                    dbVlrCapitalCuota = oCuota.dbVlrPendCa;
                }
            }

            if (dbVlrCapitalCuota != 0)
            {
                if (blUnicaFra)
                {
                    this.dbVlrPendCapital = 0;
                }
                else
                {

                    if (!esvalorCargadoMigracion)

                        this.dbVlrPendCapital = (dbVlrCapitalCuota - this.dbVlrPagoCapital);

                    else
                        this.dbVlrPendCapital = (dbVlrCapitalCuota - this.dbVlrPagoCapital - oCuota.dbVlrPagado);

                    if (this.dbVlrPendCapital < 0)
                    {
                        this.dbVlrPendCapital = 0;
                    }
                }
            }

            if (!oCuota.blFacturado)
            {
                dbVlrInteresCuota = oCuota.dbVlrIntereses;
            }
            else
            {
                if (oCuota.dbVlrPendInt != 0)
                {
                    dbVlrInteresCuota = oCuota.dbVlrPendInt;
                }
                else
                {
