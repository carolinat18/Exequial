                        sw.WriteLine(" InfoSys: " + metodo);
                        sw.Write(" Info: " + mensajeError);
                        sw.WriteLine(" Tiempo : " + elapsedTime);
                        sw.WriteLine("====================================");
                        sw.Close();
                        stopwatch.Stop();

                    }
                    catch (SecurityException s)
                    {
                        Console.WriteLine(s.Message);
                    }
                }
            }
            catch (Exception ex)
            {
                string strEx = ex.Message + "-" + ex.StackTrace + "-" + ex.InnerException;
            }
            finally
            {

            }
