                        #endregion

                        break;


                }
            }
            catch (Exception er)
            {
                throw new OK1.ExceptionManager.GenericException(this.rmManager.GetString("strGenericError") + er.Message);
            }
        }

        private void CrearMenuActualizarValorPago()
        {
            SAPbouiCOM.Menus oMenus = null;
            SAPbouiCOM.MenuItem oMenuItem = null;
            SAPbouiCOM.MenuCreationParams oCreationPackage = null;

            oCreationPackage = ((SAPbouiCOM.MenuCreationParams)(sapApplication.CreateObject(SAPbouiCOM.BoCreatableObjectType.cot_MenuCreationParams)));
            // Get the menu collection of the newly added item
            oMenuItem = sapApplication.Menus.Item("OK1_FINAN_PARAM_MENU");
            oMenus = oMenuItem.SubMenus;

            // Creates sub menu
            oCreationPackage.Type = SAPbouiCOM.BoMenuType.mt_STRING;
            oCreationPackage.UniqueID = "OK1_FINAN_PAGO_UPDATE";
            oCreationPackage.String = "Actualizar Valor Pago";
            oCreationPackage.Enabled = true;
            oCreationPackage.Position = 24;
            // If the manu already exists this code will fail
            try
            {
                if (!oMenus.Exists(oCreationPackage.UniqueID))
                {
                    oMenus.AddEx(oCreationPackage);
                }

            }
            // Menu already exists
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "Método CrearMenuActualizarValorPago", sapCompany);
            }
        }

