        /// <summary>
        /// Se valida que el Nro de Cuotas ingresado para el Gasto Adicional sea igual o inferior al Nro de cuotas del crédito
        /// </summary>
        /// <param name="oForm">Instancia al Objeto Formulario</param>
        public void ValidarNroCuotasGA(SAPbouiCOM.Form oForm, int iFila)
        {
            SAPbouiCOM.Matrix oMtx = null;
            string strNroCuotasGA, strNroCuotasCr, strVlrGA;
            int iNroCuotasGA = 0;
            int iNroCuotasCr = 0;
            double dbValorGA = 0;
            strNroCuotasCr = ((SAPbouiCOM.EditText)oForm.Items.Item("Ed_NroCuo").Specific).Value.ToString();
            if (!int.TryParse(strNroCuotasCr, out iNroCuotasCr))
            {
                sapApplication.SetStatusBarMessage("Debe indicar el número de cuotas del credito o éste debe ser un valor numérico", BoMessageTime.bmt_Short, true);
            }
            else
            {
                oMtx = (SAPbouiCOM.Matrix)oForm.Items.Item("mtx_1").Specific;
                oMtx.FlushToDataSource();
                strNroCuotasGA = ((SAPbouiCOM.EditText)oMtx.Columns.Item("col_2").Cells.Item(iFila).Specific).Value.ToString();
                iNroCuotasGA = (int)OK1.SBO.Helpers.DoubleFromEditText(strNroCuotasGA);
                if (iNroCuotasGA > iNroCuotasCr)
                {
                    sapApplication.SetStatusBarMessage("El número de cuotas para el Gasto Adicional no puede ser mayor al del Crédito", BoMessageTime.bmt_Short, true);
                    ((SAPbouiCOM.EditText)oMtx.Columns.Item("col_2").Cells.Item(iFila).Specific).Value = strNroCuotasCr;
                }
                else
                {
                    strVlrGA = ((SAPbouiCOM.EditText)oMtx.Columns.Item("col_1").Cells.Item(iFila).Specific).Value.ToString();
                    dbValorGA = OK1.SBO.Helpers.DoubleFromEditText(strVlrGA);
                    double dbValor = dbValorGA / iNroCuotasGA;
                    //oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN2").SetValue("U_VlrCuota", iFila - 1, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, FuncionesGenerales.redondeo(Math.Round(dbValor, 0))));
                    oForm.DataSources.DBDataSources.Item("@OK1_FINAN_CRED_LIN2").SetValue("U_VlrCuota", iFila - 1, OK1.SBO.Helpers.DoubleToDBDataSourceImporte(sapCompany, Math.Round(dbValor, 0)));
                    //((SAPbouiCOM.EditText)oMtx.Columns.Item("col_4").Cells.Item(iFila).Specific).Value = (dbValorGA / iNroCuotasGA).ToString();
                }
                oMtx.LoadFromDataSource();
            }
        }

