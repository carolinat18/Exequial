        /// <summary>
        /// Graba un Credito en la base de datos, mediante GeneralServices
        /// </summary>
        /// <autor>Fredy Ruiz C.</autor>
        /// <fecha>Febrero 2017</fecha>
        public void add(ref double dbVlrCuota)
        {
            #region Variables
            SAPbobsCOM.CompanyService oCmpServ = null;
            SAPbobsCOM.GeneralService oGS = null;
            SAPbobsCOM.GeneralData oGD = null;
            SAPbobsCOM.GeneralDataParams oGDP = null;
            SAPbobsCOM.Recordset oRSet;
            SAPbobsCOM.Recordset oRSet1;
            double dbVlrSegV = 0;
            double dbVlrBaseSV = 0;
            double dbVlrTotCuo = 0;
            double db_VlrAdicional = 0;
            double db_VlrPgAd = 0;
            double db_TIM = 0;
            double db_VlrCuota = 0;
            double db_VlrCapital = 0;
            string stTipCre = string.Empty;
            string str_MesCuota;
            string str_Qry;
            bool bPagoAdicional = false;
            bool bConinuar = true;
            int i_NroCuotas = 0;
            int i_Linea = 0;
            DateTime dt_fecIni = DateTime.Now; ;
            DateTime dt_FechaCuota = DateTime.Now;
            ArrayList PgAdicionales = new ArrayList();
            int iBranch = OK1.SBO.Helpers.ObtenerSucursal(oCmp, oApp);
            int iSerie = -1;
            Consultas oConsultas = new Consultas(oCmp, strPath, strTipoServer);
            #endregion

            try
            {
                FuncionesGenerales oFG = new FuncionesGenerales(oCmp, this.strPath, this.strTipoServer);
                oCmpServ = this.oCmp.GetCompanyService();
                oGS = (SAPbobsCOM.GeneralService)oCmpServ.GetGeneralService("OK1_FINAN_CRED");
                oGD = (SAPbobsCOM.GeneralData)oGS.GetDataInterface(GeneralServiceDataInterfaces.gsGeneralData);
                oGDP = (SAPbobsCOM.GeneralDataParams)oGS.GetDataInterface(GeneralServiceDataInterfaces.gsGeneralDataParams);
                oGD.SetProperty("U_CardCode", this.strCardCode);
                oGD.SetProperty("U_CardName", this.strCardName);
                oGD.SetProperty("U_VlrCred", this.dbVlrCapital);
                oGD.SetProperty("U_CuotaIni", this.dbVlrCuotaInicial);
                oGD.SetProperty("U_VlrBasSV", this.dbVlrBaseSegVida);
                oGD.SetProperty("U_VlrOtrSg", this.dbVlrSeguros);
                oGD.SetProperty("U_TIM", this.dbTIM);
                oGD.SetProperty("U_NroCuot", this.iNroCuotas);
                oGD.SetProperty("U_NoCuotasOr", this.iNroCuotas);
                oGD.SetProperty("U_VlrCaPen", this.dbCapitalPendiente);
                oGD.SetProperty("U_VlrInPen", this.dbInteresPendiente);
                oGD.SetProperty("U_NroCuPen", this.iCuotasPendiente);
                oGD.SetProperty("U_FecDesem", this.dtFechaPago);
                oGD.SetProperty("U_TipAmort", this.strTipoAmortizacion);
                oGD.SetProperty("U_Proyecto", this.stProyecto);
                oGD.SetProperty("U_TipCre", this.stTipCre);
                oGD.SetProperty("U_Estado", this.strEstado);
                oGD.SetProperty("U_NroTabla", this.iTabla);
                oGD.SetProperty("U_IdLetra", "00");
                oGD.SetProperty("U_FecLetra", DateTime.Now);
                oGD.SetProperty("U_IdPagare", "00");
                oGD.SetProperty("U_FecPagar", DateTime.Now);
                oGD.SetProperty("U_NoPrenec", this.iNroPrenecesidad);
                oGD.SetProperty("U_calculado", "Y");
                oGD.SetProperty("U_numcont", this.strNroContrato);

                #region  CAB 03242022  capital + interes 
                //string strcapitalInteres = string.Empty;
                //strcapitalInteres = oFG.DevolverItemEnTabla("@OK1_EXE_PRFIN_HEAD", "U_CapMasInt", "DocEntry", this.iNroPrenecesidad.ToString(), oCmp);
                //double capitalInteres = OK1.SBO.Helpers.DoubleFromDBDataSource(oCmp, strcapitalInteres);

                //if (capitalInteres > 0)
                //    try
                //    {
                //        oGD.SetProperty("U_VlrCapInt", capitalInteres);
                //    }
                //    catch { }
                #endregion

                #region CAB 05042022 PAGOS ADICIONALES PRENECESIDAD
                oRSet1 = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(BoObjectTypes.BoRecordset);
                try
                {
                    oConsultas.EjecutarConsulta(ref oRSet1, oConsultas.Qry_retornarPagoAdicionalPrenecesidad(this.iNroPrenecesidad.ToString()));

                    double pagoAdicional = OK1.SBO.Helpers.DoubleFromDBDataSource(oCmp, oRSet1.Fields.Item(0).Value);

                    if (pagoAdicional > 0)
                        try
                        {
                            oGD.SetProperty("U_VlrPagoAdicional", pagoAdicional);
                        }
                        catch (Exception e)
                        {
                            OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "pagoAdicionalAdd", oCmp);
                        }
                }
                catch (Exception e)
                {
                    OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "pagoAdicionalAdd", oCmp);
                }
                finally { OK1.SBO.Helpers.LiberarCOM(oRSet1); }
                #endregion

                #region CAB 05042022 DESCUENTOS ADICIONALES PRENECESIDAD
                oRSet1 = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(BoObjectTypes.BoRecordset);
                try
                {
                    oConsultas.EjecutarConsulta(ref oRSet1, oConsultas.Qry_retornarDescuentoAdicionalPrenecesidad(this.iNroPrenecesidad.ToString()));

                    double descuentoAdicional = OK1.SBO.Helpers.DoubleFromDBDataSource(oCmp, oRSet1.Fields.Item(0).Value);

                    if (descuentoAdicional > 0)
                        try
                        {
                            oGD.SetProperty("U_VlrDescAdicional", descuentoAdicional);
                        }
                        catch (Exception e)
                        {
                            OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "descuentoAdicionalAd", oCmp);
                        }
                }
                catch (Exception e)
                {
                    OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "descuentoAdicionalAd", oCmp);
                }
                finally { OK1.SBO.Helpers.LiberarCOM(oRSet1); }
                #endregion

                if (strTipoAmortizacion.Equals("2"))
                    dbVlrCuota = ((Math.Round((this.dbVlrCapital)) - this.dbVlrCuotaInicial) * this.dbTIM) / 100;
                else
                {
                    if (this.iNroPrenecesidad == 0)
                    {
                        dbVlrCuota = (Math.Round((this.dbVlrCapital)) - this.dbVlrCuotaInicial) * ((this.dbTIM / 100) * (Math.Pow((1 + (this.dbTIM / 100)), this.iNroCuotas))) / (Math.Pow((1 + (this.dbTIM / 100)), (this.iNroCuotas)) - 1);
                    }
                    else
                    {
                        PagosAdicionalesCuotas oPAC = new PagosAdicionalesCuotas();

                        #region Calculo valor Cuota

                        db_TIM = this.dbTIM / 100;
                        i_NroCuotas = this.iNroCuotas;
                        db_VlrCapital = this.dbVlrCapital - this.dbVlrCuotaInicial;
                        dt_fecIni = this.dtFechaPago;

                        Consultas oConsulta = new Consultas(this.oCmp, this.strPath, this.strTipoServer);
                        str_Qry = oConsulta.QryDatosPagosAdicionesCrePreNec(this.iNroPrenecesidad.ToString());
                        oRSet = (SAPbobsCOM.Recordset)this.oCmp.GetBusinessObject(BoObjectTypes.BoRecordset);

                        try
                        {
                            oConsulta.EjecutarConsulta(ref oRSet, str_Qry);

                            if (oRSet.RecordCount > 0)
                            {
                                PgAdicionales.Clear();

                                while (!oRSet.EoF)
                                {
                                    oPAC.str_CuotaMes = oRSet.Fields.Item("MesCuota").Value.ToString().Trim();
                                    oPAC.db_VlrAdi = OK1.SBO.Helpers.DoubleFromDBDataSource(this.oCmp, oRSet.Fields.Item("ValorAbono").Value);

                                    PgAdicionales.Add(oPAC);
                                    oRSet.MoveNext();
                                }
                            }
                        }
                        catch
                        {
                            bConinuar = false;
                            this.oApp.StatusBar.SetText("Error al consultar pagos adicionales del credito.", SAPbouiCOM.BoMessageTime.bmt_Short, SAPbouiCOM.BoStatusBarMessageType.smt_Error);
                        }
                        finally
                        {
                            OK1.SBO.Helpers.LiberarCOM(oRSet);
                        }

                        for (int i = 0; i < i_NroCuotas; i++)
                        {
                            #region CAB ENERO 2022 OBTENER PAGOS ADICIONALES CAB 22-01-2021

                            i_Linea = i;
                            string str_NroCuota = Convert.ToString(i_Linea + 1);

                            foreach (PagosAdicionalesCuotas item in PgAdicionales)
                            {
                                oPAC = (PagosAdicionalesCuotas)item;

                                if (oPAC.str_CuotaMes.Equals(str_NroCuota))
                                {
                                    db_VlrAdicional = oPAC.db_VlrAdi;
                                    bPagoAdicional = true;
                                    break;
                                }
                            }

                            if (bPagoAdicional)
                            {
                                if (this.dbTIM != 0)
                                {
                                    db_VlrPgAd += db_VlrAdicional / Math.Pow((1 + db_TIM), i_Linea);
                                }
                                else
                                {
                                    db_VlrPgAd += db_VlrAdicional;
                                }
                            }

                            bPagoAdicional = false;
                            #endregion
                        }

                        if (this.dbTIM != 0)
                        {
                            db_VlrCuota = (db_VlrCapital - db_VlrPgAd) / ((1 - Math.Pow((1 + db_TIM), -i_NroCuotas)) / db_TIM);
                        }
                        else
                        {
                            db_VlrCuota = (db_VlrCapital - db_VlrPgAd) / i_NroCuotas;
                        }

                        dbVlrCuota = db_VlrCuota;

                        #endregion
                    }
                }

                dbVlrSegV = ((dbVlrBaseSV * oFG.ObtenerPrcSeguroVida(stTipCre)) / 100);

                dbVlrTotCuo = dbVlrCuota + dbVlrSegV + this.dbVlrSeguros;

                oGD.SetProperty("U_VlrCuota", Math.Round(dbVlrCuota));
                oGD.SetProperty("U_VlrSegV", dbVlrSegV);
                oGD.SetProperty("U_VlrTCuot", Math.Round(dbVlrTotCuo));

                if (iBranch > 0)
                {
                    iSerie = OK1.SBO.Helpers.ObtenerSerieSucursal(iBranch.ToString(), "OK1_FINAN_CRED", oCmp);
                    oGD.SetProperty("Series", iSerie);
                }

                if (bConinuar)
                {
                    oGDP = oGS.Add(oGD);
                }

            }
            catch (Exception e)
            { throw new Exception(e.Message, e.InnerException); }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oCmpServ);
                OK1.SBO.Helpers.LiberarCOM(oGS);
                OK1.SBO.Helpers.LiberarCOM(oGD);
            }
        }

