                {
                    strQuery = oConsulta.QryCuotasPagasTablaAmortiz(oCRED.strDocEntry, (iTabla - 1).ToString(), oCRED.ICuotaInicialTabla);
                    oConsulta.EjecutarConsulta(ref oRs, strQuery);
                    if (oRs.RecordCount > 0)
                    {
                        oRs.MoveFirst();
                        int i = 0;

                        oCRED.LineasAmortizacion = new CreditosFinanciacionLineasAmortizacion[oRs.RecordCount];
                        while (!oRs.EoF)
                        {
