        public static bool CrearAsientoRSUC(SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication, string strPath, string TransID)
        {
            try
            {
                SAPbobsCOM.JournalEntries AsientoRSUCOrigen = (SAPbobsCOM.JournalEntries)sapCompany.GetBusinessObject(BoObjectTypes.oJournalEntries);

                SAPbobsCOM.JournalEntries AsientoRSUCCopia = (SAPbobsCOM.JournalEntries)sapCompany.GetBusinessObject(BoObjectTypes.oJournalEntries);

                if (AsientoRSUCOrigen.GetByKey(int.Parse(TransID)))
                {
                    AsientoRSUCCopia.TransactionCode = AsientoRSUCOrigen.TransactionCode;

                    AsientoRSUCCopia.TaxDate = AsientoRSUCOrigen.TaxDate;

                    AsientoRSUCCopia.DueDate = AsientoRSUCOrigen.DueDate;

                    AsientoRSUCCopia.Reference = AsientoRSUCOrigen.Reference;

                    AsientoRSUCCopia.Reference2 = AsientoRSUCOrigen.Reference2;

                    AsientoRSUCCopia.Reference3 = AsientoRSUCOrigen.Reference3;

                    AsientoRSUCCopia.Memo = AsientoRSUCOrigen.Memo;

                    AsientoRSUCCopia.ProjectCode = AsientoRSUCOrigen.ProjectCode;

                    for (int i = 0; i <= 1; i++)
                    {
                        AsientoRSUCOrigen.Lines.SetCurrentLine(i);

                        AsientoRSUCCopia.Lines.ContraAccount = AsientoRSUCOrigen.Lines.ContraAccount;

                        AsientoRSUCCopia.Lines.ShortName = AsientoRSUCOrigen.Lines.ShortName;

                        AsientoRSUCCopia.Lines.AccountCode = AsientoRSUCOrigen.Lines.AccountCode;

                        AsientoRSUCCopia.Lines.Credit = AsientoRSUCOrigen.Lines.Credit;

                        AsientoRSUCCopia.Lines.Debit = AsientoRSUCOrigen.Lines.Debit;

                        AsientoRSUCCopia.Lines.LineMemo = AsientoRSUCOrigen.Lines.LineMemo;

                        AsientoRSUCCopia.Lines.ProjectCode = AsientoRSUCOrigen.Lines.ProjectCode;

                        AsientoRSUCCopia.Lines.CostingCode = AsientoRSUCOrigen.Lines.CostingCode;

                        AsientoRSUCCopia.Lines.CostingCode2 = AsientoRSUCOrigen.Lines.CostingCode2;

                        AsientoRSUCCopia.Lines.CostingCode3 = AsientoRSUCOrigen.Lines.CostingCode3;

                        AsientoRSUCCopia.Lines.CostingCode4 = AsientoRSUCOrigen.Lines.CostingCode4;

                        AsientoRSUCCopia.Lines.UserFields.Fields.Item("U_InfoCo01").Value = AsientoRSUCOrigen.Lines.UserFields.Fields.Item("U_InfoCo01").Value;

                        AsientoRSUCCopia.Lines.Reference1 = AsientoRSUCOrigen.Lines.Reference1;

                        AsientoRSUCCopia.Lines.Reference2 = AsientoRSUCOrigen.Lines.Reference2;

                        AsientoRSUCCopia.Lines.BPLID = AsientoRSUCOrigen.Lines.BPLID;

                        AsientoRSUCCopia.Lines.Add();
                    }

                    int iError = AsientoRSUCCopia.Add();

                    if (iError == 0)
                    {
                        return true;
                    }
                    else
                    {

                        string strErrorAS = sapCompany.GetLastErrorDescription();

                        return false;
                    }
                }
                else
                {
                    return false;
                }

            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInFinanciacion", "CrearAsientoRSUC", sapCompany);
                return false;
            }
            finally
            {
                GC.Collect();
            }

        }

