                    query = query + "       CASE WHEN T1.\"U_ItemCode\" = (SELECT \"ItemCode\" FROM OITM WHERE \"validFor\" = 'N' AND \"ItemCode\" = T1.\"U_ItemCode\")  THEN '' ELSE T1.\"U_ItemCode\" END AS \"U_ItemCode\", " + "\n";
                    query = query + "     " + "\n";
                    query = query + "       CASE WHEN T1.\"U_ItemCode\" = (SELECT \"ItemCode\" FROM OITM WHERE \"validFor\" = 'N' AND \"ItemCode\" = T1.\"U_ItemCode\")  THEN '' ELSE T1.\"U_ItemName\" END AS \"U_ItemName\", " + "\n";
