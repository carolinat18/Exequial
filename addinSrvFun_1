        private bool Revisar_Codigos_Transaccion()
        {
            bool blReturn = false;
            SAPbobsCOM.Recordset oRecTrnsCode = null;
            string query = "";
            try
            {
                oRecTrnsCode = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                query = OK1.Generic.Helpers.configParteConsulta(this.StrPath + @"AddInQueries\Queries.xml", "RevisarCodigosTransaccion", "/TQueries/Queries/Query");
                oRecTrnsCode.DoQuery(query);
                if (oRecTrnsCode.RecordCount > 0)
                {
                    StringBuilder strTransacciones = new StringBuilder();
                    strTransacciones.AppendLine("Debe crear los siguientes codigos de transacciones en el registro de diario para que la funcionalidad de Addin Exequial funcione correctamente:");
                    while (!oRecTrnsCode.EoF)
                    {
                        strTransacciones.AppendLine("Código: " + oRecTrnsCode.Fields.Item(0).Value.ToString() + ". Descripción: " + oRecTrnsCode.Fields.Item(1).Value.ToString());
                        oRecTrnsCode.MoveNext();
                    }
                    sapApplication.MessageBox(strTransacciones.ToString(), 1, "Aceptar", "", "");
                }
                else
                    blReturn = true;
            }
            catch (Exception e)
            {
                this.sapApplication.MessageBox("Error revisando los códigos de transacción. Exequial.", 1, "OK", "", "");
                Console.WriteLine(e.Message);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(oRecTrnsCode);
            }
            return blReturn;
        }

        /// <summary>
        /// Inserta registros en tablas de usuarios
        /// </summary>
        /// <param name="tabla"></param>
        /// <param name="strPath"></param>
        /// <param name="sapCompany"></param>
        /// <returns></returns>
        private bool Insertar_Tabla_Usuario(string tabla, string strPath, SAPbobsCOM.Company sapCompany)
        {

            bool exito = false;
            SAPbobsCOM.UserTable uTB = null;
            SAPbobsCOM.Recordset oRec = null;


            try
            {
                string strQuery = OK1.Generic.HelpersXML.configParteConsulta(strPath + @"AddInQueries\Tablas.xml", tabla, "/TQueries/Queries/Query");
                oRec = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                oRec.DoQuery(strQuery);


                while (!oRec.EoF)
                {
                    uTB = sapCompany.UserTables.Item(tabla);
                    uTB.Code = oRec.Fields.Item("Code").Value.ToString();
                    uTB.Name = oRec.Fields.Item("Name").Value.ToString();
                    uTB.UserFields.Fields.Item("U_act").Value = "Y";
                    uTB.Add();
                    oRec.MoveNext();
                }



            }
            catch
            {
                exito = true;

            }
            finally
            {

                OK1.SBO.Helpers.LiberarCOM(oRec);
                OK1.SBO.Helpers.LiberarCOM(uTB);
            }

            return exito;
        }
        /// <summary>
        /// Verifica si existen valores en una tabla.
        /// </summary>
        /// <param name="TableName"></param>
        /// <param name="sapCompany"></param>
        /// <param name="sapApplication"></param>
        /// <returns></returns>
        private bool ExistenRegistros(string TableName, SAPbobsCOM.Company sapCompany, SAPbouiCOM.Application sapApplication)
        {
            bool existe = false;
            SAPbobsCOM.Recordset ors = null;
            try
            {
                string query = "SELECT * FROM \"" + TableName + "\"";
                ors = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                ors.DoQuery(query);
                if (ors.RecordCount > 0)
                {
                    existe = true;
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "SerFun", "EXC0001", sapCompany, sapApplication);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(ors);
            }
            return existe;
        }
