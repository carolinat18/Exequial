        private bool cargarValidacionReflection(SAPbouiCOM.Form oForm, out object variable)
        {
            //validaciones por reflection
            Assembly oAssembly;
            Type oType;
            bool resultado = false;
            object variable1 = null;
            variable = null;

            try
            {
                oAssembly = Assembly.LoadFrom(this.StrPath + @"dll\ValidacionSrvFun.dll");
                oType = oAssembly.GetType("ValidacionSrvFun.Validacion");

                InterfaceSrvFun.IValidacionSrvFun oVal = (InterfaceSrvFun.IValidacionSrvFun)Activator.CreateInstance(oType);
                oVal.Application = sapApplication;
                oVal.Company = sapCompany;
                resultado = oVal.validarCreacionSolicitud(oForm, out variable1);
