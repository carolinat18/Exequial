                            oRS.DoQuery("SELECT CAST(\"U_fecIn\" AS varchar) AS \"FECHA\" FROM \"@OK1_EXE_PRENE_HEAD\" WHERE \"DocEntry\" = '" + idContrato + "'");
                    }
                    else
                        oRS.DoQuery("SELECT CAST(\"U_fecIn\" AS varchar) AS \"FECHA\" FROM \"@OK1_EXE_CONTR_HEAD\" WHERE \"DocEntry\" = '" + idContrato + "'");
                    if (oRS.RecordCount > 0)
                    {
                        fecha = OK1.SBO.Helpers.FechaFormateadaAsDateTime(oRS.Fields.Item(0).Value.ToString(), SBOApplication);
                    }
                }
            }
            catch { }
            finally
            {
                if (oRS != null)
                    System.Runtime.InteropServices.Marshal.ReleaseComObject(oRS);
            }
            return fecha;

        }
