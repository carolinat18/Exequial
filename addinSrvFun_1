        /// <summary>
        /// Retorna el query de la tabla de log indicada para el UDO correspondiente
        /// </summary>
        /// <param name="tablaLogUDO">Nombre de la tabla de log del UDO</param>
        /// <param name="docEntry">DocEntry del documento a consultar</param>
        /// <param name="instancia">Número de instancia a consultar</param>
        /// <param name="tablaLineas">Indica si la tabla que se envia como parámetro es de líneas del UDO</param>
        /// <returns>String del query para ser ejecutado</returns>
        private string consultarLogModificacionesUDO(string tablaLogUDO, int docEntry, int instancia, bool tablaLineas)
        {
            SAPbobsCOM.Recordset oRSCampos = null;
            string select = "", strQuery = "";
            int i = 0;

            try
            {
                oRSCampos = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(BoObjectTypes.BoRecordset);
                oRSCampos.DoQuery("SELECT 'U_' || \"AliasID\" AS \"AliasID\", \"Descr\" FROM CUFD WHERE \"TableID\" = '@" + tablaLogUDO + "' WHERE \"TableID\" ='@" + tablaLogUDO + "'");
                if (oRSCampos.RecordCount > 0)
                {
                    //armar select
                    if (tablaLineas)
                    { select += "\"DocEntry\", \"LineId\" AS \"Linea\", \"LogInst\" AS \"Instancia\", "; }
                    else
                    { select += "\"DocEntry\", \"LogInst\" AS \"Instancia\", "; }
                    while (!oRSCampos.EoF)
                    {
                        //variable i se usa para poner la coma que separe los campos
                        if (i == 0)
                        {
                            select += "\"" + oRSCampos.Fields.Item("AliasID").Value.ToString() + "\"" + " AS '" + oRSCampos.Fields.Item("Descr").Value.ToString() + "'";
                        }
                        else
                        {
                            select += ", " + "\"" + oRSCampos.Fields.Item("AliasID").Value.ToString() + "\"" + " AS '" + oRSCampos.Fields.Item("Descr").Value.ToString() + "'";
                        }
                        i++;
                        oRSCampos.MoveNext();
                    }
                    strQuery = "SELECT " + select + " FROM \"@" + tablaLogUDO + "\" WHERE \"DocEntry\" = " + docEntry + " AND \"LogInst\" >= " + instancia;
                }
            }
            catch (Exception e)
            {
                sapApplication.StatusBar.SetText(e.Message, BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
                OK1.SBO.Helpers.reportar_error(e, "addInSrvFun", "consultarLogModificacionesUDO", sapCompany);
            }
            finally
            {
                if (oRSCampos != null)
                { System.Runtime.InteropServices.Marshal.ReleaseComObject(oRSCampos); }
            }
            return strQuery;
        }
