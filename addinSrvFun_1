        private bool Revisar_Usuarios()
        {
            bool blReturn = true;
            SAPbobsCOM.Recordset oRecTrnsCode = null;
            string query = "";
            SAPbobsCOM.Users oUser = null;


            try
            {
                oRecTrnsCode = (SAPbobsCOM.Recordset)sapCompany.GetBusinessObject(SAPbobsCOM.BoObjectTypes.BoRecordset);
                query = OK1.Generic.Helpers.configParteConsulta(this.StrPath + @"AddInQueries\Queries.xml", "RevisarUsuarios", "/TQueries/Queries/Query");
                oRecTrnsCode.DoQuery(query);
                if (oRecTrnsCode.RecordCount > 0)
                {
                    while (!oRecTrnsCode.EoF)
                    {
                        oUser = (SAPbobsCOM.Users)sapCompany.GetBusinessObject(BoObjectTypes.oUsers);
                        oUser.UserCode = oRecTrnsCode.Fields.Item(0).Value.ToString();
                        oUser.UserName = oRecTrnsCode.Fields.Item(1).Value.ToString();
