        private void Borrar_Multiples_lineas(SAPbouiCOM.Form oForm, string matriz, string tabla)
        {
            if (oForm.Mode != BoFormMode.fm_FIND_MODE)
            {
                Item oItem = oForm.Items.Item("mtx_" + matriz);
                SAPbouiCOM.Matrix oMatrix = (SAPbouiCOM.Matrix)oItem.Specific;
                SAPbouiCOM.DBDataSource oDBS = (SAPbouiCOM.DBDataSource)oForm.DataSources.DBDataSources.Item(tabla);
                List<int> lista = new List<int>();
                try
                {
                    oForm.Freeze(true);
                    oMatrix.FlushToDataSource();
                    for (int i = 1; i <= oMatrix.RowCount; i++)
                    {
                        //agrega a la lista las lineas seleccioandas
                        if (oMatrix.IsRowSelected(i))
                        {
                            lista.Add(i - 1);
                        }
                    }
                    //remueve las lineas que esten en la lista, restandole las lineas ya borradas, ya que el data source se renumera
                    for (int i = 0; i < lista.Count; i++)
                    {
                        int l = lista[i] - i;
                        oDBS.RemoveRecord(l);

                    }
                    oMatrix.LoadFromDataSource();
                    oForm.Freeze(false);
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                    throw;
                }
            }
        }


    }
