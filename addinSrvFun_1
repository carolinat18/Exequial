        //Valida UNA celda de la matriz con las demas celdas (luisa)
        public bool validarCeldaRepetida(SAPbouiCOM.Form oForm, SAPbouiCOM.Matrix oMatrix, string col, int row, string tipo)
        {
            XmlDocument xmlDoc = new XmlDocument();
            XmlNodeList xmlFilas;
            XmlNodeList xmlFilas1;
            XmlNodeList xmlFilas2;
            XmlNodeList xmlCeldas;
            XmlNodeList xmlCeldas2;
            XmlNode xmlNodo = null;
            XmlNodeList xmlContCelda;
            XmlNodeList xmlContCelda2;
            string strSeleccionado = string.Empty;
            string strSeleccionado2 = string.Empty;
            string strDTXML = string.Empty;
            int repetido = 0;
            string dato = "";

            if (tipo == "Select")
            {
                ComboBox combo = (SAPbouiCOM.ComboBox)oMatrix.Columns.Item(col).Cells.Item(row).Specific;
                if (combo.Value != "")
                {
                    dato = combo.Selected.Value;
                }
            }
            else
            {
                EditText oEdit = (SAPbouiCOM.EditText)oMatrix.Columns.Item(col).Cells.Item(row).Specific;
                dato = oEdit.Value;
            }

            strDTXML = oMatrix.SerializeAsXML(BoMatrixXmlSelect.mxs_All);
            xmlDoc.LoadXml(strDTXML);

            xmlFilas = xmlDoc.GetElementsByTagName("Rows");

            xmlFilas1 = ((XmlElement)xmlFilas[0]).GetElementsByTagName("Row");

            foreach (XmlElement item in xmlFilas1)
            {
                xmlCeldas = ((XmlElement)item).GetElementsByTagName("Columns");
                xmlCeldas2 = ((XmlElement)xmlCeldas[0]).GetElementsByTagName("Column");

                for (int i = 0; i < xmlCeldas2.Count; i++)
                {
                    xmlContCelda = ((XmlElement)xmlCeldas2[i]).GetElementsByTagName("ID"); // Seleccionar
                    strSeleccionado = xmlContCelda[0].InnerText.Trim();
                    if (strSeleccionado.Equals(col))
                    {
                        xmlContCelda2 = ((XmlElement)xmlCeldas2[i]).GetElementsByTagName("Value"); // Seleccionar
                        strSeleccionado2 = xmlContCelda2[0].InnerText.Trim();
                        if (strSeleccionado2 == dato)
                        {
                            repetido++;
                            if (repetido > 1)
                                return false;
                        }

                    }

                }

            }

            return true;

        }
