            //string consulta = "select t1.u_numdoc, t1.u_nombre, t1.u_fecnaci, t1.u_parent, t1.u_edad from [@ok1_exe_cont_benefi] t1 where t1.docentry = (select docentry from [@ok1_exe_contr_head] where u_numcont = '" + idContrato + "')";
