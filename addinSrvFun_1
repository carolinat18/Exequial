                //Salidas de inventario
                case "60":
                    oBLO = BoLinkedObject.lf_GoodsIssue;
                    break;

                ////Depósitos
                //case "606":
                //    table = "ODPS";
                //    break;

                //Transferencias de inventario
                case "67":
                    oBLO = BoLinkedObject.lf_StockTransfers;
                    break;

                //Revalorización de inventario
                case "162":
