                {
                    //query = "SELECT T0.\"Code\", T0.\"Name\",T1.\"U_ItemCode\",T1.\"U_ItemName\",T1.\"U_Cant\",T1.\"U_Valor\",T1.\"U_tipLinea\",CASE WHEN T0.\"U_TipoOrden\" = 'OS' THEN 'Orden de Servicio' WHEN T0.\"U_TipoOrden\" = 'OC' THEN 'Orden de Compra' END AS \"Tipo Orden\" FROM \"@OK1_EXE_ELEPROTECC\" T0 INNER JOIN \"@OK1_EXE_PRFIN_ELEM\" T1 ON T0.\"Code\" = T1.\"U_Codigo\" WHERE T1.\"DocEntry\" = " + idContrato + " AND T1.\"U_Cant\" > 0  ORDER BY T1.\"LineId\"";
                    //query = "SELECT T0.\"Code\", T0.\"Name\",T1.\"U_ItemCode\",T1.\"U_ItemName\",T1.\"U_Cant\",T1.\"U_Valor\",T1.\"U_tipLinea\",\"U_TipoOrden\" AS \"Tipo Orden\",T1.\"U_IdLinea\", T1.\"U_Linea\",T1.\"U_LineaName\"         FROM \"@OK1_EXE_ELEPROTECC\" T0 INNER JOIN \"@OK1_EXE_PRFIN_ELEM\" T1 ON T0.\"Code\" = T1.\"U_Codigo\" WHERE T1.\"DocEntry\" = " + idContrato + " AND T1.\"U_Cant\" > 0   AND T1.\"" + campo + "\" = 'Y' ORDER BY T1.\"LineId\"";
                    query = "";
