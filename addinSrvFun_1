                if (!convPart)
                    nivelServicio = "N/A";

                strQuery = OK1.Generic.HelpersXML.configParteConsulta(strPath + @"AddInQueries\Queries.xml", "GetElementosConvenioCambioPlan", "/TQueries/Queries/Query");
