                    query = query + "       T1.\"U_Cant\" AS \"U_Cant\", " + "\n";
                    query = query + "    " + "\n";
                    query = query + "       T1.\"U_Valor\" AS \"U_Valor\", " + "\n";
                    query = query + "      " + "\n";
                    query = query + "       T1.\"U_tipLinea\", " + "\n";
                    query = query + "        " + "\n";
                    query = query + "       \"U_TipoOrden\" AS \"Tipo Orden\", " + "\n";
                    query = query + "        " + "\n";
                    query = query + "       T1.\"U_IdLinea\", " + "\n";
                    query = query + "        " + "\n";

                    query = query + "       T1.\"U_Linea\", " + "\n";
                    query = query + "        " + "\n";

                    query = query + "       T1.\"U_LineaName\" " + "\n";
                    query = query + "        " + "\n";

                    query = query + "       FROM   \"@OK1_EXE_ELEPROTECC\" T0 " + "\n";
                    query = query + "       INNER JOIN \"@OK1_EXE_PRFIN_ELEM\" T1 " + "\n";
                    query = query + "               ON T0.\"Code\" = T1.\"U_Codigo\" " + "\n";
                    query = query + "WHERE  T1.\"DocEntry\" = " + idContrato + " " + "\n";
                    query = query + "       AND T1.\"U_Cant\" > 0 " + "\n";
                    query = query + "       AND T1.\"" + campo + "\" = 'Y' " + "\n";
                    query = query + "        " + "\n";
                    query = query + "       AND  T1.\"U_ItemCode\" IN " + "\n";
                    query = query + "       ( " + "\n";
                    query = query + "         SELECT " + "\n";
                    query = query + "         T4.\"U_ItemCode\" " + "\n";
                    query = query + "         FROM   \"@OK1_EXE_PRFIN_HEAD\" T3 " + "\n";
                    query = query + "         INNER JOIN \"@OK1_EXE_PRFIN_ELEM\" T4 " + "\n";
                    query = query + "               ON T3.\"DocEntry\" = T4.\"DocEntry\" " + "\n";
                    query = query + "         WHERE  T3.\"DocEntry\" = " + idContrato + " " + "\n";
                    query = query + "        AND T4.\"U_CantDispo\" > " + "\n";
                    query = query + "        ( " + "\n";
                    query = query + "         SELECT Count(T1. \"U_ItemCode\") " + "\n";
                    query = query + "         FROM   \"@OK1_SF_LLAMADA_HEAD\" T0 " + "\n";
                    query = query + "         INNER JOIN \"@OK1_SF_ELEM_LIN\" T1 " + "\n";
                    query = query + "         ON T0.\"DocEntry\" = T1.\"DocEntry\" " + "\n";
                    query = query + "         WHERE  T0.\"Canceled\" = 'N' " + "\n";
                    //query = query + "         AND T0.\"U_Estado\" = '1' " + "\n";
                    query = query + "         AND (T0.\"U_Estado\" <> '8' OR T0.\"U_Estado\" <> '3') " + "\n";
                    query = query + "         AND T1. \"U_ItemCode\" = T4.\"U_ItemCode\" " + "\n";
                    query = query + "         AND T1.\"U_NoContr_Prenec\" = '" + idContrato + "' " + "\n";
                    query = query + "         AND ( IFNULL(T1.\"U_Uso\", 'N') = 'N' OR IFNULL(T1.\"U_Uso\", '') = '' ) " + "\n";
                    query = query + "         ) " + "\n";
                    query = query + "        ) " + "\n";
                    query = query + "ORDER  BY T1.\"LineId\"";


                    oRS.DoQuery(query);
                }
            }
            catch { }
            finally
            {
            }
        }

