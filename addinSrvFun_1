        private void selectLinkedObject(ref BoLinkedObject oBLO, string LinkedObjectType)
        {
            switch (LinkedObjectType)
            {
                //Factura
                case "13":
                    oBLO = BoLinkedObject.lf_Invoice;
                    break;

                //Nota crédito Ventas
                case "14":
                    oBLO = BoLinkedObject.lf_InvoiceCreditMemo;
                    break;

                //Entrega
                case "15":
                    oBLO = BoLinkedObject.lf_DeliveryNotes;
                    break;

                //Devolución
                case "16":
                    oBLO = BoLinkedObject.lf_DeliveryNotesReturns;
                    break;

                //Cotización Ventas
                case "23":
                    oBLO = BoLinkedObject.lf_Quotation;
                    break;

                //Orden de venta
                case "17":
                    oBLO = BoLinkedObject.lf_Order;
                    break;

                //Factura de anticipos
                case "203":
                    oBLO = BoLinkedObject.lf_Invoice;
                    break;

                //Factura compras
                case "18":
                    oBLO = BoLinkedObject.lf_PurchaseInvoice;
                    break;

                //Nota crédito compras
                case "19":
                    oBLO = BoLinkedObject.lf_PurchaseInvoiceCreditMemo;
                    break;

                //Entradas compras
                case "20":
                    oBLO = BoLinkedObject.lf_GoodsReceipt;
                    break;

                //Devoluciones compras
                case "21":
                    oBLO = BoLinkedObject.lf_GoodsReturns;
                    break;

                //Ordenes de compras
                case "22":
                    oBLO = BoLinkedObject.lf_PurchaseOrder;
                    break;

                //Factura de anticipos
                case "204":
                    oBLO = BoLinkedObject.lf_PurchaseInvoice;
                    break;

                //Pagos recibidos
                case "24":
                    oBLO = BoLinkedObject.lf_PaymentBlock;
                    break;

                //Pagos efectuados
                case "46":
                    oBLO = BoLinkedObject.lf_PaymentBlock;
                    break;
                //Entradas inventario
                case "59":
                    oBLO = BoLinkedObject.lf_GoodsIssue;
