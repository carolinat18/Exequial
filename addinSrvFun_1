        /// <summary>
        /// Obtiene los contratos activos para un contratante, útil para llenar el Combobox de contratos en la solicitud
        /// </summary>
        /// <param name="idContratante"></param>
        /// <returns></returns>
        public string getQueryContratosActivos(string idContratante, bool prenecesidad, string prenecFinanc)
        {
            string query = "";

            if (prenecesidad)
                if (prenecFinanc.Equals("Y"))
                    query = "SELECT \"DocEntry\", IFNULL(\"U_numcont\",'SIN REFERENCIA') FROM \"@OK1_EXE_PRFIN_HEAD\" WHERE \"U_contrant\" = '" + idContratante + "' AND \"U_estado\" IN (SELECT \"U_EstadoCo\" FROM \"@OK1_SF_MAPEOEST\"  ORDER BY \"DocEntry\" )";
                else
                    query = "SELECT \"DocEntry\", IFNULL(\"U_numcont\",'SIN REFERENCIA') FROM \"@OK1_EXE_PRENE_HEAD\" WHERE \"U_contrant\" = '" + idContratante + "' AND \"U_estado\" IN (SELECT \"U_EstadoCo\" FROM \"@OK1_SF_MAPEOEST\"  ORDER BY \"DocEntry\" )";
            else
                query = "SELECT \"DocEntry\", IFNULL(\"U_numcont\",'SIN REFERENCIA') FROM \"@OK1_EXE_CONTR_HEAD\" WHERE \"U_contrant\" = '" + idContratante + "' AND \"U_estado\" IN (SELECT \"U_EstadoCo\" FROM \"@OK1_SF_MAPEOEST\"  ORDER BY \"DocEntry\" ) AND (\"U_fecIn\" <= CURRENT_DATE OR \"U_estado\" IN ('RENVDO', 'ACT'))";

            return query;
        }
