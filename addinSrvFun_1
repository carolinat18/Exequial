                string tabla = "OK1_SF_LLAMADA_HEAD";
                docEntrySolicitudServicio = SolicitudServicio;
                existeSolicitudServicio = ExisteSolicitudServicio(docEntrySolicitudServicio, tabla);
                if (!existeSolicitudServicio)
                {
                    CampoVacio = " Solicitud Servicio. No existe el campo ";
                    existencamposvacios = true;
                    error = 7;
                }
            }
            return existencamposvacios;
        }
        /// <summary>
        /// Existe solicitud de servicio.
        /// </summary>
        /// <param name="docEntrySolicitudServicio"></param>
        /// <param name="tabla"></param>
        /// <returns>Existedocumento</returns>
        private bool ExisteSolicitudServicio(string docEntrySolicitudServicio, string tabla)
        {
            bool Existedocumento = false;
            SAPbobsCOM.Recordset orset = null;
            string query = "";
            try
            {
                orset = (SAPbobsCOM.Recordset)this.sapCompany.GetBusinessObject(BoObjectTypes.BoRecordset);
                query = "SELECT * FROM \"@" + tabla + "\" WHERE \"DocEntry\" = '" + docEntrySolicitudServicio + "'";
                orset.DoQuery(query);
                if (orset.RecordCount > 0)
                {
                    Existedocumento = true;
                }
            }
            catch (Exception e)
            {
                OK1.SBO.Helpers.reportar_error(e, "addInSrvFun", "ExisteSolicitudServicio", this.sapCompany);
                this.sapApplication.StatusBar.SetText("Ocurrió una excepción en On ExisteSolicitudServicio. " + e.Message, BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
            }
            finally
            {
                OK1.SBO.Helpers.LiberarCOM(orset);
            }
            return Existedocumento;
        }
        private void Borrar_linea(SAPbouiCOM.Form oForm, string matriz)
        {
            if (oForm.Mode != BoFormMode.fm_FIND_MODE)
            {
                oForm.Freeze(true);

                Item oItem = oForm.Items.Item("mtx_" + matriz);
                SAPbouiCOM.Matrix oMtx = (SAPbouiCOM.Matrix)oItem.Specific;

                //Obtiene el número de la fila seleccionada
                int selRow = oMtx.GetNextSelectedRow(0, BoOrderType.ot_SelectionOrder);
                if (selRow == -1)
                {
                    oForm.Freeze(false);
                    return;
                }

                //Borra la fila seleccionada
                oMtx.DeleteRow(selRow);
                oMtx.FlushToDataSource();
                oForm.Freeze(false);
            }
        }


