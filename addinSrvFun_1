                {
                    consulta.Append("SELECT 'BENEF PLAN EXEQUIAL: ' AS \"No. Doc\", '' AS \"Beneficiario\", NULL AS \"Fecha Nacimiento\", '' AS \"Parentesco\", NULL AS \"Edad\", '' AS \"Tipo\", '' AS \"TipoDoc\", '' AS \"TipoBenef\" FROM DUMMY  UNION ALL ");
                    consulta.Append("SELECT \"U_numdoc\" AS \"No. Doc\", REPLACE(IFNULL(\"U_nombre\", '') || ' ' || IFNULL(\"U_snombre\", '') || ' ' || IFNULL(\"U_pape\", '') || ' ' || IFNULL(\"U_sape\", ''), '  ', ' ') AS \"Beneficiario\", \"U_fecnaci\" AS \"Fecha Nacimiento\", T1.\"Name\" AS \"Parentesco\",YEARS_BETWEEN(\"U_fecnaci\", CURRENT_DATE)  AS \"Edad\",  CASE WHEN \"U_tdbenef\" = 'B' THEN 'Beneficiario' WHEN \"U_tdbenef\" = 'A' THEN 'Adicional Mayor' WHEN \"U_tdbenef\" = 'M' THEN 'Adicional Menor' END AS \"Tipo\", T0.\"Name\" AS \"TipoDoc\",  \"U_tdbenef\" AS \"TipoBenef\"  FROM \"@OK1_EXE_PRENE_BENEF\" TB INNER JOIN \"@BPCO_TD\" AS T0 ON T0.\"Code\" = \"U_tdd\"   INNER JOIN \"@OK1_EXE_PARENTESCOS\" T1 ON T1.\"Code\" = \"U_parent\" WHERE TB.\"DocEntry\" = (SELECT \"DocEntry\" FROM \"@OK1_EXE_PRENE_HEAD\" WHERE \"DocEntry\" = '" + idContrato + "') AND \"U_numdoc\" IS NOT NULL AND IFNULL(\"U_fecSin\", '') = '' AND (IFNULL(\"U_fecRet\", '') = '' OR \"U_fecRet\" > NOW()) ");
                }
            }
            else
            {
                consulta.Append("SELECT 'BENEF PLAN EXEQUIAL: ' AS \"No. Doc\", '' AS \"Beneficiario\", NULL AS \"Fecha Nacimiento\", '' AS \"Parentesco\", NULL AS \"Edad\", '' AS \"Tipo\", '' AS \"TipoDoc\", '' AS \"TipoBenef\" FROM DUMMY  UNION ALL ");
                consulta.Append("SELECT \"U_numdoc\" AS \"No. Doc\", REPLACE(IFNULL(\"U_nombre\", '') || ' ' || IFNULL(\"U_snombre\", '') || ' ' || IFNULL(\"U_pape\", '') || ' ' || IFNULL(\"U_sape\", ''), '  ', ' ') AS \"Beneficiario\", \"U_fecnaci\" AS \"Fecha Nacimiento\", T1.\"Name\" AS \"Parentesco\", YEARS_BETWEEN(\"U_fecnaci\", CURRENT_DATE) AS \"Edad\",  CASE WHEN \"U_tdbenef\" = 'B' THEN 'Beneficiario' WHEN \"U_tdbenef\" = 'A' THEN 'Adicional Mayor' WHEN \"U_tdbenef\" = 'M' THEN 'Adicional Menor' END AS \"Tipo\", T0.\"Name\" AS \"TipoDoc\",  \"U_tdbenef\" AS \"TipoBenef\"  FROM \"@OK1_EXE_CONT_BENEFI\" TB INNER JOIN \"@BPCO_TD\" AS T0 ON T0.\"Code\" = \"U_tdd\"   INNER JOIN \"@OK1_EXE_PARENTESCOS\" T1 ON T1.\"Code\" = \"U_parent\" WHERE TB.\"DocEntry\" = (SELECT \"DocEntry\" FROM \"@OK1_EXE_CONTR_HEAD\" WHERE \"DocEntry\" = '" + idContrato + "') AND \"U_numdoc\" IS NOT NULL AND IFNULL(\"U_fecSin\", '') = '' AND (IFNULL(\"U_fecRet\", '') = '' OR \"U_fecRet\" > NOW())  UNION ALL ");
                consulta.Append("SELECT 'BENEF REPATRIACION: ' AS \"No. Doc\", '' AS \"Beneficiario\", NULL AS \"Fecha Nacimiento\", '' AS \"Parentesco\", NULL AS \"Edad\", '' AS \"Tipo\", '' AS \"TipoDoc\", '' AS \"TipoBenef\" FROM DUMMY  UNION ALL ");
