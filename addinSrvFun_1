        public bool evtRightClickHandler(ref SAPbouiCOM.ContextMenuInfo eventInfo, out bool BubbleEvent)
        {
            BubbleEvent = true;
            SAPbouiCOM.Form sysForm = (SAPbouiCOM.Form)sapApplication.Forms.Item(eventInfo.FormUID);
            ServicioFunerario serfun = new ServicioFunerario(sapCompany, sapApplication);
            string docnum = "";


            try
            {
                RightClickMenu(eventInfo.BeforeAction, eventInfo.Row, eventInfo.ItemUID, sapApplication.Forms.ActiveForm.TypeEx);
                iRow = eventInfo.Row;

                switch (sysForm.TypeEx)
                {
                    case "OK1_SF_LLAMADA2":
                        switch (eventInfo.ItemUID)
                        {
                            case "mtx_2":
                                switch (eventInfo.ColUID)
                                {
                                    case "col_2":
                                        if (eventInfo.BeforeAction)
                                        {
                                            SAPbouiCOM.Matrix oMatrix = (SAPbouiCOM.Matrix)sysForm.Items.Item("mtx_2").Specific;
                                            string mensaje = string.Empty;
                                            bool existen_DocumentosCreadosOSLineasBasicos = false;
                                            string tipoLinea = sysForm.DataSources.DBDataSources.Item("@OK1_SF_ELEM_LIN").GetValue("U_tipLinea", eventInfo.Row - 1).Trim();
                                            string itemCode = sysForm.DataSources.DBDataSources.Item("@OK1_SF_ELEM_LIN").GetValue("U_ItemCode", eventInfo.Row - 1).Trim();
                                            if (tipoLinea.Equals("B") || tipoLinea.Equals("P"))
                                                existen_DocumentosCreadosOSLineasBasicos = serfun.existen_DocumentosCreadosOSLineasBasicos(sysForm, sapCompany, ref mensaje, eventInfo.Row, ref itemCode);

                                            if (existen_DocumentosCreadosOSLineasBasicos)
                                            {
                                                sapApplication.StatusBar.SetText("No es posible realizar modificaciones en esta línea. Existe un documento creado en el artículo   " + mensaje + "", BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Warning);
                                                oMatrix.Columns.Item("C_RotCof").Cells.Item(eventInfo.Row).Click();
                                            }
                                        }
                                        break;
                                    case "col_6":
                                        if (eventInfo.BeforeAction)
                                        {
                                            docnum = sysForm.DataSources.DBDataSources.Item("@OK1_SF_ELEM_LIN").GetValue("U_Documento", eventInfo.Row - 1);

                                            if (docnum != "")
                                            {
                                                sapApplication.Menus.Item("771").Enabled = false;
                                                sapApplication.Menus.Item("773").Enabled = false;

                                            }
                                            else
                                            {
                                                sapApplication.Menus.Item("771").Enabled = true;
                                                sapApplication.Menus.Item("773").Enabled = true;
                                            }
                                        }
                                        break;

                                }
                                break;
                        }
                        break;
                }

            }

            catch (Exception e)
            {
                this.sapApplication.StatusBar.SetText("Error: " + e.Message, BoMessageTime.bmt_Short, BoStatusBarMessageType.smt_Error);
            }

            return BubbleEvent;
        }
